<Project>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <InvariantGlobalization>false</InvariantGlobalization>
    <RootNamespace>$(MSBuildProjectName)</RootNamespace>
  </PropertyGroup>

  <!--
    Money and volumetric values end up on signed commercial documents, so a
    silent narrowing or a lost await is a correctness bug, not a style issue.
    CS4014 = unawaited task. CS8602/8618 = nullability.
  -->
  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <WarningsAsErrors>$(WarningsAsErrors);CS4014;CS8602;CS8618</WarningsAsErrors>
  </PropertyGroup>

</Project>
