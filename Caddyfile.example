# Caddyfile.example — Configuration snippet for your external Caddy reverse proxy
# Replace `dms.yourdomain.com` with your actual domain or localhost/port.
# Update the `root` path to point to your built `frontend/dist` directory.

dms.yourdomain.com {
	# Path to the built frontend production bundle (run `bun run build` in ./frontend)
	root * /srv/PGN-dms-simando/frontend/dist
	encode gzip zstd

	# Proxy backend API, Scalar documentation, and OpenAPI schemas to .NET Web API
	handle /api/* {
		reverse_proxy 127.0.0.1:5000
	}

	handle /scalar/* {
		reverse_proxy 127.0.0.1:5000
	}

	handle /openapi/* {
		reverse_proxy 127.0.0.1:5000
	}

	# SPA routing fallback: serve existing static files or fallback to index.html
	handle {
		try_files {path} /index.html
		file_server
	}

	# Security headers
	header {
		X-Frame-Options "SAMEORIGIN"
		X-Content-Type-Options "nosniff"
		X-XSS-Protection "1; mode=block"
		Referrer-Policy "strict-origin-when-cross-origin"
	}

	# Cache headers for hashed Vite static assets
	@static {
		path /assets/*
	}
	header @static {
		Cache-Control "public, max-age=31536000, immutable"
	}
}
