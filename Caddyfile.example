# Caddyfile.example — Configuration snippet for your external Caddy reverse proxy
# Replace `dms.yourdomain.com` with your actual domain or localhost.
#
# When the Docker stack is running (`docker compose up --build -d`), all services
# (React SPA, .NET Web API, docs, static assets) are served through the single
# exposed port on 127.0.0.1:8080.

dms.yourdomain.com {
	reverse_proxy 127.0.0.1:8080
}
