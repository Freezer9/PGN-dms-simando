@{
    var stages = Enum.GetValues<SubscriptionStatus>()
        .Where(s => s != SubscriptionStatus.Disetujui && s != SubscriptionStatus.Ditolak)
        .ToArray();
    var currentIdx = Array.IndexOf(stages, CurrentStatus);
}

<div class="workflow-steps">
    @for (int i = 0; i < stages.Length; i++)
    {
        var stage = stages[i];
        var stepClass = i < currentIdx ? "completed" : i == currentIdx ? "active" : "";
        if (IsRejected && i == currentIdx) stepClass = "rejected";

        <span class="workflow-step @stepClass">@stage</span>
        @if (i < stages.Length - 1)
        {
            <span class="workflow-arrow">&#8594;</span>
        }
    }
</div>

@code {
    [Parameter] public SubscriptionStatus CurrentStatus { get; set; }
    [Parameter] public bool IsRejected { get; set; }
}
