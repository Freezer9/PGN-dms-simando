@inject NavigationManager Navigation

<div class="simando-sidebar">
<BbSidebar>
    <BbSidebarHeader>
        <BbSidebarHeaderContent>
            <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                <LucideIcon Name="flame" Class="h-4 w-4" />
            </div>
            <BbSidebarHeaderInfo>
                <span class="truncate font-semibold">SIMANDO</span>
                <span class="truncate text-xs text-muted-foreground">Manajemen Berlangganan Gas</span>
            </BbSidebarHeaderInfo>
        </BbSidebarHeaderContent>
    </BbSidebarHeader>

    <BbSidebarContent>
        <BbSidebarGroup>
            <BbSidebarGroupLabel>Menu</BbSidebarGroupLabel>
            <BbSidebarGroupContent>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="Dashboard">
                            <LucideIcon Name="layout-dashboard" />
                            <span>Beranda</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>

                    <AuthorizeView Policy="@SimandoPolicies.CanApprove">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/tasks" Match="NavLinkMatch.All" Tooltip="Tugas Saya">
                                <LucideIcon Name="inbox" />
                                <span>Tugas Saya</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/tasks/history" Tooltip="Riwayat Tindakan">
                                <LucideIcon Name="history" />
                                <span>Riwayat</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Policy="@SimandoPolicies.CanManageTasksBlocked">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/tasks/blocked" Tooltip="Tugas Tertahan">
                                <LucideIcon Name="alert-triangle" />
                                <span>Tugas Tertahan</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    @* Gated by role rather than policy: Docs/14 gives Direktori and Plotting to
                       Sales Area (edit), Area Head (read-only) and Regional Admin (region-wide)
                       only — Reviewer and Division Head get no entry, which no existing policy
                       expresses. Regional Admin must be matched before Sales Area because it also
                       satisfies CanCreateSubscription. *@
                    <AuthorizeView Roles="@SimandoRoles.AdminRegional">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/directory/region" Tooltip="Direktori Region">
                                <LucideIcon Name="building-2" />
                                <span>Direktori</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/plotting/region" Tooltip="Plotting Region">
                                <LucideIcon Name="map-pin" />
                                <span>Plotting</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Roles="@SimandoRoles.SalesArea" Context="salesNav">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/directory" Match="NavLinkMatch.All" Tooltip="Direktori">
                                <LucideIcon Name="building-2" />
                                <span>Direktori</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/plotting" Match="NavLinkMatch.All" Tooltip="Plotting">
                                <LucideIcon Name="map-pin" />
                                <span>Plotting</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Roles="@SimandoRoles.AreaHead" Context="areaHeadNav">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/directory/read" Tooltip="Direktori">
                                <LucideIcon Name="building-2" />
                                <span>Direktori</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/plotting/read" Tooltip="Plotting">
                                <LucideIcon Name="map-pin" />
                                <span>Plotting</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Policy="@SimandoPolicies.CanViewSubscriptions">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/map" Tooltip="Peta">
                                <LucideIcon Name="map" />
                                <span>Peta</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Policy="@SimandoPolicies.CanAccessEvaluation">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/evaluation" Tooltip="Evaluasi">
                                <LucideIcon Name="file-check" />
                                <span>Evaluasi</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>
                </BbSidebarMenu>
            </BbSidebarGroupContent>
        </BbSidebarGroup>

        <AuthorizeView Policy="@SimandoPolicies.CanViewSubscriptions">
            <BbSidebarGroup>
                <BbSidebarGroupLabel>Laporan</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reports/sales-funnel" Tooltip="Corong Penjualan">
                                <LucideIcon Name="funnel" />
                                <span>Corong Penjualan</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reports/ageing" Tooltip="Penuaan">
                                <LucideIcon Name="clock" />
                                <span>Penuaan</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reports/potential" Tooltip="Potensi Kebutuhan">
                                <LucideIcon Name="trending-up" />
                                <span>Potensi Kebutuhan</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <AuthorizeView Policy="@SimandoPolicies.CanApprove" Context="reportsApprover">
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/reports/productivity" Tooltip="Produktivitas Survei">
                                    <LucideIcon Name="activity" />
                                    <span>Produktivitas Survei</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/reports/nol-results" Tooltip="Hasil NOL/RL">
                                    <LucideIcon Name="file-badge" />
                                    <span>Hasil NOL/RL</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </AuthorizeView>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

        <AuthorizeView Policy="@SimandoPolicies.CanAdminister">
            <BbSidebarGroup>
                <BbSidebarGroupLabel>Pengaturan</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/settings/users" Tooltip="Manajemen Pengguna">
                                <LucideIcon Name="shield-user" />
                                <span>Pengguna</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <AuthorizeView Policy="@SimandoPolicies.CanAdminister" Context="settingsOrg">
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/settings/organisation" Tooltip="Organisasi">
                                    <LucideIcon Name="building" />
                                    <span>Organisasi</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </AuthorizeView>
                        <AuthorizeView Policy="@SimandoPolicies.CanAdminister" Context="settingsMaster">
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/settings/master-data" Tooltip="Data Referensi">
                                    <LucideIcon Name="database" />
                                    <span>Data Referensi</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </AuthorizeView>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

        <AuthorizeView Policy="@SimandoPolicies.CanAccessBreakGlass">
            <BbSidebarGroup>
                <BbSidebarGroupLabel>Pemulihan</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/admin/break-glass" Tooltip="Akses Darurat">
                                <LucideIcon Name="shield-alert" />
                                <span>Akses Darurat</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <AuthorizeView Policy="@SimandoPolicies.CanAdminister" Context="stuckSteps">
                            <BbSidebarMenuItem>
                                <BbSidebarMenuButton Href="/admin/stuck-steps" Tooltip="Langkah Tertahan">
                                    <LucideIcon Name="circle-pause" />
                                    <span>Langkah Tertahan</span>
                                </BbSidebarMenuButton>
                            </BbSidebarMenuItem>
                        </AuthorizeView>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>
    </BbSidebarContent>

    <BbSidebarRail />
</BbSidebar>
</div>
