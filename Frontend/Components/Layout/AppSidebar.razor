@* Sidebar renders exactly one role tree. Each role's section is gated on its own policy,
   so a multi-role account sees the union rather than a merged, ambiguous menu. *@

<div class="simando-sidebar">
<BbSidebar>
    <BbSidebarHeader>
        <BbSidebarHeaderContent>
            <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                <LucideIcon Name="flame" Class="h-4 w-4" />
            </div>
            <BbSidebarHeaderInfo>
                <span class="truncate font-semibold">SIMANDO</span>
                <span class="truncate text-xs text-muted-foreground">Manajemen Berlangganan Gas</span>
            </BbSidebarHeaderInfo>
        </BbSidebarHeaderContent>
    </BbSidebarHeader>

    <BbSidebarContent>

        @* ── Sales Area ─────────────────────────────────────────────────── *@
        <AuthorizeView Policy="@SimandoPolicies.IsSalesArea" Context="salesArea">
            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/dashboard" Tooltip="Dashboard">
                                <LucideIcon Name="layout-dashboard" />
                                <span>Dashboard</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupLabel>Progress</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/directory" Tooltip="Directory">
                                <LucideIcon Name="building-2" />
                                <span>Directory</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/plotting" Tooltip="Plotting">
                                <LucideIcon Name="map-pin" />
                                <span>Plotting</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/prospect" Tooltip="Prospect">
                                <LucideIcon Name="users" />
                                <span>Prospect</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/survey" Tooltip="Survey">
                                <LucideIcon Name="clipboard-list" />
                                <span>Survey</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/a1" Tooltip="A1">
                                <LucideIcon Name="file-text" />
                                <span>A1</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/progress/monitoring" Tooltip="Monitoring">
                                <LucideIcon Name="activity" />
                                <span>Monitoring</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/sales-area/report-summary" Tooltip="Report Summary">
                                <LucideIcon Name="chart-no-axes-column" />
                                <span>Report Summary</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

        @* ── Area Head ──────────────────────────────────────────────────── *@
        <AuthorizeView Policy="@SimandoPolicies.IsAreaHead" Context="areaHead">
            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/area-head/dashboard" Tooltip="Dashboard">
                                <LucideIcon Name="layout-dashboard" />
                                <span>Dashboard</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupLabel>Progress</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/area-head/progress/approval" Tooltip="Approval">
                                <LucideIcon Name="check-circle" />
                                <span>Approval</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/area-head/progress/monitoring" Tooltip="Monitoring">
                                <LucideIcon Name="activity" />
                                <span>Monitoring</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/area-head/report-summary" Tooltip="Report Summary">
                                <LucideIcon Name="chart-no-axes-column" />
                                <span>Report Summary</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

        @* ── Region Sales ───────────────────────────────────────────────── *@
        <AuthorizeView Policy="@SimandoPolicies.IsRegionSales" Context="regionSales">
            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/dashboard" Tooltip="Dashboard">
                                <LucideIcon Name="layout-dashboard" />
                                <span>Dashboard</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupLabel>Progress</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/progress/kelayakan" Tooltip="Kelayakan">
                                <LucideIcon Name="filter" />
                                <span>Kelayakan</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/progress/review" Tooltip="Review">
                                <LucideIcon Name="file-check" />
                                <span>Review</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/progress/monitoring" Tooltip="Monitoring">
                                <LucideIcon Name="activity" />
                                <span>Monitoring</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupLabel>QA / QC</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/qa-qc/inbox" Tooltip="Inbox">
                                <LucideIcon Name="inbox" />
                                <span>Inbox</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/qa-qc/task" Tooltip="Task">
                                <LucideIcon Name="user-plus" />
                                <span>Task</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/qa-qc/progress" Tooltip="Progress">
                                <LucideIcon Name="loader" />
                                <span>Progress</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/qa-qc/monitoring" Tooltip="Monitoring">
                                <LucideIcon Name="gauge" />
                                <span>Monitoring</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/report-summary" Tooltip="Report Summary">
                                <LucideIcon Name="chart-no-axes-column" />
                                <span>Report Summary</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/region-sales/setting" Tooltip="Setting">
                                <LucideIcon Name="settings" />
                                <span>Setting</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

        @* ── Reviewer ───────────────────────────────────────────────────── *@
        <AuthorizeView Policy="@SimandoPolicies.IsReviewer" Context="reviewer">
            <BbSidebarGroup>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reviewer/dashboard" Tooltip="Dashboard">
                                <LucideIcon Name="layout-dashboard" />
                                <span>Dashboard</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>

            <BbSidebarGroup>
                <BbSidebarGroupLabel>QA / QC</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reviewer/qa-qc/inbox" Tooltip="Inbox">
                                <LucideIcon Name="inbox" />
                                <span>Inbox</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reviewer/qa-qc/task" Tooltip="Task">
                                <LucideIcon Name="list-checks" />
                                <span>Task</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reviewer/qa-qc/progress" Tooltip="Progress">
                                <LucideIcon Name="loader" />
                                <span>Progress</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/reviewer/qa-qc/review" Tooltip="Review">
                                <LucideIcon Name="file-pen-line" />
                                <span>Review</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>

    </BbSidebarContent>

    <BbSidebarRail />
</BbSidebar>
</div>
