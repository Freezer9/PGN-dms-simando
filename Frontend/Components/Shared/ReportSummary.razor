@inject ISubscriptionService Subscriptions

@* The five SIMANDO reports as one tabbed surface. Every role's report_summary page renders
   this; Scope only changes the heading, since the API already scopes rows to the caller. *@

<div style="display: flex; gap: 0.25rem; border-bottom: 1px solid var(--border); margin-bottom: 1rem; overflow-x: auto">
    @foreach (var tab in VisibleTabs)
    {
        <button type="button"
                class="btn btn-ghost btn-sm @(activeTab == tab.Key ? "btn-primary" : "")"
                style="border-radius: 0; border-bottom: 2px solid @(activeTab == tab.Key ? "var(--primary)" : "transparent")"
                @onclick="@(() => activeTab = tab.Key)">
            @tab.Label
        </button>
    }
</div>

@if (loading)
{
    <EmptyState Title="Memuat..." />
}
else if (activeTab == "funnel")
{
    <div class="stats-grid">
        @foreach (var s in Enum.GetValues<SubscriptionStatus>())
        {
            <StatTile Label="@SubscriptionStages.Label(s)"
                      Value="@companies.Count(c => c.Status == s).ToString()" />
        }
    </div>
    <div style="margin-top: 1rem">
        <DataTable TItem="SubscriptionStatus" Items="Enum.GetValues<SubscriptionStatus>()">
            <HeaderTemplate><th>Tahap</th><th>Jumlah</th><th>%</th></HeaderTemplate>
            <RowTemplate Context="s">
                @{
                    var count = companies.Count(c => c.Status == s);
                    var pct = companies.Count > 0 ? (double)count / companies.Count * 100 : 0;
                }
                <td><StatusBadge Status="@s" /></td>
                <td class="font-medium">@count</td>
                <td class="text-sm text-muted-foreground">@pct.ToString("F1")%</td>
            </RowTemplate>
        </DataTable>
    </div>
}
else if (activeTab == "ageing")
{
    <DataTable TItem="SubscriptionDto" Items="ageing"
               EmptyDescription="Tidak ada permohonan yang masih berjalan.">
        <HeaderTemplate>
            <th>Perusahaan</th><th>Area</th><th>Status</th><th>Umur (hari)</th><th>Update terakhir</th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var age = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(age > 30 ? "text-danger" : "")">@age hari</td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
        </RowTemplate>
    </DataTable>
}
else if (activeTab == "potential")
{
    <DataTable TItem="SubscriptionDto" Items="surveyed"
               EmptyDescription="Belum ada perusahaan yang mencapai tahap Survei.">
        <HeaderTemplate><th>Perusahaan</th><th>Area</th><th>Status</th><th>Update</th></HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
        </RowTemplate>
    </DataTable>
}
else if (activeTab == "productivity")
{
    <DataTable TItem="IGrouping<string, SubscriptionDto>" Items="bySales"
               EmptyDescription="Belum ada data produktivitas.">
        <HeaderTemplate><th>Sales</th><th>Total</th><th>Survey</th><th>A1</th><th>NOL</th></HeaderTemplate>
        <RowTemplate Context="group">
            <td class="font-medium">@group.Key</td>
            <td>@group.Count()</td>
            <td>@group.Count(s => SubscriptionStages.IsAtOrAfter(s.Status, SubscriptionStatus.Survey))</td>
            <td>@group.Count(s => SubscriptionStages.IsAtOrAfter(s.Status, SubscriptionStatus.A1))</td>
            <td>@group.Count(s => SubscriptionStages.IsAtOrAfter(s.Status, SubscriptionStatus.PermohonanNOL))</td>
        </RowTemplate>
    </DataTable>
}
else if (activeTab == "results")
{
    <div class="stats-grid">
        <StatTile Icon="check-circle" Label="NOL Diterbitkan"
                  Value="@companies.Count(c => c.Status == SubscriptionStatus.Disetujui).ToString()" />
        <StatTile Icon="x-circle" Label="RL Diterbitkan"
                  Value="@companies.Count(c => c.Status == SubscriptionStatus.Ditolak).ToString()" />
    </div>
    <div style="margin-top: 1rem">
        <DataTable TItem="SubscriptionDto" Items="issued" EmptyDescription="Belum ada penerbitan.">
            <HeaderTemplate><th>Perusahaan</th><th>Area</th><th>Hasil</th><th>Update</th></HeaderTemplate>
            <RowTemplate Context="sub">
                <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
                <td class="text-sm text-muted-foreground">@sub.AreaName</td>
                <td><StatusBadge Status="@sub.Status" /></td>
                <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            </RowTemplate>
        </DataTable>
    </div>
}

@code {
    /// <summary>Hides the Produktivitas Survei tab, which Docs denies to Reviewer.</summary>
    [Parameter] public bool ShowProductivity { get; set; } = true;

    private List<SubscriptionDto> companies = [];
    private string activeTab = "funnel";
    private bool loading = true;

    private readonly (string Key, string Label)[] allTabs =
    [
        ("funnel", "Corong Penjualan"),
        ("ageing", "Penuaan"),
        ("potential", "Potensi Kebutuhan"),
        ("productivity", "Produktivitas Survei"),
        ("results", "Hasil NOL/RL")
    ];

    private IEnumerable<(string Key, string Label)> VisibleTabs =>
        ShowProductivity ? allTabs : allTabs.Where(t => t.Key != "productivity");

    private List<SubscriptionDto> ageing => companies
        .Where(c => !SubscriptionStages.IsTerminal(c.Status))
        .OrderBy(c => c.UpdatedAt).ToList();

    private List<SubscriptionDto> surveyed => companies
        .Where(c => SubscriptionStages.IsAtOrAfter(c.Status, SubscriptionStatus.Survey))
        .OrderByDescending(c => c.UpdatedAt).ToList();

    private List<SubscriptionDto> issued => companies
        .Where(c => SubscriptionStages.IsTerminal(c.Status))
        .OrderByDescending(c => c.UpdatedAt).ToList();

    private List<IGrouping<string, SubscriptionDto>> bySales => companies
        .GroupBy(c => c.CreatedByName ?? "-")
        .OrderByDescending(g => g.Count()).ToList();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        loading = false;
    }
}
