@typeparam TItem
@* Editable child-table: header row, one RowTemplate per item with a remove button,
   and an add button underneath. Used by the survey / A1 / NOL / evaluation forms. *@

<div>
    @if (Items.Count == 0)
    {
        <div class="empty-state" style="padding: 1.5rem 1rem">
            <div class="empty-state-desc">@EmptyDescription</div>
        </div>
    }
    else
    {
        <table class="data-table">
            <thead>
                <tr>
                    @HeaderTemplate
                    <th style="width: 3rem"></th>
                </tr>
            </thead>
            <tbody>
                @for (var i = 0; i < Items.Count; i++)
                {
                    var index = i;
                    var item = Items[index];
                    <tr>
                        @RowTemplate(item)
                        <td>
                            <button type="button" class="btn btn-sm btn-ghost"
                                    title="Hapus baris"
                                    @onclick="@(() => RemoveAt(index))">
                                <LucideIcon Name="trash-2" Class="h-4 w-4" />
                            </button>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    }

    <div style="margin-top: 0.5rem">
        <button type="button" class="btn btn-sm btn-outline" @onclick="Add">
            <LucideIcon Name="plus" Class="h-4 w-4" />
            @AddLabel
        </button>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public List<TItem> Items { get; set; } = [];
    [Parameter] public EventCallback<List<TItem>> ItemsChanged { get; set; }
    [Parameter, EditorRequired] public RenderFragment HeaderTemplate { get; set; } = default!;
    [Parameter, EditorRequired] public RenderFragment<TItem> RowTemplate { get; set; } = default!;
    /// <summary>Creates a blank row. Required — the component cannot construct TItem itself.</summary>
    [Parameter, EditorRequired] public Func<TItem> ItemFactory { get; set; } = default!;
    [Parameter] public string AddLabel { get; set; } = "Tambah Baris";
    [Parameter] public string EmptyDescription { get; set; } = "Belum ada baris.";

    private async Task Add()
    {
        Items.Add(ItemFactory());
        await ItemsChanged.InvokeAsync(Items);
    }

    private async Task RemoveAt(int index)
    {
        Items.RemoveAt(index);
        await ItemsChanged.InvokeAsync(Items);
    }
}
