@* Search box plus any number of <select> filters passed as ChildContent. *@

<div class="flex gap-2" style="margin-bottom: 0.5rem">
    <input type="text" class="form-control" style="max-width: 20rem"
           placeholder="@Placeholder"
           value="@SearchValue"
           @oninput="OnSearchInput" />
    @ChildContent
</div>

@code {
    [Parameter] public string SearchValue { get; set; } = "";
    [Parameter] public EventCallback<string> SearchValueChanged { get; set; }
    [Parameter] public string Placeholder { get; set; } = "Cari...";
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private Task OnSearchInput(ChangeEventArgs e)
        => SearchValueChanged.InvokeAsync(e.Value?.ToString() ?? "");
}
