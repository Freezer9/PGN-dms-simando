@* Page title block. ChildContent renders to the right of the title as the action area. *@

<div class="page-header">
    <div>
        <h1>@Title</h1>
        @if (SubtitleContent is not null)
        {
            <p>@SubtitleContent</p>
        }
        else if (!string.IsNullOrWhiteSpace(Subtitle))
        {
            <p>@Subtitle</p>
        }
    </div>
    @ChildContent
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = "";
    [Parameter] public string? Subtitle { get; set; }
    /// <summary>Use instead of <see cref="Subtitle"/> when the subtitle contains markup.</summary>
    [Parameter] public RenderFragment? SubtitleContent { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
