@page "/region-sales/dashboard"
@attribute [Authorize(Policy = SimandoPolicies.IsRegionSales)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IActivityService Activity

<PageTitle>Dashboard Region Sales - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard" Subtitle="Peta cakupan komprehensif region dan ringkasan lalu lintas dokumen." />

    <div class="stats-grid">
        <StatTile Icon="building-2" Label="Total Region" Value="@companies.Count.ToString()" />
        <StatTile Icon="filter" Label="Menunggu Kelayakan" Value="@awaitingScreening.ToString()" />
        <StatTile Icon="users" Label="Sedang Direview" Value="@inReview.ToString()" />
        <StatTile Icon="alert-triangle" Label="Tertahan" Value="@blocked.ToString()"
                  Accent="@(blocked > 0 ? "var(--destructive)" : null)" />
    </div>

    <FormSection Title="Peta Cakupan Region" Spaced="false">
        <CompanyMap @ref="map" Companies="companies" Editable="true" Height="26rem"
                    OnPinMoved="ReloadAsync" />
    </FormSection>

    <div class="content-grid content-grid-3">
        <div class="col-span-2">
            <FormSection Title="Ringkasan per Tahap">
                <DataTable TItem="SubscriptionStatus" Items="Enum.GetValues<SubscriptionStatus>()">
                    <HeaderTemplate><th>Tahap</th><th>Jumlah</th></HeaderTemplate>
                    <RowTemplate Context="s">
                        <td><StatusBadge Status="@s" /></td>
                        <td class="font-medium">@companies.Count(c => c.Status == s)</td>
                    </RowTemplate>
                </DataTable>
            </FormSection>
        </div>
        <FormSection Title="Aktivitas Terbaru">
            @if (activity.Count == 0)
            {
                <EmptyState Title="Belum ada aktivitas" />
            }
            else
            {
                <div class="timeline">
                    @foreach (var entry in activity)
                    {
                        <div class="timeline-item">
                            <div class="timeline-item-title">@entry.ActorName @entry.Action</div>
                            <div class="timeline-item-time">@entry.At.ToString("d MMM yyyy HH:mm")</div>
                        </div>
                    }
                </div>
            }
        </FormSection>
    </div>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<ActivityLogDto> activity = [];
    private CompanyMap? map;

    private int awaitingScreening => companies.Count(c => c.Status == SubscriptionStatus.PermohonanNOL);
    private int inReview => companies.Count(c => c.Status == SubscriptionStatus.Evaluasi);
    private int blocked => companies.Count(c => c.Status == SubscriptionStatus.Ditolak);

    protected override async Task OnInitializedAsync() => await ReloadAsync();

    private async Task ReloadAsync()
    {
        companies = await Subscriptions.GetAllAsync();
        activity = await Activity.GetRecentAsync(8);
        if (map is not null) await map.RefreshAsync();
    }
}
