@page "/region-sales/qa-qc/progress"
@attribute [Authorize(Policy = SimandoPolicies.IsRegionSales)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IUserService UserApi

@* Documents currently in reviewers' hands, with per-step progress. *@

<PageTitle>QA/QC Progress - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Progress" Subtitle="Dokumen yang sedang dikerjakan Reviewer." />

    <div class="stats-grid">
        <StatTile Icon="users" Label="Sedang Dikerjakan" Value="@inProgress.Count.ToString()" />
        <StatTile Icon="check-circle" Label="Langkah Selesai" Value="@completedSteps.ToString()" />
        <StatTile Icon="clock" Label="Langkah Menunggu" Value="@pendingSteps.ToString()" />
    </div>

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan..." />

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="loader" EmptyTitle="Tidak ada dokumen berjalan"
               EmptyDescription="Tugaskan dokumen ke Reviewer dari halaman Task.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Reviewer</th>
            <th>Kemajuan</th>
            <th>Langkah Saat Ini</th>
            <th>Menunggu</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{
                var steps = sub.ReviewSteps.OrderBy(s => s.StepOrder).ToList();
                var done = steps.Count(s => s.Action is not null);
                var current = steps.FirstOrDefault(s => s.Action is null);
                var waiting = (DateTime.UtcNow - sub.UpdatedAt).Days;
            }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@ReviewerNames(sub)</td>
            <td class="font-medium">@done / @steps.Count</td>
            <td class="text-sm text-muted-foreground">@(current?.ReviewerName ?? "—")</td>
            <td class="font-medium @(waiting > 7 ? "text-danger" : "")">@waiting hari</td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Lihat</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<UserInfo> reviewers = [];
    private string searchQuery = "";
    private bool loading = true;

    private List<SubscriptionDto> inProgress => companies
        .Where(c => c.Status == SubscriptionStatus.Evaluasi && c.ReviewSteps.Count > 0)
        .ToList();

    private int completedSteps => inProgress.Sum(c => c.ReviewSteps.Count(s => s.Action is not null));
    private int pendingSteps => inProgress.Sum(c => c.ReviewSteps.Count(s => s.Action is null));

    private List<SubscriptionDto> filtered => inProgress
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .OrderBy(c => c.UpdatedAt)
        .ToList();

    private string ReviewerNames(SubscriptionDto sub)
    {
        var names = sub.ReviewSteps.OrderBy(s => s.StepOrder)
            .Select(s => s.ReviewerName ?? "(tidak dikenal)").ToList();
        return names.Count == 0 ? "—" : string.Join(", ", names);
    }

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        reviewers = await UserApi.GetUsersAsync();
        loading = false;
    }
}
