@page "/region-sales/qa-qc/monitoring"
@attribute [Authorize(Policy = SimandoPolicies.IsRegionSales)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IUserService UserApi

@* SLA and throughput per reviewer. Turnaround is measured from the review step's
   assignment to its decision; steps still open are counted as outstanding, not slow. *@

<PageTitle>QA/QC Monitoring - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Monitoring"
                Subtitle="Pantau SLA, kecepatan, dan kualitas kerja Reviewer." />

    <div class="stats-grid">
        <StatTile Icon="users" Label="Reviewer Aktif" Value="@reviewers.Count.ToString()" />
        <StatTile Icon="check-circle" Label="Total Keputusan" Value="@totalDecisions.ToString()" />
        <StatTile Icon="clock" Label="Langkah Terbuka" Value="@totalOpen.ToString()"
                  Accent="@(totalOpen > 0 ? "var(--destructive)" : null)" />
    </div>

    <FormSection Title="Kinerja per Reviewer" Spaced="false">
        <DataTable TItem="ReviewerStat" Items="stats" Loading="loading"
                   EmptyIcon="users" EmptyTitle="Belum ada data reviewer"
                   EmptyDescription="Data muncul setelah reviewer mulai memproses dokumen.">
            <HeaderTemplate>
                <th>Reviewer</th>
                <th>Ditugaskan</th>
                <th>Selesai</th>
                <th>Terbuka</th>
                <th>Setuju</th>
                <th>Revisi</th>
                <th>Tolak</th>
                <th>Rata-rata Turnaround</th>
            </HeaderTemplate>
            <RowTemplate Context="row">
                <td class="font-medium">@row.Name</td>
                <td>@row.Assigned</td>
                <td>@row.Completed</td>
                <td class="@(row.Open > 0 ? "text-danger font-medium" : "")">@row.Open</td>
                <td>@row.Approved</td>
                <td>@row.Revised</td>
                <td>@row.Rejected</td>
                <td class="text-sm text-muted-foreground">@row.TurnaroundLabel</td>
            </RowTemplate>
        </DataTable>
    </FormSection>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<UserInfo> reviewers = [];
    private bool loading = true;

    private sealed record ReviewerStat(
        string Name, int Assigned, int Completed, int Open,
        int Approved, int Revised, int Rejected, string TurnaroundLabel);

    private List<ReviewStepDto> allSteps => companies.SelectMany(c => c.ReviewSteps).ToList();
    private int totalDecisions => allSteps.Count(s => s.Action is not null);
    private int totalOpen => allSteps.Count(s => s.Action is null);

    private List<ReviewerStat> stats => reviewers
        .Select(r =>
        {
            var steps = allSteps.Where(s => s.ReviewerId == r.Id).ToList();
            var decided = steps.Where(s => s.Action is not null && s.ReviewedAt is not null).ToList();

            // The DTO carries no assignment timestamp, so turnaround is measured against the
            // parent record's creation — good enough to rank reviewers, not an audited SLA.
            var turnarounds = decided
                .Select(s => companies.First(c => c.Id == s.SubscriptionId))
                .Zip(decided, (company, step) => (step.ReviewedAt!.Value - company.CreatedAt).TotalDays)
                .Where(d => d >= 0)
                .ToList();

            return new ReviewerStat(
                r.FullName,
                steps.Count,
                decided.Count,
                steps.Count(s => s.Action is null),
                steps.Count(s => s.Action == ReviewAction.Setuju),
                steps.Count(s => s.Action == ReviewAction.Revisi),
                steps.Count(s => s.Action == ReviewAction.Tolak),
                turnarounds.Count == 0 ? "—" : $"{turnarounds.Average():F1} hari");
        })
        .OrderByDescending(s => s.Assigned)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        reviewers = (await UserApi.GetUsersAsync()).Where(u => u.Role == SimandoRoles.Reviewer).ToList();
        loading = false;
    }
}
