@page "/region-sales/qa-qc/task"
@attribute [Authorize(Policy = SimandoPolicies.IsRegionSales)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IWorkflowService Workflow
@inject IUserService UserApi
@inject ToastService Toasts

@* Where Region Sales assigns documents to Reviewers. *@

<PageTitle>QA/QC Task - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Task"
                Subtitle="Tetapkan dokumen ke Reviewer. Docs menyarankan 2–3 reviewer per kasus." />

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan...">
        <select class="form-control" style="max-width: 14rem" @bind="filterAssigned">
            <option value="">Semua</option>
            <option value="unassigned">Belum ditugaskan</option>
            <option value="assigned">Sudah ditugaskan</option>
        </select>
    </FilterBar>

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="user-plus" EmptyTitle="Tidak ada dokumen"
               EmptyDescription="Dokumen muncul setelah lolos uji kelayakan.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Reviewer Ditetapkan</th>
            <th>Status</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@AssignedNames(sub)</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td>
                <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => Open(sub))">
                    @(HasAssignees(sub) ? "Ubah" : "Tugaskan")
                </button>
            </td>
        </RowTemplate>
    </DataTable>
</div>

@if (assigning is not null)
{
    <BbDialog Open="true" OnOpenChange="@(open => { if (!open) assigning = null; })">
        <BbDialogContent Class="sm:max-w-md">
            <BbDialogHeader><BbDialogTitle>Tetapkan Reviewer — @assigning.CompanyName</BbDialogTitle></BbDialogHeader>
            <div class="space-y-4">
                @if (reviewers.Count == 0)
                {
                    <EmptyState Title="Belum ada reviewer"
                                Description="Tambahkan pengguna dengan role Reviewer di halaman Setting." />
                }
                else
                {
                    @foreach (var reviewer in reviewers)
                    {
                        <label class="flex gap-2 items-center">
                            <input type="checkbox" checked="@selected.Contains(reviewer.Id)"
                                   @onchange="@(e => Toggle(reviewer.Id, (bool)(e.Value ?? false)))" />
                            <span>@reviewer.FullName</span>
                        </label>
                    }
                    <div class="text-sm text-muted-foreground">@selected.Count reviewer dipilih.</div>
                }
                <div class="flex gap-2 justify-end">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => assigning = null)">Batal</BbButton>
                    <BbButton OnClick="@Save" Disabled="@(saving || selected.Count == 0)">
                        @(saving ? "Menyimpan..." : "Simpan")
                    </BbButton>
                </div>
            </div>
        </BbDialogContent>
    </BbDialog>
}
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<UserInfo> reviewers = [];
    private string searchQuery = "";
    private string filterAssigned = "";
    private bool loading = true;
    private bool saving;

    private SubscriptionDto? assigning;
    private readonly HashSet<string> selected = [];

    private List<SubscriptionDto> assignable => companies
        .Where(c => c.Status == SubscriptionStatus.Evaluasi)
        .ToList();

    private List<SubscriptionDto> filtered => assignable
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(c => filterAssigned switch
        {
            "unassigned" => !HasAssignees(c),
            "assigned" => HasAssignees(c),
            _ => true
        })
        .OrderBy(c => c.UpdatedAt)
        .ToList();

    private static bool HasAssignees(SubscriptionDto sub)
        => !string.IsNullOrWhiteSpace(sub.ReviewerIds);

    private string AssignedNames(SubscriptionDto sub)
    {
        var ids = sub.ReviewerIds.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(i => i.Trim()).ToList();
        if (ids.Count == 0) return "Belum ditugaskan";

        var names = ids
            .Select(id => reviewers.FirstOrDefault(r => r.Id == id)?.FullName ?? "(tidak dikenal)")
            .ToList();
        return string.Join(", ", names);
    }

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        reviewers = (await UserApi.GetUsersAsync()).Where(u => u.Role == SimandoRoles.Reviewer).ToList();
        loading = false;
    }

    private void Open(SubscriptionDto sub)
    {
        assigning = sub;
        selected.Clear();
        foreach (var id in sub.ReviewerIds.Split(',', StringSplitOptions.RemoveEmptyEntries))
            selected.Add(id.Trim());
    }

    private void Toggle(string id, bool on)
    {
        if (on) selected.Add(id); else selected.Remove(id);
    }

    private async Task Save()
    {
        if (assigning is null) return;
        saving = true;
        try
        {
            await Workflow.AssignReviewersAsync(assigning.Id, [.. selected]);
            Toasts.Success($"{selected.Count} reviewer ditetapkan untuk {assigning.CompanyName}.");
            assigning = null;
            await LoadAsync();
        }
        catch { Toasts.Error("Gagal menetapkan reviewer."); }
        finally { saving = false; }
    }
}
