@page "/region-sales/progress/review"
@attribute [Authorize(Policy = SimandoPolicies.IsRegionSales)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

@* History of documents that cleared the kelayakan gate. *@

<PageTitle>Review - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Review"
                Subtitle="Riwayat dokumen yang sudah lolos uji kelayakan." />

    <div class="stats-grid">
        <StatTile Icon="file-check" Label="Lolos Kelayakan" Value="@passed.Count.ToString()" />
        <StatTile Icon="users" Label="Sedang Direview" Value="@inReview.ToString()" />
        <StatTile Icon="check-circle" Label="Selesai" Value="@finished.ToString()" />
    </div>

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan...">
        <select class="form-control" style="max-width: 12rem" @bind="filterStatus">
            <option value="">Semua Status</option>
            @foreach (var s in trackedStatuses)
            {
                <option value="@s">@SubscriptionStages.Label(s)</option>
            }
        </select>
    </FilterBar>

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="file-check" EmptyTitle="Belum ada dokumen yang lolos"
               EmptyDescription="Loloskan dokumen dari halaman Kelayakan terlebih dahulu.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Reviewer Ditetapkan</th>
            <th>Update</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@ReviewerCount(sub)</td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Lihat</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private string searchQuery = "";
    private string filterStatus = "";
    private bool loading = true;

    private readonly SubscriptionStatus[] trackedStatuses =
    [
        SubscriptionStatus.Evaluasi,
        SubscriptionStatus.Penerbitan,
        SubscriptionStatus.Disetujui,
        SubscriptionStatus.Ditolak
    ];

    private List<SubscriptionDto> passed => companies
        .Where(c => trackedStatuses.Contains(c.Status)).ToList();

    private int inReview => companies.Count(c => c.Status == SubscriptionStatus.Evaluasi);
    private int finished => companies.Count(c => SubscriptionStages.IsTerminal(c.Status));

    private List<SubscriptionDto> filtered => passed
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrWhiteSpace(filterStatus) || c.Status.ToString() == filterStatus)
        .OrderByDescending(c => c.UpdatedAt)
        .ToList();

    private static string ReviewerCount(SubscriptionDto sub)
    {
        var n = sub.ReviewerIds.Split(',', StringSplitOptions.RemoveEmptyEntries).Length;
        return n == 0 ? "Belum ditetapkan" : $"{n} reviewer";
    }

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        loading = false;
    }
}
