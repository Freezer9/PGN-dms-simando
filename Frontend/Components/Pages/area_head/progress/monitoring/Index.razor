@page "/area-head/progress/monitoring"
@attribute [Authorize(Policy = SimandoPolicies.IsAreaHead)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IActivityService Activity

@* Movement of every record belonging to the Sales reps in this area. *@

<PageTitle>Monitoring - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Monitoring"
                Subtitle="Pantau pergerakan data dari seluruh Sales di area Anda." />

    <div class="stats-grid">
        <StatTile Icon="users" Label="Sales Aktif" Value="@salesCount.ToString()" />
        <StatTile Icon="file-text" Label="Total Record" Value="@companies.Count.ToString()" />
        <StatTile Icon="edit" Label="Masih Digarap" Value="@active.ToString()" />
        <StatTile Icon="check-circle" Label="Selesai" Value="@done.ToString()" />
    </div>

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan...">
        <select class="form-control" style="max-width: 14rem" @bind="filterSales">
            <option value="">Semua Sales</option>
            @foreach (var name in salesNames)
            {
                <option value="@name">@name</option>
            }
        </select>
    </FilterBar>

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyDescription="Belum ada data di area Anda.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Sales</th>
            <th>Tahap</th>
            <th>Diam Selama</th>
            <th>Update Terakhir</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var idle = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(idle > 21 ? "text-danger" : "")">@idle hari</td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Lihat</a></td>
        </RowTemplate>
    </DataTable>

    <FormSection Title="Aktivitas Terbaru">
        @if (activity.Count == 0)
        {
            <EmptyState Title="Belum ada aktivitas" />
        }
        else
        {
            <div class="timeline">
                @foreach (var entry in activity)
                {
                    <div class="timeline-item">
                        <div class="timeline-item-title">@entry.ActorName @entry.Action</div>
                        <div class="timeline-item-time">@entry.At.ToString("d MMM yyyy HH:mm")</div>
                        @if (!string.IsNullOrEmpty(entry.Details))
                        {
                            <div class="timeline-item-desc">@entry.Details</div>
                        }
                    </div>
                }
            </div>
        }
    </FormSection>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<ActivityLogDto> activity = [];
    private string searchQuery = "";
    private string filterSales = "";
    private bool loading = true;

    private List<string> salesNames => companies
        .Select(c => c.CreatedByName ?? "-").Distinct().OrderBy(n => n).ToList();

    private int salesCount => salesNames.Count;
    private int active => companies.Count(c => !SubscriptionStages.IsTerminal(c.Status));
    private int done => companies.Count(c => SubscriptionStages.IsTerminal(c.Status));

    private List<SubscriptionDto> filtered => companies
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(c => string.IsNullOrWhiteSpace(filterSales) || c.CreatedByName == filterSales)
        .OrderBy(c => c.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();
        activity = await Activity.GetRecentAsync(20);
        loading = false;
    }
}
