@page "/area-head/progress/approval"
@attribute [Authorize(Policy = SimandoPolicies.IsAreaHead)]
@rendermode InteractiveServer
@inject IWorkflowService Workflow
@inject ToastService Toasts

@* Antrean permohonan NOL dari Sales, with Setuju / Revisi / Tolak executed in place. *@

<PageTitle>Approval - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Approval"
                Subtitle="@($"{pending.Count} permohonan NOL menunggu keputusan Anda.")" />

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan..." />

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="check-circle" EmptyTitle="Tidak ada antrean"
               EmptyDescription="Semua permohonan sudah diproses.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Menunggu</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var waiting = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(waiting > 7 ? "text-danger" : "")">@waiting hari</td>
            <td>
                <div class="flex gap-2">
                    <a href="/companies/@sub.Id" class="btn btn-sm btn-ghost">Detail</a>
                    <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => Open(sub))">
                        Putuskan
                    </button>
                </div>
            </td>
        </RowTemplate>
    </DataTable>
</div>

@if (deciding is not null)
{
    <BbDialog Open="true" OnOpenChange="@(open => { if (!open) deciding = null; })">
        <BbDialogContent Class="sm:max-w-md">
            <BbDialogHeader><BbDialogTitle>Keputusan — @deciding.CompanyName</BbDialogTitle></BbDialogHeader>
            <div class="space-y-4">
                <div class="form-group">
                    <label class="form-label">
                        Komentar @(action == ReviewAction.Setuju ? "(opsional)" : "(wajib)")
                    </label>
                    <textarea class="form-control" rows="4" @bind="comment"
                              placeholder="Jelaskan alasan keputusan..."></textarea>
                </div>
                <div class="flex gap-2 justify-end">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => deciding = null)">Batal</BbButton>
                    <BbButton OnClick="@(() => Submit(ReviewAction.Setuju))" Disabled="@submitting">Setuju</BbButton>
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => Submit(ReviewAction.Revisi))"
                              Disabled="@submitting">Minta Revisi</BbButton>
                    <BbButton Variant="ButtonVariant.Destructive" OnClick="@(() => Submit(ReviewAction.Tolak))"
                              Disabled="@submitting">Tolak</BbButton>
                </div>
            </div>
        </BbDialogContent>
    </BbDialog>
}
</AppShell>

@code {
    private List<SubscriptionDto> pending = [];
    private string searchQuery = "";
    private bool loading = true;
    private bool submitting;

    private SubscriptionDto? deciding;
    private ReviewAction action = ReviewAction.Setuju;
    private string comment = "";

    private List<SubscriptionDto> filtered => pending
        .Where(p => string.IsNullOrWhiteSpace(searchQuery)
            || p.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .OrderBy(p => p.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync() => await LoadAsync();

    private async Task LoadAsync()
    {
        loading = true;
        pending = await Workflow.GetPendingReviewAsync();
        loading = false;
    }

    private void Open(SubscriptionDto sub)
    {
        deciding = sub;
        comment = "";
        action = ReviewAction.Setuju;
    }

    private async Task Submit(ReviewAction chosen)
    {
        if (deciding is null) return;

        // Docs makes a comment mandatory for Revisi and Tolak.
        if (chosen is ReviewAction.Revisi or ReviewAction.Tolak && string.IsNullOrWhiteSpace(comment))
        {
            action = chosen;
            Toasts.Error("Komentar wajib diisi untuk Revisi dan Tolak.");
            return;
        }

        submitting = true;
        try
        {
            if (await Workflow.SubmitReviewAsync(deciding.Id, chosen, comment))
            {
                Toasts.Success($"{chosen} tersimpan untuk {deciding.CompanyName}.");
                deciding = null;
                await LoadAsync();
            }
            else
            {
                Toasts.Error("Gagal menyimpan keputusan.");
            }
        }
        finally { submitting = false; }
    }
}
