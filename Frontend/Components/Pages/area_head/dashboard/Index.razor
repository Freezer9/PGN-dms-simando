@page "/area-head/dashboard"
@attribute [Authorize(Policy = SimandoPolicies.IsAreaHead)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IWorkflowService Workflow

<PageTitle>Dashboard Area Head - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard" Subtitle="Peta cakupan area dan ringkasan beban antrean." />

    <div class="stats-grid">
        <StatTile Icon="inbox" Label="Menunggu Persetujuan" Value="@pending.Count.ToString()"
                  Accent="@(pending.Count > 0 ? "var(--destructive)" : null)" />
        <StatTile Icon="building-2" Label="Perusahaan di Area" Value="@companies.Count.ToString()" />
        <StatTile Icon="clock" Label="Antrean Terlama" Value="@oldestLabel" />
        <StatTile Icon="check-circle" Label="Selesai"
                  Value="@companies.Count(c => SubscriptionStages.IsTerminal(c.Status)).ToString()" />
    </div>

    <FormSection Title="Peta Cakupan Area" Spaced="false">
        <CompanyMap Companies="companies" Editable="false" Height="24rem" />
    </FormSection>

    <FormSection Title="Beban Antrean" Description="Permohonan yang menunggu tindakan Anda.">
        <DataTable TItem="SubscriptionDto" Items="pending"
                   EmptyIcon="check-circle" EmptyTitle="Tidak ada antrean"
                   EmptyDescription="Semua permohonan sudah diproses.">
            <HeaderTemplate>
                <th>Perusahaan</th><th>Sales</th><th>Status</th><th>Menunggu</th><th></th>
            </HeaderTemplate>
            <RowTemplate Context="sub">
                @{ var waiting = (DateTime.UtcNow - sub.UpdatedAt).Days; }
                <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
                <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
                <td><StatusBadge Status="@sub.Status" /></td>
                <td class="font-medium @(waiting > 7 ? "text-danger" : "")">@waiting hari</td>
                <td><a href="/area-head/progress/approval" class="btn btn-sm btn-outline">Tinjau</a></td>
            </RowTemplate>
        </DataTable>
    </FormSection>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private List<SubscriptionDto> pending = [];

    private string oldestLabel => pending.Count == 0
        ? "—"
        : $"{pending.Max(p => (DateTime.UtcNow - p.UpdatedAt).Days)} hari";

    protected override async Task OnInitializedAsync()
    {
        companies = await Subscriptions.GetAllAsync();
        pending = await Workflow.GetPendingReviewAsync();
    }
}
