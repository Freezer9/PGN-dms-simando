@page "/settings/organisation"
@attribute [Authorize(Policy = SimandoPolicies.CanAdminister)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Organisasi - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Organisasi" Subtitle="Kelola region SOR dan area." />

    <DataTable TItem="RegionDto" Items="regions" EmptyTitle="Belum ada data organisasi">
        <HeaderTemplate>
            <th>Region</th>
            <th>Area</th>
            <th>Jumlah Area</th>
        </HeaderTemplate>
        <RowTemplate Context="region">
            <td class="font-medium">@region.Name</td>
            <td class="text-sm text-muted-foreground">@string.Join(", ", region.Areas.Select(a => a.Name))</td>
            <td>@region.Areas.Count</td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<RegionDto> regions = [];
    protected override async Task OnInitializedAsync() { regions = await Subscriptions.GetRegionsAsync(); }
}
