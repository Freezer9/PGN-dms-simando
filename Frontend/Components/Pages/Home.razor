@page "/"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject NavigationManager Navigation

@* Root is a dispatcher only — every role lands on its own dashboard. *@

<PageTitle>SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <EmptyState Title="Membuka dashboard Anda..." />
</div>
</AppShell>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        if (AuthState is null) return;

        var target = CurrentUser.PrimaryRole((await AuthState).User) switch
        {
            SimandoRoles.SalesArea => "/sales-area/dashboard",
            SimandoRoles.AreaHead => "/area-head/dashboard",
            SimandoRoles.RegionSales => "/region-sales/dashboard",
            SimandoRoles.Reviewer => "/reviewer/dashboard",
            _ => null
        };

        if (target is not null) Navigation.NavigateTo(target, replace: true);
    }
}
