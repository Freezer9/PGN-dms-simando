@page "/plotting"
@attribute [Authorize(Policy = SimandoPolicies.CanCreateSubscription)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IStageService Stages
@inject IUserService UserApi
@inject ToastService Toasts

<PageTitle>Plotting - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Plotting"
                Subtitle="Tetapkan Plotting By, Posisi Pelanggan, dan Kawasan untuk membuka tahap Prospek." />

    <div class="stats-grid">
        <StatTile Icon="map-pin" Label="Total Perusahaan" Value="@allSubscriptions.Count.ToString()" />
        <StatTile Icon="check-circle" Label="Plotting Lengkap" Value="@completeCount.ToString()" />
        <StatTile Icon="clock" Label="Belum Lengkap"
                  Value="@((allSubscriptions.Count - completeCount).ToString())" />
    </div>

    <DataTable TItem="SubscriptionDto" Items="ordered" Loading="loading">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Plotting By</th>
            <th>Posisi Pelanggan</th>
            <th>Kawasan</th>
            <th>Status</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var p = PlottingFor(sub.Id); }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@(p?.SalesUserName ?? "—")</td>
            <td class="text-sm text-muted-foreground">@Label(p?.PosisiPelanggan)</td>
            <td class="text-sm text-muted-foreground">@Label(p?.Kawasan)</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td>
                <button type="button" class="btn btn-sm btn-outline" @onclick="@(() => OpenEditor(sub))">
                    @(p is null || !p.IsComplete ? "Lengkapi" : "Ubah")
                </button>
            </td>
        </RowTemplate>
    </DataTable>
</div>

@if (editing is not null)
{
    <BbDialog Open="true" OnOpenChange="@(open => { if (!open) editing = null; })">
        <BbDialogContent Class="sm:max-w-md">
            <BbDialogHeader>
                <BbDialogTitle>Plotting — @editing.CompanyName</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4">
                <div class="form-group">
                    <label class="form-label">Plotting By (sales)</label>
                    <select class="form-control" @bind="form.SalesUserId">
                        <option value="">Pilih sales</option>
                        @foreach (var user in salesUsers)
                        {
                            <option value="@user.Id">@user.FullName</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Posisi Pelanggan</label>
                    <select class="form-control" @bind="form.PosisiPelanggan">
                        <option value="">Pilih posisi</option>
                        <option value="@PosisiPelanggan.PengembanganJaringan">Pengembangan Jaringan</option>
                        <option value="@PosisiPelanggan.JalurExisting">Jalur Existing</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Kawasan</label>
                    <select class="form-control" @bind="form.Kawasan">
                        <option value="">Pilih kawasan</option>
                        <option value="@Kawasan.KawasanIndustri">Kawasan Industri</option>
                        <option value="@Kawasan.NonKawasanIndustri">Non Kawasan Industri</option>
                    </select>
                </div>

                @if (!FormComplete)
                {
                    <div class="alert alert-info">
                        Ketiga field harus terisi sebelum record dapat lanjut ke tahap Prospek.
                    </div>
                }

                <div class="flex gap-2 justify-end">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => editing = null)">Batal</BbButton>
                    <BbButton OnClick="@Save" Disabled="@saving">
                        @(saving ? "Menyimpan..." : "Simpan")
                    </BbButton>
                </div>
            </div>
        </BbDialogContent>
    </BbDialog>
}
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];
    private List<UserInfo> salesUsers = [];
    private readonly Dictionary<int, PlottingDto> plottings = [];
    private bool loading = true;
    private bool saving;

    private SubscriptionDto? editing;
    private SavePlottingRequest form = new();

    private List<SubscriptionDto> ordered => allSubscriptions.OrderByDescending(s => s.UpdatedAt).ToList();
    private int completeCount => plottings.Values.Count(p => p.IsComplete);
    private bool FormComplete => !string.IsNullOrWhiteSpace(form.SalesUserId)
        && form.PosisiPelanggan.HasValue && form.Kawasan.HasValue;

    private PlottingDto? PlottingFor(int subscriptionId)
        => plottings.TryGetValue(subscriptionId, out var p) ? p : null;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        allSubscriptions = await Subscriptions.GetAllAsync();

        try { salesUsers = (await UserApi.GetUsersAsync()).Where(u => u.Role == SimandoRoles.SalesArea).ToList(); }
        catch { salesUsers = []; }  // Sales Area cannot list users; the picker degrades to empty.

        foreach (var sub in allSubscriptions)
        {
            var plotting = await Stages.GetPlottingAsync(sub.Id);
            if (plotting is not null) plottings[sub.Id] = plotting;
        }

        loading = false;
    }

    private void OpenEditor(SubscriptionDto sub)
    {
        editing = sub;
        var existing = PlottingFor(sub.Id);
        form = new SavePlottingRequest
        {
            SalesUserId = existing?.SalesUserId,
            PosisiPelanggan = existing?.PosisiPelanggan,
            Kawasan = existing?.Kawasan
        };
    }

    private async Task Save()
    {
        if (editing is null) return;
        saving = true;
        try
        {
            var saved = await Stages.SavePlottingAsync(editing.Id, form);
            plottings[editing.Id] = saved;
            Toasts.Success($"Plotting {editing.CompanyName} tersimpan.");
            editing = null;
        }
        catch
        {
            Toasts.Error("Gagal menyimpan plotting.");
        }
        finally { saving = false; }
    }

    private static string Label(PosisiPelanggan? value) => value switch
    {
        PosisiPelanggan.PengembanganJaringan => "Pengembangan Jaringan",
        PosisiPelanggan.JalurExisting => "Jalur Existing",
        _ => "—"
    };

    private static string Label(Kawasan? value) => value switch
    {
        Kawasan.KawasanIndustri => "Kawasan Industri",
        Kawasan.NonKawasanIndustri => "Non Kawasan Industri",
        _ => "—"
    };
}
