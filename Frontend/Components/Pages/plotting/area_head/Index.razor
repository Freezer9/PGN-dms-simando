@page "/plotting/read"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Plotting - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Plotting" Subtitle="Daftar plotting area — Posisi Pelanggan dan assigned rep." />

    <DataTable TItem="SubscriptionDto" Items="ordered" Loading="loading">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Update</th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];
    private bool loading = true;

    private List<SubscriptionDto> ordered => allSubscriptions.OrderByDescending(s => s.UpdatedAt).ToList();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        allSubscriptions = await Subscriptions.GetAllAsync();
        loading = false;
    }
}
