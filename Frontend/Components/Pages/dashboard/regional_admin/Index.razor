@page "/dashboard/regional"
@attribute [Authorize(Policy = SimandoPolicies.CanViewDashboard)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IWorkflowService Workflow

<PageTitle>Dashboard Regional - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard Regional Admin" Subtitle="Tugas tertahan, corong region, dan penuaan." />

    <div class="stats-grid">
        <StatTile Icon="file-text" Label="Total Region" Value="@allSubscriptions.Count.ToString()" />
        <StatTile Icon="inbox" Label="Menunggu Evaluasi" Value="@pending.Count.ToString()" />
        <StatTile Icon="alert-triangle" Label="Tertahan"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Ditolak).ToString()" />
        <StatTile Icon="check-circle" Label="Disetujui"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Disetujui).ToString()" />
    </div>

    <DataTable TItem="SubscriptionStatus" Items="Enum.GetValues<SubscriptionStatus>()">
        <HeaderTemplate>
            <th>Tahap</th>
            <th>Jumlah</th>
        </HeaderTemplate>
        <RowTemplate Context="s">
            <td><StatusBadge Status="@s" /></td>
            <td class="font-medium">@allSubscriptions.Count(x => x.Status == s)</td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];
    private List<SubscriptionDto> pending = [];

    protected override async Task OnInitializedAsync()
    {
        allSubscriptions = await Subscriptions.GetAllAsync();
        pending = await Workflow.GetPendingReviewAsync();
    }
}
