@page "/dashboard/admin"
@attribute [Authorize(Policy = SimandoPolicies.CanAdminister)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IUserService UserApi
@inject IMasterDataService MasterData

<PageTitle>Dashboard Admin - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Master Data Health" Subtitle="Status kelengkapan data referensi sistem." />

    <div class="stats-grid">
        <StatTile Icon="users" Label="Pengguna Aktif" Value="@users.Count.ToString()" />
        <StatTile Icon="building" Label="Area" Value="@areas.Count.ToString()" />
        <StatTile Icon="map" Label="Region" Value="@regions.Count.ToString()" />
        <StatTile Icon="database" Label="Data Referensi" Value="@masterData.Count.ToString()"
                  Accent="@(masterData.Count == 0 ? "var(--destructive)" : null)" />
    </div>

    <DataTable TItem="string" Items="SimandoRoles.All">
        <HeaderTemplate>
            <th>Role</th>
            <th>Jumlah</th>
        </HeaderTemplate>
        <RowTemplate Context="role">
            <td class="font-medium">@role</td>
            <td>@users.Count(u => u.Role == role)</td>
        </RowTemplate>
    </DataTable>

    @if (emptyCategories.Count > 0)
    {
        <FormSection Title="Perlu Perhatian">
            @foreach (var category in emptyCategories)
            {
                <div class="alert alert-warning">
                    Katalog <strong>@category</strong> masih kosong — lengkapi di
                    <a href="/settings/master-data">Data Referensi</a>.
                </div>
            }
        </FormSection>
    }
</div>
</AppShell>

@code {
    private List<UserInfo> users = [];
    private List<AreaDto> areas = [];
    private List<RegionDto> regions = [];
    private List<MasterDataEntryDto> masterData = [];

    // Docs calls these out as the "Perlu Perhatian" alerts on the System Admin landing page.
    private List<string> emptyCategories => Enum.GetValues<MasterCategory>()
        .Where(c => !masterData.Any(m => m.Category == c && m.IsActive))
        .Select(c => c.ToString())
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        users = await UserApi.GetUsersAsync();
        areas = await Subscriptions.GetAreasAsync();
        regions = await Subscriptions.GetRegionsAsync();
        masterData = await MasterData.GetAsync();
    }
}
