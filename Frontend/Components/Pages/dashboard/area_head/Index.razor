@page "/dashboard/area-head"
@attribute [Authorize(Policy = SimandoPolicies.CanViewDashboard)]
@rendermode InteractiveServer
@inject IWorkflowService Workflow
@inject IActivityService Activity

<PageTitle>Dashboard Area Head - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard Area Head" Subtitle="Pending approval dan kinerja persetujuan area." />

    <div class="stats-grid">
        <StatTile Icon="inbox" Label="Menunggu Persetujuan" Value="@pending.Count.ToString()" />
    </div>

    <DataTable TItem="SubscriptionDto" Items="pending"
               EmptyTitle="Tidak ada antrean"
               EmptyDescription="Semua permohonan sudah diproses.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Tinjau</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> pending = [];

    protected override async Task OnInitializedAsync()
    {
        pending = await Workflow.GetPendingReviewAsync();
    }
}
