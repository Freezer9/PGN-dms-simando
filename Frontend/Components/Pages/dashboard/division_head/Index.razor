@page "/dashboard/division"
@attribute [Authorize(Policy = SimandoPolicies.CanViewDashboard)]
@rendermode InteractiveServer
@inject IWorkflowService Workflow
@inject ISubscriptionService Subscriptions

<PageTitle>Dashboard Division Head - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard Division Head" Subtitle="Antrean penerbitan dan ringkasan region." />

    <div class="stats-grid">
        <StatTile Icon="inbox" Label="Menunggu Penerbitan" Value="@pending.Count.ToString()" />
        <StatTile Icon="check-circle" Label="NOL Diterbitkan"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Disetujui).ToString()" />
        <StatTile Icon="x-circle" Label="RL Diterbitkan"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Ditolak).ToString()" />
    </div>

    <DataTable TItem="SubscriptionDto" Items="pending" EmptyTitle="Tidak ada antrean">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Terbitkan</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> pending = [];
    private List<SubscriptionDto> allSubscriptions = [];

    protected override async Task OnInitializedAsync()
    {
        pending = await Workflow.GetPendingReviewAsync();
        allSubscriptions = await Subscriptions.GetAllAsync();
    }
}
