@page "/dashboard/sales"
@attribute [Authorize(Policy = SimandoPolicies.CanViewDashboard)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IActivityService Activity
@inject NavigationManager Navigation

<PageTitle>Dashboard Sales - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-6 page-content">
    <PageHeader Title="Dashboard Sales Area" Subtitle="Perlu tindakan, pipeline, dan aktivitas terbaru.">
        <BbButton OnClick="@(() => Navigation.NavigateTo("/directory/new"))">
            <LucideIcon Name="plus" Class="h-4 w-4" />
            Tambah Perusahaan
        </BbButton>
    </PageHeader>

    <div class="stats-grid">
        <StatTile Icon="file-text" Label="Total Perusahaan"
                  Value="@allSubscriptions.Count.ToString()" />
        <StatTile Icon="edit" Label="Dalam Proses"
                  Value="@allSubscriptions.Count(s => SubscriptionStages.IsBefore(s.Status, SubscriptionStatus.PermohonanNOL)).ToString()" />
        <StatTile Icon="alert-triangle" Label="Ditolak"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Ditolak).ToString()" />
        <StatTile Icon="check-circle" Label="Disetujui"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Disetujui).ToString()" />
    </div>

    <div class="content-grid content-grid-3">
        <div class="card col-span-2">
            <div class="card-header">
                <div class="card-title">Pipeline Saya</div>
            </div>
            <div class="card-content" style="padding: 0">
                <DataTable TItem="SubscriptionStatus" Items="occupiedStages"
                           EmptyTitle="Belum ada perusahaan">
                    <HeaderTemplate>
                        <th>Tahap</th>
                        <th>Jumlah</th>
                    </HeaderTemplate>
                    <RowTemplate Context="s">
                        <td><StatusBadge Status="@s" /></td>
                        <td class="font-medium">@allSubscriptions.Count(x => x.Status == s)</td>
                    </RowTemplate>
                </DataTable>
            </div>
        </div>
        <div class="card">
            <div class="card-header"><div class="card-title">Aktivitas Terbaru</div></div>
            <div class="card-content">
                <div class="timeline">
                    @foreach (var entry in activityLogs)
                    {
                        <div class="timeline-item">
                            <div class="timeline-item-title">@entry.ActorName @entry.Action</div>
                            <div class="timeline-item-time">@Ago(entry.At)</div>
                        </div>
                    }
                </div>
            </div>
        </div>
    </div>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];
    private List<ActivityLogDto> activityLogs = [];

    // Only stages that actually hold records — an all-zero funnel is noise on a dashboard.
    private List<SubscriptionStatus> occupiedStages => Enum.GetValues<SubscriptionStatus>()
        .Where(s => allSubscriptions.Any(x => x.Status == s))
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        allSubscriptions = await Subscriptions.GetAllAsync();
        activityLogs = (await Activity.GetRecentAsync(8)).ToList();
    }

    private static string Ago(DateTime at)
    {
        var delta = DateTime.UtcNow - at;
        return delta switch
        {
            { TotalMinutes: < 1 } => "baru saja",
            { TotalHours: < 1 } => $"{(int)delta.TotalMinutes}m lalu",
            { TotalDays: < 1 } => $"{(int)delta.TotalHours}j lalu",
            { TotalDays: < 30 } => $"{(int)delta.TotalDays}h lalu",
            _ => at.ToString("d MMM")
        };
    }
}
