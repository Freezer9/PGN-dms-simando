@page "/companies/{CompanyId:int}/evaluation"
@attribute [Authorize(Policy = SimandoPolicies.CanAccessEvaluation)]
@rendermode InteractiveServer

<PageTitle>Evaluasi Kelayakan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <div class="page-header">
        <div>
            <h1>Evaluasi Kelayakan</h1>
            <p>FEED, capex final, pipe sizing, G-Size, IRR/NPV, assign reviewer.</p>
        </div>
    </div>
</div>
</AppShell>

@code {
    [Parameter] public int CompanyId { get; set; }
}
