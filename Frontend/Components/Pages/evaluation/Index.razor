@page "/evaluation"
@attribute [Authorize(Policy = SimandoPolicies.CanAccessEvaluation)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

@* Region-wide evaluation queue. Per-company evaluation lives at /companies/{id}/evaluation. *@

<PageTitle>Evaluasi - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Evaluasi"
                Subtitle="@($"{queue.Count} perusahaan berada pada tahap Evaluasi di region Anda.")" />

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan...">
        <select class="form-control" style="max-width: 12rem" @bind="filterArea">
            <option value="">Semua Area</option>
            @foreach (var area in areas)
            {
                <option value="@area.Name">@area.Name</option>
            }
        </select>
    </FilterBar>

    <DataTable TItem="SubscriptionDto" Items="queue" Loading="loading"
               EmptyIcon="clipboard-check" EmptyTitle="Tidak ada evaluasi tertunda"
               EmptyDescription="Belum ada permohonan yang mencapai tahap Evaluasi.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Menunggu</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var waiting = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(waiting > 30 ? "text-danger" : "")">@waiting hari</td>
            <td><a href="/companies/@sub.Id/evaluation" class="btn btn-sm btn-outline">Evaluasi</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];
    private List<AreaDto> areas = [];
    private string searchQuery = "";
    private string filterArea = "";
    private bool loading = true;

    private List<SubscriptionDto> queue => allSubscriptions
        .Where(s => s.Status == SubscriptionStatus.Evaluasi)
        .Where(s => string.IsNullOrWhiteSpace(searchQuery)
            || s.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .Where(s => string.IsNullOrWhiteSpace(filterArea) || s.AreaName == filterArea)
        .OrderBy(s => s.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        areas = await Subscriptions.GetAreasAsync();
        allSubscriptions = await Subscriptions.GetAllAsync();
        loading = false;
    }
}
