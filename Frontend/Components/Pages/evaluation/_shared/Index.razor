@page "/companies/{CompanyId:int}/evaluation/read"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IEvaluationService EvaluationSvc

<PageTitle>Evaluasi Kelayakan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Evaluasi Kelayakan" Subtitle="Tampilan hanya-baca hasil evaluasi Regional Admin." />

    @if (sub is null)
    {
        <EmptyState Title="Perusahaan tidak ditemukan" />
    }
    else if (detail is null && string.IsNullOrWhiteSpace(resume))
    {
        <EmptyState Title="Evaluasi belum diisi"
                    Description="Regional Admin belum melakukan evaluasi untuk perusahaan ini." />
    }
    else
    {
        <FormSection Title="@sub.CompanyName" Description="@sub.AreaName" Spaced="false">
            <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value"><StatusBadge Status="@sub.Status" /></span></div>
            @if (detail?.EvaluatedAt is not null)
            {
                <div class="detail-row">
                    <span class="detail-label">Dievaluasi</span>
                    <span class="detail-value">@detail.EvaluatedByName — @detail.EvaluatedAt.Value.ToString("d MMM yyyy HH:mm")</span>
                </div>
            }
        </FormSection>

        @if (detail is not null)
        {
            <FormSection Title="Gate Review">
                <div class="detail-row"><span class="detail-label">Status FEED</span><span class="detail-value">@Text(detail.FeedStatus?.ToString())</span></div>
                <div class="detail-row"><span class="detail-label">Capex Final</span><span class="detail-value">@Text(detail.CapexFinal?.ToString("N0"))</span></div>
                <div class="detail-row"><span class="detail-label">Pipa Induk</span><span class="detail-value">@Text(detail.PipaIndukPanjang?.ToString()) m &middot; ⌀ @Text(detail.PipaIndukDiameter?.ToString()) @detail.PipaIndukUnit</span></div>
                <div class="detail-row"><span class="detail-label">Pipa Service</span><span class="detail-value">@Text(detail.PipaServicePanjang?.ToString()) m &middot; ⌀ @Text(detail.PipaServiceDiameter?.ToString()) @detail.PipaServiceUnit</span></div>
                <div class="detail-row"><span class="detail-label">Spesifikasi MRS</span><span class="detail-value">@Text(detail.MrsSpecName)</span></div>
                <div class="detail-row"><span class="detail-label">G-Size</span><span class="detail-value">@Text(detail.MeterSizeName)</span></div>
                <div class="detail-row"><span class="detail-label">Tekanan / Flowrate</span><span class="detail-value">@Text(detail.Tekanan?.ToString()) / @Text(detail.MaksFlowrate?.ToString())</span></div>
                <div class="detail-row"><span class="detail-label">Ketersediaan Pasokan</span><span class="detail-value">@Text(detail.KetersediaanPasokanBbtud?.ToString()) BBTUD</span></div>
                <div class="detail-row"><span class="detail-label">Status RKAP</span><span class="detail-value">@Text(detail.StatusRkap?.ToString())</span></div>
                <div class="detail-row"><span class="detail-label">Skema Pembayaran</span><span class="detail-value">@Text(detail.SkemaPembayaran?.ToString())</span></div>
            </FormSection>

            @if (detail.Scenarios.Count > 0)
            {
                <FormSection Title="Kelayakan Finansial">
                    <table class="data-table">
                        <thead><tr><th>Skenario</th><th>IRR (%)</th><th>NPV</th><th>Payback</th><th>Hasil</th></tr></thead>
                        <tbody>
                            @foreach (var row in detail.Scenarios)
                            {
                                <tr>
                                    <td>@row.Label</td>
                                    <td>@row.IrrPct</td>
                                    <td>@row.Npv</td>
                                    <td>@row.PaybackYears</td>
                                    <td>@row.HasilAnalisis</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </FormSection>
            }

            @if (!string.IsNullOrWhiteSpace(detail.Kesimpulan))
            {
                <FormSection Title="Kesimpulan">
                    <div class="detail-value" style="white-space: pre-wrap">@detail.Kesimpulan</div>
                </FormSection>
            }
        }

        @if (!string.IsNullOrWhiteSpace(resume))
        {
            <FormSection Title="Resume Evaluasi">
                <div class="detail-value" style="white-space: pre-wrap">@resume</div>
            </FormSection>
        }
    }
</div>
</AppShell>

@code {
    [Parameter] public int CompanyId { get; set; }

    private SubscriptionDto? sub;
    private NolEvaluationDto? detail;
    private string resume = "";

    protected override async Task OnParametersSetAsync()
    {
        sub = await Subscriptions.GetAsync(CompanyId);
        if (sub is null) return;

        detail = await EvaluationSvc.GetDetailAsync(CompanyId);
        resume = (await EvaluationSvc.GetAsync(CompanyId))?.Content ?? "";
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
