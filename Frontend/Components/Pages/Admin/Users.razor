@page "/admin/users"
@attribute [Authorize(Policy = SimandoPolicies.CanAdminister)]
@rendermode InteractiveServer
@inject IUserService UserApi
@inject ISubscriptionService Subscriptions
@inject ToastService Toasts

<PageTitle>Pengguna - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <div class="page-header">
        <div>
            <h1>Manajemen Pengguna</h1>
            <p>@users.Count pengguna terdaftar.</p>
        </div>
        <BbButton OnClick="@(() => showCreateDialog = true)">
            <LucideIcon Name="plus" Class="h-4 w-4" />
            Tambah Pengguna
        </BbButton>
    </div>

    <div class="card">
        <div class="card-content" style="padding: 0">
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Nama</th>
                        <th>Email</th>
                        <th>Role</th>
                        <th>Area</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var user in users)
                    {
                        <tr>
                            <td class="font-medium">@user.FullName</td>
                            <td class="text-sm text-muted-foreground">@user.Email</td>
                            <td>
                                <BbBadge Variant="BadgeVariant.Secondary">@user.Role</BbBadge>
                            </td>
                            <td class="text-sm text-muted-foreground">@user.AreaName</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>
</div>

@if (showCreateDialog)
{
    <BbDialog Open="true" OnOpenChange="@(open => showCreateDialog = open)">
        <BbDialogContent Class="sm:max-w-md">
            <BbDialogHeader>
                <BbDialogTitle>Tambah Pengguna</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4">
                <div class="form-group">
                    <label class="form-label">Nama Lengkap</label>
                    <InputText class="form-control" @bind-Value="newFullName" />
                </div>
                <div class="form-group">
                    <label class="form-label">Email</label>
                    <InputText class="form-control" @bind-Value="newEmail" />
                </div>
                <div class="form-group">
                    <label class="form-label">Password</label>
                    <InputText type="password" class="form-control" @bind-Value="newPassword" />
                </div>
                <div class="form-group">
                    <label class="form-label">Role</label>
                    <select class="form-control" @bind="newRole">
                        @foreach (var role in SimandoRoles.All)
                        {
                            <option value="@role">@role</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Area</label>
                    <select class="form-control" @bind="newAreaId">
                        <option value="">Tanpa Area</option>
                        @foreach (var area in areas)
                        {
                            <option value="@area.Id">@area.Name</option>
                        }
                    </select>
                </div>
                <div class="flex gap-2 justify-end">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => showCreateDialog = false)">Batal</BbButton>
                    <BbButton OnClick="@CreateUser">Simpan</BbButton>
                </div>
            </div>
        </BbDialogContent>
    </BbDialog>
}
</AppShell>

@code {
    private List<UserInfo> users = [];
    private List<AreaDto> areas = [];
    private bool showCreateDialog;
    private string newFullName = "";
    private string newEmail = "";
    private string newPassword = "Passw0rd!";
    private string newRole = SimandoRoles.SalesArea;
    private string? newAreaId;

    protected override async Task OnInitializedAsync()
    {
        areas = await Subscriptions.GetAreasAsync();
        await LoadUsersAsync();
    }

    private async Task LoadUsersAsync()
    {
        users = await UserApi.GetUsersAsync();
    }

    private async Task CreateUser()
    {
        if (string.IsNullOrWhiteSpace(newEmail) || string.IsNullOrWhiteSpace(newFullName)) return;

        var (success, error) = await UserApi.CreateUserAsync(new CreateUserRequest
        {
            FullName = newFullName,
            Email = newEmail,
            Password = newPassword,
            Role = newRole,
            AreaId = string.IsNullOrEmpty(newAreaId) ? null : int.Parse(newAreaId)
        });

        if (success)
        {
            Toasts.Success($"Pengguna {newFullName} berhasil dibuat.");
            showCreateDialog = false;
            newFullName = "";
            newEmail = "";
            await LoadUsersAsync();
        }
        else
        {
            Toasts.Error(error ?? "Gagal membuat pengguna.");
        }
    }
}
