@page "/companies/{CompanyId:int}/nol-request/read"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IStageService Stages

<PageTitle>Permohonan NOL - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Permohonan NOL" Subtitle="Tampilan hanya-baca permohonan dan Lampiran 17." />

    @if (sub is null)
    {
        <EmptyState Title="Perusahaan tidak ditemukan" />
    }
    else if (nol is null)
    {
        <EmptyState Title="Permohonan belum diisi"
                    Description="Sales Area belum melengkapi permohonan NOL untuk perusahaan ini." />
    }
    else
    {
        <FormSection Title="@sub.CompanyName" Description="@sub.AreaName" Spaced="false">
            <div class="detail-row"><span class="detail-label">Status</span><span class="detail-value"><StatusBadge Status="@sub.Status" /></span></div>
            <div class="detail-row"><span class="detail-label">Nomor Nota Dinas</span><span class="detail-value">@Text(nol.NomorNotaDinas)</span></div>
            <div class="detail-row"><span class="detail-label">Jenis Registrasi</span><span class="detail-value">@Text(nol.RegistrationType?.ToString())</span></div>
            <div class="detail-row"><span class="detail-label">Pimpinan Perusahaan</span><span class="detail-value">@Text(nol.NamaPimpinanPerusahaan)</span></div>
            <div class="detail-row"><span class="detail-label">Jangka Waktu Kontrak</span><span class="detail-value">@Text(nol.JangkaWaktuKontrak)</span></div>
            <div class="detail-row"><span class="detail-label">Diajukan</span><span class="detail-value">@Text(nol.SubmittedAt?.ToString("d MMM yyyy HH:mm"))</span></div>
        </FormSection>

        <FormSection Title="Kontrak & Harga">
            <div class="detail-row"><span class="detail-label">Sama dengan A1</span><span class="detail-value">@(nol.SamaDenganA1 ? "Ya" : "Tidak")</span></div>
            <div class="detail-row"><span class="detail-label">Basis Kontrak</span><span class="detail-value">@Text(nol.BasisKontrak?.ToString())</span></div>
            <div class="detail-row"><span class="detail-label">Skema Harga</span><span class="detail-value">@Text(nol.SkemaHarga?.ToString())</span></div>
            <div class="detail-row"><span class="detail-label">Segment</span><span class="detail-value">@Text(nol.SegmentName)</span></div>
            <div class="detail-row"><span class="detail-label">Harga</span><span class="detail-value">@Text(nol.HargaNilai?.ToString("N2")) @nol.HargaCurrency / @nol.HargaUnit</span></div>
            @if (!string.IsNullOrWhiteSpace(nol.AlasanKontrakBersyarat))
            {
                <div class="detail-row"><span class="detail-label">Alasan Kontrak Bersyarat</span><span class="detail-value">@nol.AlasanKontrakBersyarat</span></div>
            }
        </FormSection>

        <FormSection Title="Biaya">
            <div class="detail-row"><span class="detail-label">Capex Pre GR3</span><span class="detail-value">@Text(nol.CapexPreGr3?.ToString("N0"))</span></div>
            <div class="detail-row"><span class="detail-label">Penyambungan Reguler</span><span class="detail-value">@Text(nol.BiayaPenyambunganReguler?.ToString("N0"))</span></div>
            <div class="detail-row"><span class="detail-label">Penyambungan Extra</span><span class="detail-value">@Text(nol.BiayaPenyambunganExtra?.ToString("N0"))</span></div>
            <div class="detail-row"><span class="detail-label">Jumlah</span><span class="detail-value">@nol.BiayaPenyambunganJumlah.ToString("N0")</span></div>
        </FormSection>

        @if (nol.Periods.Count > 0)
        {
            <FormSection Title="Volume Kontrak">
                <table class="data-table">
                    <thead><tr><th>Mulai</th><th>Selesai</th><th>Rata-rata</th><th>Minimum</th><th>Maksimum</th></tr></thead>
                    <tbody>
                        @foreach (var row in nol.Periods)
                        {
                            <tr>
                                <td>@(row.PeriodeMulai?.ToString("d MMM yyyy") ?? "—")</td>
                                <td>@(row.PeriodeSelesai?.ToString("d MMM yyyy") ?? "—")</td>
                                <td>@row.RataRata</td>
                                <td>@row.Minimum</td>
                                <td>@row.Maksimum</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </FormSection>
        }

        @if (!string.IsNullOrWhiteSpace(nol.Lampiran17))
        {
            <FormSection Title="Lampiran 17 — Evaluasi">
                <div class="detail-value" style="white-space: pre-wrap">@nol.Lampiran17</div>
            </FormSection>
        }

        @if (nol.References.Count > 0)
        {
            <FormSection Title="Dokumen Acuan">
                <table class="data-table">
                    <thead><tr><th>Judul</th><th>Nomor</th><th>Tanggal</th></tr></thead>
                    <tbody>
                        @foreach (var row in nol.References)
                        {
                            <tr>
                                <td>@row.Judul</td>
                                <td>@row.Nomor</td>
                                <td>@(row.Tanggal?.ToString("d MMM yyyy") ?? "—")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </FormSection>
        }
    }
</div>
</AppShell>

@code {
    [Parameter] public int CompanyId { get; set; }

    private SubscriptionDto? sub;
    private NolRequestDto? nol;

    protected override async Task OnParametersSetAsync()
    {
        sub = await Subscriptions.GetAsync(CompanyId);
        if (sub is not null) nol = await Stages.GetNolRequestAsync(CompanyId);
    }

    private static string Text(string? value) => string.IsNullOrWhiteSpace(value) ? "—" : value;
}
