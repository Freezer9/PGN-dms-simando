@page "/companies/{CompanyId:int}/evaluation"
@attribute [Authorize(Policy = SimandoPolicies.CanAccessEvaluation)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IEvaluationService EvaluationSvc
@inject IWorkflowService Workflow
@inject IMasterDataService MasterData
@inject IUserService UserApi
@inject ToastService Toasts

<PageTitle>Evaluasi Kelayakan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Evaluasi Kelayakan"
                Subtitle="FEED, capex final, pipe sizing, G-Size, IRR/NPV, dan penetapan reviewer.">
        <BbButton OnClick="@SaveAll" Disabled="@saving">
            @(saving ? "Menyimpan..." : "Simpan Evaluasi")
        </BbButton>
    </PageHeader>

    @if (sub is null)
    {
        <EmptyState Title="Perusahaan tidak ditemukan" />
    }
    else
    {
        <FormSection Title="@sub.CompanyName" Description="@sub.AreaName" Spaced="false">
            <div class="detail-row">
                <span class="detail-label">Status</span>
                <span class="detail-value"><StatusBadge Status="@sub.Status" /></span>
            </div>
            @if (detail.EvaluatedAt is not null)
            {
                <div class="detail-row">
                    <span class="detail-label">Terakhir dievaluasi</span>
                    <span class="detail-value">
                        @detail.EvaluatedByName — @detail.EvaluatedAt.Value.ToString("d MMM yyyy HH:mm")
                    </span>
                </div>
            }
        </FormSection>

        <FormSection Title="FEED">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Status FEED</label>
                    <select class="form-control" @bind="detail.FeedStatus">
                        <option value="">Pilih status</option>
                        <option value="@FeedStatus.Belum">Belum</option>
                        <option value="@FeedStatus.DalamProses">Dalam Proses</option>
                        <option value="@FeedStatus.Selesai">Selesai</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">FEED Selesai</label>
                    <input type="date" class="form-control" value="@DateValue(detail.FeedCompletedAt)"
                           @onchange="@(e => detail.FeedCompletedAt = ParseDate(e.Value))" />
                </div>
                <div class="form-group">
                    <label class="form-label">Durasi Pelaksanaan (bulan)</label>
                    <InputNumber class="form-control" @bind-Value="detail.DurasiPelaksanaanBulan" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Gate Review — Capex & Pipe Sizing">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Capex Final</label>
                    <InputNumber class="form-control" @bind-Value="detail.CapexFinal" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Induk — Panjang</label>
                    <InputNumber class="form-control" @bind-Value="detail.PipaIndukPanjang" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Induk — Diameter</label>
                    <InputNumber class="form-control" @bind-Value="detail.PipaIndukDiameter" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Induk — Satuan</label>
                    <select class="form-control" @bind="detail.PipaIndukUnit">
                        <option value="">Pilih</option>
                        <option value="@PipeUnit.Inch">inch</option>
                        <option value="@PipeUnit.Mm">mm</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Service — Panjang</label>
                    <InputNumber class="form-control" @bind-Value="detail.PipaServicePanjang" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Service — Diameter</label>
                    <InputNumber class="form-control" @bind-Value="detail.PipaServiceDiameter" />
                </div>
                <div class="form-group">
                    <label class="form-label">Pipa Service — Satuan</label>
                    <select class="form-control" @bind="detail.PipaServiceUnit">
                        <option value="">Pilih</option>
                        <option value="@PipeUnit.Inch">inch</option>
                        <option value="@PipeUnit.Mm">mm</option>
                    </select>
                </div>
            </div>
        </FormSection>

        <FormSection Title="Meter & MRS">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Spesifikasi MRS</label>
                    <select class="form-control" @bind="detail.MrsSpecId">
                        <option value="">Pilih spesifikasi</option>
                        @foreach (var spec in mrsSpecs)
                        {
                            <option value="@spec.Id">@spec.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">G-Size</label>
                    <select class="form-control" @bind="detail.MeterSizeId">
                        <option value="">Pilih G-Size</option>
                        @foreach (var size in meterSizes)
                        {
                            <option value="@size.Id">@size.Name</option>
                        }
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Tekanan</label>
                    <InputNumber class="form-control" @bind-Value="detail.Tekanan" />
                </div>
                <div class="form-group">
                    <label class="form-label">Maks. Flowrate</label>
                    <InputNumber class="form-control" @bind-Value="detail.MaksFlowrate" />
                </div>
                <div class="form-group">
                    <label class="form-label">Maks. Kapasitas Meter (m³/jam)</label>
                    <InputNumber class="form-control" @bind-Value="detail.MaksKapasitasMeterM3Jam" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Pasokan & Pembayaran">
            <div class="form-grid">
                <div class="form-group">
                    <label class="form-label">Ketersediaan Pasokan (BBTUD)</label>
                    <InputNumber class="form-control" @bind-Value="detail.KetersediaanPasokanBbtud" />
                </div>
                <div class="form-group">
                    <label class="form-label">Status RKAP</label>
                    <select class="form-control" @bind="detail.StatusRkap">
                        <option value="">Pilih</option>
                        <option value="@StatusRkap.Rkap">RKAP</option>
                        <option value="@StatusRkap.NonRkap">Non-RKAP</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Skema Pembayaran</label>
                    <select class="form-control" @bind="detail.SkemaPembayaran">
                        <option value="">Pilih</option>
                        <option value="@SkemaPembayaran.JaminanPembayaran">Jaminan Pembayaran</option>
                        <option value="@SkemaPembayaran.PembayaranDimuka">Pembayaran Dimuka</option>
                    </select>
                </div>
                <div class="form-group">
                    <label class="form-label">Jaminan — Status</label>
                    <InputText class="form-control" @bind-Value="detail.JaminanStatus" />
                </div>
                <div class="form-group">
                    <label class="form-label">Jaminan — Jenis</label>
                    <InputText class="form-control" @bind-Value="detail.JaminanJenis" />
                </div>
                <div class="form-group">
                    <label class="form-label">Jaminan — Penerbit</label>
                    <InputText class="form-control" @bind-Value="detail.JaminanPenerbit" />
                </div>
                <div class="form-group">
                    <label class="form-label">Jaminan — Masa Berlaku</label>
                    <input type="date" class="form-control" value="@DateValue(detail.JaminanMasaBerlaku)"
                           @onchange="@(e => detail.JaminanMasaBerlaku = ParseDate(e.Value))" />
                </div>
            </div>
        </FormSection>

        <FormSection Title="Kelayakan Finansial">
            <RepeatingRows TItem="NolEvaluationScenarioDto" Items="detail.Scenarios"
                           ItemFactory="@(() => new NolEvaluationScenarioDto())"
                           AddLabel="Tambah Skenario" EmptyDescription="Belum ada skenario kelayakan.">
                <HeaderTemplate>
                    <th>Skenario</th>
                    <th>IRR (%)</th>
                    <th>NPV</th>
                    <th>Payback (tahun)</th>
                    <th>Hasil Analisis</th>
                </HeaderTemplate>
                <RowTemplate Context="row">
                    <td><InputText class="form-control" @bind-Value="row.Label" /></td>
                    <td><InputNumber class="form-control" @bind-Value="row.IrrPct" /></td>
                    <td><InputNumber class="form-control" @bind-Value="row.Npv" /></td>
                    <td><InputNumber class="form-control" @bind-Value="row.PaybackYears" /></td>
                    <td><InputText class="form-control" @bind-Value="row.HasilAnalisis" /></td>
                </RowTemplate>
            </RepeatingRows>
        </FormSection>

        <FormSection Title="Analisis">
            <div class="form-group">
                <label class="form-label">Analisis Komersial</label>
                <textarea class="form-control" rows="4" @bind="detail.AnalisisKomersial"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Analisis Kompetitor</label>
                <textarea class="form-control" rows="4" @bind="detail.AnalisisKompetitor"></textarea>
            </div>
            <div class="form-group">
                <label class="form-label">Radius Kompetitor (km)</label>
                <InputNumber class="form-control" @bind-Value="detail.RadiusKompetitorKm" />
            </div>
            <div class="form-group">
                <label class="form-label">Kesimpulan</label>
                <textarea class="form-control" rows="4" @bind="detail.Kesimpulan"></textarea>
            </div>
        </FormSection>

        <FormSection Title="Resume Evaluasi"
                     Description="Narasi yang menjadi isi dokumen Resume Evaluasi.">
            <div class="form-group">
                <textarea class="form-control" rows="10" @bind="resumeContent"
                          placeholder="Tulis resume evaluasi dan analisis kelayakan..."></textarea>
            </div>
        </FormSection>

        <FormSection Title="Tetapkan Reviewer" Description="Pilih 2–3 reviewer untuk kasus ini.">
            @if (reviewers.Count == 0)
            {
                <EmptyState Title="Belum ada reviewer" Description="Tambahkan pengguna dengan role Reviewer terlebih dahulu." />
            }
            else
            {
                @foreach (var reviewer in reviewers)
                {
                    <label class="flex gap-2 items-center">
                        <input type="checkbox" checked="@selectedReviewers.Contains(reviewer.Id)"
                               @onchange="@(e => ToggleReviewer(reviewer.Id, (bool)(e.Value ?? false)))" />
                        <span>@reviewer.FullName</span>
                    </label>
                }
                <div class="flex gap-2 items-center">
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@AssignReviewers"
                              Disabled="@(assigning || selectedReviewers.Count == 0)">
                        @(assigning ? "Menetapkan..." : "Tetapkan Reviewer")
                    </BbButton>
                    <span class="text-sm text-muted-foreground">@selectedReviewers.Count dipilih</span>
                </div>
            }
        </FormSection>

        <div class="flex gap-2" style="margin-top: 1rem">
            <BbButton OnClick="@SaveAll" Disabled="@saving">
                @(saving ? "Menyimpan..." : "Simpan Evaluasi")
            </BbButton>
            <a href="/companies/@CompanyId" class="btn btn-outline">Kembali ke Record</a>
        </div>
    }
</div>
</AppShell>

@code {
    [Parameter] public int CompanyId { get; set; }

    private SubscriptionDto? sub;
    private NolEvaluationDto detail = new();
    private string resumeContent = "";
    private List<MasterDataEntryDto> mrsSpecs = [];
    private List<MasterDataEntryDto> meterSizes = [];
    private List<UserInfo> reviewers = [];
    private readonly HashSet<string> selectedReviewers = [];
    private bool saving;
    private bool assigning;

    protected override async Task OnParametersSetAsync()
    {
        sub = await Subscriptions.GetAsync(CompanyId);
        if (sub is null) return;

        detail = await EvaluationSvc.GetDetailAsync(CompanyId)
            ?? new NolEvaluationDto { SubscriptionId = CompanyId };
        resumeContent = (await EvaluationSvc.GetAsync(CompanyId))?.Content ?? "";

        mrsSpecs = await MasterData.GetAsync(MasterCategory.MrsSpec);
        meterSizes = await MasterData.GetAsync(MasterCategory.MeterSize);

        try { reviewers = (await UserApi.GetUsersAsync()).Where(u => u.Role == SimandoRoles.Reviewer).ToList(); }
        catch { reviewers = []; }

        selectedReviewers.Clear();
        foreach (var id in sub.ReviewerIds.Split(',', StringSplitOptions.RemoveEmptyEntries))
            selectedReviewers.Add(id.Trim());
    }

    private void ToggleReviewer(string userId, bool selected)
    {
        if (selected) selectedReviewers.Add(userId); else selectedReviewers.Remove(userId);
    }

    private static string DateValue(DateTime? value) => value?.ToString("yyyy-MM-dd") ?? "";

    private static DateTime? ParseDate(object? value)
        => DateTime.TryParse(value?.ToString(), out var parsed) ? parsed : null;

    // Structured detail and the narrative resume live in separate tables; save both together
    // so the page has one obvious Save.
    private async Task SaveAll()
    {
        if (sub is null) return;
        saving = true;
        try
        {
            detail = await EvaluationSvc.SaveDetailAsync(CompanyId, detail);
            await EvaluationSvc.SaveAsync(CompanyId, resumeContent);
            Toasts.Success("Evaluasi tersimpan.");
        }
        catch
        {
            Toasts.Error("Gagal menyimpan evaluasi.");
        }
        finally { saving = false; }
    }

    private async Task AssignReviewers()
    {
        if (sub is null) return;
        assigning = true;
        try
        {
            await Workflow.AssignReviewersAsync(sub.Id, [.. selectedReviewers]);
            Toasts.Success($"{selectedReviewers.Count} reviewer ditetapkan.");
            sub = await Subscriptions.GetAsync(CompanyId);
        }
        catch
        {
            Toasts.Error("Gagal menetapkan reviewer.");
        }
        finally { assigning = false; }
    }
}
