@page "/tasks/blocked"
@attribute [Authorize(Policy = SimandoPolicies.CanManageTasksBlocked)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Tugas Tertahan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Tugas Tertahan"
                Subtitle="@($"{blocked.Count} permohonan ditolak atau langkah terhambat di region Anda.")" />

    <DataTable TItem="SubscriptionDto" Items="blocked" Loading="loading"
               EmptyIcon="check-circle" EmptyTitle="Tidak ada tugas tertahan"
               EmptyDescription="Semua permohonan berjalan normal.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Update</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Kelola</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> blocked = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        var all = await Subscriptions.GetAllAsync();
        blocked = all.Where(s => s.Status == SubscriptionStatus.Ditolak).ToList();
        loading = false;
    }
}
