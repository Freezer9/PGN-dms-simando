@page "/tasks/history"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject IActivityService Activity

<PageTitle>Riwayat Tindakan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Riwayat Tindakan" Subtitle="Log tindakan persetujuan yang pernah dilakukan." />

    <div class="card">
        <div class="card-content">
            @if (loading)
            {
                <EmptyState Title="Memuat..." />
            }
            else if (activities.Count == 0)
            {
                <EmptyState Title="Belum ada riwayat" />
            }
            else
            {
                <div class="timeline">
                    @foreach (var entry in activities)
                    {
                        <div class="timeline-item">
                            <div class="timeline-item-title">@entry.ActorName &mdash; @entry.Action</div>
                            <div class="timeline-item-time">@entry.At.ToString("d MMM yyyy HH:mm")</div>
                            @if (!string.IsNullOrEmpty(entry.Details))
                            {
                                <div class="timeline-item-desc">@entry.Details</div>
                            }
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>
</AppShell>

@code {
    private List<ActivityLogDto> activities = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        activities = await Activity.GetRecentAsync(50);
        loading = false;
    }
}
