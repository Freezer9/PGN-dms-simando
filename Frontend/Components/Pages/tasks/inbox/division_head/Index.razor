@page "/tasks/division"
@attribute [Authorize(Policy = SimandoPolicies.CanApprove)]
@rendermode InteractiveServer
@inject IWorkflowService Workflow

<PageTitle>Tugas Saya - Division Head - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Tugas Saya"
                Subtitle="@($"{pending.Count} permohonan menunggu penerbitan NOL/RL.")" />

    <DataTable TItem="SubscriptionDto" Items="pending" Loading="loading"
               EmptyIcon="check-circle" EmptyTitle="Tidak ada antrean"
               EmptyDescription="Semua penerbitan sudah selesai.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Update</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            <td><a href="/companies/@sub.Id" class="btn btn-sm btn-outline">Terbitkan</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> pending = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        pending = await Workflow.GetPendingReviewAsync();
        loading = false;
    }
}
