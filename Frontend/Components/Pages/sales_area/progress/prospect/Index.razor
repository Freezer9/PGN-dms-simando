@page "/sales-area/progress/prospect"
@attribute [Authorize(Policy = SimandoPolicies.IsSalesArea)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IStageService Stages

@* Stage 3: survey plan. Each row drills into the per-company PIC form. *@

<PageTitle>Prospect - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Prospect"
                Subtitle="Rencana survey — minimal 1 kontak PIC diperlukan sebelum tahap Survei." />

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan..." />

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="users" EmptyTitle="Belum ada rencana survey"
               EmptyDescription="Perusahaan muncul di sini setelah plotting lengkap.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Kontak PIC</th>
            <th>Kontak Utama</th>
            <th>Status</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{
                var list = ContactsFor(sub.Id);
                var primary = list.FirstOrDefault(c => c.IsPrimary) ?? list.FirstOrDefault();
            }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="font-medium @(list.Count == 0 ? "text-danger" : "")">@list.Count</td>
            <td class="text-sm text-muted-foreground">
                @(primary is null ? "—" : $"{primary.Nama} ({primary.Jabatan})")
            </td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td>
                <a href="/companies/@sub.Id/prospect" class="btn btn-sm btn-outline">
                    @(list.Count == 0 ? "Tambah PIC" : "Kelola")
                </a>
            </td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private readonly Dictionary<int, List<CompanyContactDto>> contacts = [];
    private string searchQuery = "";
    private bool loading = true;

    private List<SubscriptionDto> filtered => companies
        .Where(c => SubscriptionStages.IsAtOrAfter(c.Status, SubscriptionStatus.Prospect))
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(c => c.UpdatedAt)
        .ToList();

    private List<CompanyContactDto> ContactsFor(int id)
        => contacts.TryGetValue(id, out var list) ? list : [];

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();

        foreach (var c in filtered)
            contacts[c.Id] = await Stages.GetContactsAsync(c.Id);

        loading = false;
    }
}
