@page "/sales-area/progress/survey"
@attribute [Authorize(Policy = SimandoPolicies.IsSalesArea)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions
@inject IStageService Stages

@* Stage 4: input hasil survey aktual. Each row drills into the KK0 form. *@

<PageTitle>Survey - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Survey"
                Subtitle="Input hasil survei lapangan (KK0) dan unggah dokumen bertanda tangan." />

    <div class="stats-grid">
        <StatTile Icon="clipboard-list" Label="Perlu Disurvei" Value="@filtered.Count.ToString()" />
        <StatTile Icon="edit" Label="Form Terisi" Value="@filledCount.ToString()" />
        <StatTile Icon="file-check" Label="KK0 Terunggah" Value="@signedCount.ToString()" />
    </div>

    <FilterBar @bind-SearchValue="searchQuery" Placeholder="Cari perusahaan..." />

    <DataTable TItem="SubscriptionDto" Items="filtered" Loading="loading"
               EmptyIcon="clipboard-list" EmptyTitle="Belum ada survei"
               EmptyDescription="Perusahaan muncul di sini setelah tahap Prospek.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Tanggal Survei</th>
            <th>Form KK0</th>
            <th>Dokumen Bertanda Tangan</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var survey = SurveyFor(sub.Id); }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">
                @(survey?.TanggalSurvey?.ToString("d MMM yyyy") ?? "—")
            </td>
            <td>
                <span class="badge @(survey is null ? "badge-pending" : "badge-approved")">
                    @(survey is null ? "Belum diisi" : "Terisi")
                </span>
            </td>
            <td>
                <span class="badge @(HasSigned(sub) ? "badge-approved" : "badge-pending")">
                    @(HasSigned(sub) ? "Terunggah" : "Belum")
                </span>
            </td>
            <td><a href="/companies/@sub.Id/survey" class="btn btn-sm btn-outline">Isi Survei</a></td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> companies = [];
    private readonly Dictionary<int, SurveyDto> surveys = [];
    private string searchQuery = "";
    private bool loading = true;

    private List<SubscriptionDto> filtered => companies
        .Where(c => SubscriptionStages.IsAtOrAfter(c.Status, SubscriptionStatus.Survey))
        .Where(c => string.IsNullOrWhiteSpace(searchQuery)
            || c.CompanyName.Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
        .OrderByDescending(c => c.UpdatedAt)
        .ToList();

    private int filledCount => filtered.Count(c => surveys.ContainsKey(c.Id));
    private int signedCount => filtered.Count(HasSigned);

    private SurveyDto? SurveyFor(int id) => surveys.TryGetValue(id, out var s) ? s : null;

    private static bool HasSigned(SubscriptionDto sub)
        => sub.Submissions.Any(s => s.Stage == SubscriptionStatus.Survey);

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        companies = await Subscriptions.GetAllAsync();

        foreach (var c in filtered)
        {
            var survey = await Stages.GetSurveyAsync(c.Id);
            if (survey is not null) surveys[c.Id] = survey;
        }

        loading = false;
    }
}
