@page "/reviewer/qa-qc/inbox"
@attribute [Authorize(Policy = SimandoPolicies.IsReviewer)]
@rendermode InteractiveServer
@inject IWorkflowService Workflow
@inject IActivityService Activity

@* New documents from Region Sales, plus revisions bounced back from Sales. *@

<PageTitle>Inbox - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Inbox"
                Subtitle="@($"{assigned.Count} dokumen baru dan balikan revisi untuk Anda.")" />

    <DataTable TItem="SubscriptionDto" Items="assigned" Loading="loading"
               EmptyIcon="inbox" EmptyTitle="Kotak masuk kosong"
               EmptyDescription="Belum ada dokumen baru yang ditugaskan ke Anda.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Sales</th>
            <th>Status</th>
            <th>Masuk Sejak</th>
            <th></th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var waiting = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(waiting > 3 ? "text-danger" : "")">@waiting hari</td>
            <td><a href="/reviewer/qa-qc/review" class="btn btn-sm btn-outline">Buka Review</a></td>
        </RowTemplate>
    </DataTable>

    <FormSection Title="Notifikasi Terbaru">
        @if (activity.Count == 0)
        {
            <EmptyState Title="Belum ada notifikasi" />
        }
        else
        {
            <div class="timeline">
                @foreach (var entry in activity)
                {
                    <div class="timeline-item">
                        <div class="timeline-item-title">@entry.ActorName @entry.Action</div>
                        <div class="timeline-item-time">@entry.At.ToString("d MMM yyyy HH:mm")</div>
                        @if (!string.IsNullOrEmpty(entry.Details))
                        {
                            <div class="timeline-item-desc">@entry.Details</div>
                        }
                    </div>
                }
            </div>
        }
    </FormSection>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> assigned = [];
    private List<ActivityLogDto> activity = [];
    private bool loading = true;

    protected override async Task OnInitializedAsync()
    {
        loading = true;
        assigned = await Workflow.GetPendingReviewAsync();
        activity = await Activity.GetRecentAsync(15);
        loading = false;
    }
}
