@page "/reports/nol-results"
@attribute [Authorize(Policy = SimandoPolicies.CanApprove)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Hasil NOL/RL - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Hasil NOL/RL" Subtitle="Rekapitulasi hasil penerbitan." />

    <div class="stats-grid">
        <StatTile Icon="check-circle" Label="NOL Diterbitkan"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Disetujui).ToString()" />
        <StatTile Icon="x-circle" Label="RL Diterbitkan"
                  Value="@allSubscriptions.Count(s => s.Status == SubscriptionStatus.Ditolak).ToString()" />
    </div>

    <div style="margin-top: 1rem">
        <DataTable TItem="SubscriptionDto" Items="issued"
                   EmptyDescription="Belum ada penerbitan.">
            <HeaderTemplate>
                <th>Perusahaan</th>
                <th>Area</th>
                <th>Status</th>
                <th>Update</th>
            </HeaderTemplate>
            <RowTemplate Context="sub">
                <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
                <td class="text-sm text-muted-foreground">@sub.AreaName</td>
                <td><StatusBadge Status="@sub.Status" /></td>
                <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
            </RowTemplate>
        </DataTable>
    </div>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];

    private List<SubscriptionDto> issued => allSubscriptions
        .Where(s => SubscriptionStages.IsTerminal(s.Status))
        .OrderByDescending(s => s.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync() { allSubscriptions = await Subscriptions.GetAllAsync(); }
}
