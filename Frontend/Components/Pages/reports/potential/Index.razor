@page "/reports/potential"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Potensi Kebutuhan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Potensi Kebutuhan" Subtitle="Estimasi kebutuhan gas berdasarkan data survei." />

    <DataTable TItem="SubscriptionDto" Items="surveyed"
               EmptyDescription="Belum ada perusahaan yang mencapai tahap Survei.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Status</th>
            <th>Update</th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];

    private List<SubscriptionDto> surveyed => allSubscriptions
        .Where(s => SubscriptionStages.IsAtOrAfter(s.Status, SubscriptionStatus.Survey))
        .OrderByDescending(s => s.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync() { allSubscriptions = await Subscriptions.GetAllAsync(); }
}
