@page "/reports/ageing"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Laporan Penuaan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <PageHeader Title="Penuaan" Subtitle="Analisis umur permohonan per tahap persetujuan." />

    <DataTable TItem="SubscriptionDto" Items="ageing"
               EmptyDescription="Tidak ada permohonan yang masih berjalan.">
        <HeaderTemplate>
            <th>Perusahaan</th>
            <th>Area</th>
            <th>Status</th>
            <th>Umur (hari)</th>
            <th>Update terakhir</th>
        </HeaderTemplate>
        <RowTemplate Context="sub">
            @{ var age = (DateTime.UtcNow - sub.UpdatedAt).Days; }
            <td><a href="/companies/@sub.Id" class="font-medium">@sub.CompanyName</a></td>
            <td class="text-sm text-muted-foreground">@sub.AreaName</td>
            <td><StatusBadge Status="@sub.Status" /></td>
            <td class="font-medium @(age > 30 ? "text-danger" : "")">@age hari</td>
            <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
        </RowTemplate>
    </DataTable>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> allSubscriptions = [];

    // Closed records have stopped ageing.
    private List<SubscriptionDto> ageing => allSubscriptions
        .Where(s => !SubscriptionStages.IsTerminal(s.Status))
        .OrderBy(s => s.UpdatedAt)
        .ToList();

    protected override async Task OnInitializedAsync() { allSubscriptions = await Subscriptions.GetAllAsync(); }
}
