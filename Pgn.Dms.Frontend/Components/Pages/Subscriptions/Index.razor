@page "/subscriptions"
@attribute [Authorize(Policy = SimandoPolicies.CanViewSubscriptions)]
@rendermode InteractiveServer
@inject ISubscriptionService Subscriptions

<PageTitle>Berlangganan - SIMANDO</PageTitle>

<AppShell>
<div class="space-y-4 page-content">
    <div class="page-header">
        <div>
            <h1>Berlangganan</h1>
            <p>@subscriptions.Count data berlangganan</p>
        </div>
    </div>

    <div class="flex gap-2 flex-wrap">
        <select class="form-control" style="width: auto" @bind="filterStatus">
            <option value="">Semua Status</option>
            @foreach (var status in Enum.GetValues<SubscriptionStatus>())
            {
                <option value="@status">@status</option>
            }
        </select>
        <select class="form-control" style="width: auto" @bind="filterArea">
            <option value="">Semua Area</option>
            @foreach (var area in areas)
            {
                <option value="@area.Id">@area.Name</option>
            }
        </select>
    </div>

    <div class="card">
        <div class="card-content" style="padding: 0">
            @if (filtered.Count == 0)
            {
                <div class="empty-state">
                    <div class="empty-state-title">Tidak ada data</div>
                </div>
            }
            else
            {
                <table class="data-table">
                    <thead>
                        <tr>
                            <th>Perusahaan</th>
                            <th>Alamat</th>
                            <th>Area</th>
                            <th>Status</th>
                            <th>Sales</th>
                            <th>Update</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var sub in filtered)
                        {
                            <tr>
                                <td>
                                    <a href="/subscriptions/@sub.Id" class="font-medium">@sub.CompanyName</a>
                                </td>
                                <td class="text-sm text-muted-foreground" style="max-width: 12rem">
                                    <span class="truncate block">@sub.Address</span>
                                </td>
                                <td class="text-sm">@sub.AreaName</td>
                                <td><StatusBadge Status="@sub.Status" /></td>
                                <td class="text-sm text-muted-foreground">@sub.CreatedByName</td>
                                <td class="text-sm text-muted-foreground">@sub.UpdatedAt.ToString("d MMM yyyy")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            }
        </div>
    </div>
</div>
</AppShell>

@code {
    private List<SubscriptionDto> subscriptions = [];
    private List<AreaDto> areas = [];
    private string filterStatus = "";
    private string filterArea = "";

    private List<SubscriptionDto> filtered => subscriptions
        .Where(s => string.IsNullOrEmpty(filterStatus) || s.Status.ToString() == filterStatus)
        .Where(s => string.IsNullOrEmpty(filterArea) || s.AreaId.ToString() == filterArea)
        .ToList();

    protected override async Task OnInitializedAsync()
    {
        areas = (await Subscriptions.GetAreasAsync()).ToList();
        subscriptions = (await Subscriptions.GetAllAsync()).ToList();
    }
}
