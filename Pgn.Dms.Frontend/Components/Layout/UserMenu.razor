<AuthorizeView>
    <Authorized>
        <BbDropdownMenu>
            <BbDropdownMenuTrigger>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Icon" AriaLabel="Account menu" Class="rounded-full">
                    <BbAvatar Size="AvatarSize.Small">
                        <BbAvatarFallback>@CurrentUser.Initials(context.User)</BbAvatarFallback>
                    </BbAvatar>
                </BbButton>
            </BbDropdownMenuTrigger>
            <BbDropdownMenuContent Align="PopoverAlign.End" Class="w-56">
                <BbDropdownMenuLabel>
                    <div class="flex flex-col">
                        <span class="text-sm font-medium">@CurrentUser.DisplayName(context.User)</span>
                        <span class="text-xs font-normal text-muted-foreground">@context.User.Identity?.Name</span>
                    </div>
                </BbDropdownMenuLabel>
                <div class="px-2 pb-1.5">
                    <BbBadge Variant="BadgeVariant.Secondary">@CurrentUser.PrimaryRole(context.User)</BbBadge>
                </div>
                <BbDropdownMenuSeparator />
                <form method="post" action="Account/Logout" class="px-1 py-0.5">
                    <AntiforgeryToken />
                    <input type="hidden" name="ReturnUrl" value="" />
                    <button type="submit"
                            class="relative flex w-full cursor-pointer select-none items-center gap-2 rounded-sm px-2 py-1.5 text-sm outline-none transition-colors hover:bg-accent hover:text-accent-foreground">
                        <LucideIcon Name="log-out" Class="h-4 w-4" />
                        Keluar
                    </button>
                </form>
            </BbDropdownMenuContent>
        </BbDropdownMenu>
    </Authorized>
    <NotAuthorized>
        <BbButton Href="/Account/Login" Size="ButtonSize.Small">Masuk</BbButton>
    </NotAuthorized>
</AuthorizeView>
