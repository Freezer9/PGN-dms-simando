<BbSidebarProvider DefaultOpen="true" Variant="SidebarVariant.Inset">
    <AppSidebar />

    <BbSidebarInset>
        <header class="app-header">
            <BbSidebarTrigger />
            <AppBreadcrumb />
            <AppHeaderActions />
        </header>

        <main class="flex-1 p-4 md:p-6">
            @ChildContent
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

@code {
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
