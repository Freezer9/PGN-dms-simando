@inherits LayoutComponentBase

<div class="auth-split">
    <div class="auth-info">
        <div class="auth-info-content">
            <div class="auth-brand">
                <div class="auth-logo">
                    <LucideIcon Name="flame" Class="h-6 w-6" />
                </div>
                <h1 class="auth-title">SIMANDO</h1>
            </div>
            <p class="auth-subtitle">Sistem Manajemen Dokumen<br />Proses Berlangganan Gas</p>

            <div class="auth-features">
                <div class="auth-feature">
                    <LucideIcon Name="file-text" Class="h-4 w-4" />
                    <div>
                        <strong>Kelola Dokumen</strong>
                        <span>Upload, review, dan approval dokumen berlangganan dalam satu platform.</span>
                    </div>
                </div>
                <div class="auth-feature">
                    <LucideIcon Name="workflow" Class="h-4 w-4" />
                    <div>
                        <strong>Workflow Terstruktur</strong>
                        <span>Alur approval berjenjang dari Directory hingga Permohonan NOL.</span>
                    </div>
                </div>
                <div class="auth-feature">
                    <LucideIcon Name="clipboard-check" Class="h-4 w-4" />
                    <div>
                        <strong>Monitoring Progress</strong>
                        <span>Pantau status dan progress setiap proses berlangganan secara real-time.</span>
                    </div>
                </div>
            </div>
        </div>
    </div>
    <div class="auth-form-side">
        @Body
    </div>
</div>
