@inject NavigationManager Navigation

<div class="simando-sidebar">
<BbSidebar>
    <BbSidebarHeader>
        <BbSidebarHeaderContent>
            <div class="flex size-8 shrink-0 items-center justify-center rounded-lg bg-primary text-primary-foreground">
                <LucideIcon Name="flame" Class="h-4 w-4" />
            </div>
            <BbSidebarHeaderInfo>
                <span class="truncate font-semibold">SIMANDO</span>
                <span class="truncate text-xs text-muted-foreground">Manajemen Berlangganan Gas</span>
            </BbSidebarHeaderInfo>
        </BbSidebarHeaderContent>
    </BbSidebarHeader>

    <BbSidebarContent>
        <BbSidebarGroup>
            <BbSidebarGroupLabel>Menu</BbSidebarGroupLabel>
            <BbSidebarGroupContent>
                <BbSidebarMenu>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/" Match="NavLinkMatch.All" Tooltip="Dashboard">
                            <LucideIcon Name="layout-dashboard" />
                            <span>Dashboard</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>
                    <BbSidebarMenuItem>
                        <BbSidebarMenuButton Href="/subscriptions" Tooltip="Daftar berlangganan">
                            <LucideIcon Name="file-text" />
                            <span>Berlangganan</span>
                        </BbSidebarMenuButton>
                    </BbSidebarMenuItem>

                    <AuthorizeView Policy="@SimandoPolicies.CanReview">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/review" Tooltip="Antrian review">
                                <LucideIcon Name="clipboard-check" />
                                <span>Review</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>

                    <AuthorizeView Policy="@SimandoPolicies.CanAccessEvaluation">
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/evaluation" Tooltip="Resume evaluasi">
                                <LucideIcon Name="file-check" />
                                <span>Evaluasi</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </AuthorizeView>
                </BbSidebarMenu>
            </BbSidebarGroupContent>
        </BbSidebarGroup>

        <AuthorizeView Policy="@SimandoPolicies.CanAdminister">
            <BbSidebarGroup>
                <BbSidebarGroupLabel>Admin</BbSidebarGroupLabel>
                <BbSidebarGroupContent>
                    <BbSidebarMenu>
                        <BbSidebarMenuItem>
                            <BbSidebarMenuButton Href="/admin/users" Tooltip="Manajemen pengguna">
                                <LucideIcon Name="shield-user" />
                                <span>Pengguna</span>
                            </BbSidebarMenuButton>
                        </BbSidebarMenuItem>
                    </BbSidebarMenu>
                </BbSidebarGroupContent>
            </BbSidebarGroup>
        </AuthorizeView>
    </BbSidebarContent>

    <BbSidebarRail />
</BbSidebar>
</div>
