<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>Pgn.Dms.Web</AssemblyName>
    <RootNamespace>Pgn.Dms.Web</RootNamespace>
    <BlazorDisableThrowNavigationException>true</BlazorDisableThrowNavigationException>
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="Styles\**" />
    <None Include="Styles\**" />
    <Content Remove="package.json;package-lock.json" />
    <None Include="package.json;package-lock.json" />
    <Content Remove="node_modules\**" />
    <None Remove="node_modules\**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Pgn.Dms.Shared\Pgn.Dms.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BlazorBlueprint.Components" Version="3.14.1" />
    <PackageReference Include="BlazorBlueprint.Icons.Lucide" Version="2.0.2" />
  </ItemGroup>

</Project>
