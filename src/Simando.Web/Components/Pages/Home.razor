@page "/"
@using Simando.Application.Dashboard
@using Simando.Domain.Security
@using Simando.Infrastructure.Persistence
@using Simando.Web.Components.Pages.Dashboard
@using Simando.Web.Security
@inject CurrentUser CurrentUser
@inject SimandoDbContext Db
@inject IDashboardService DashboardService
@inject BreadcrumbState BreadcrumbState

<PageTitle>Beranda - DMS Simando</PageTitle>

@if (_loading)
{
    <p class="text-sm text-muted-foreground">Memuat beranda…</p>
}
else
{
    @if (CurrentUser.Roles.Contains(Role.SystemAdmin))
    {
        @if (_sysAdminData is not null)
        {
            <SystemAdminDashboard Data="@_sysAdminData" />
        }
    }
    else if (CurrentUser.Roles.Contains(Role.RegionalAdmin))
    {
        @if (_regAdminData is not null)
        {
            <RegionalAdminDashboard Data="@_regAdminData" RegionName="@(_regionName)" />
        }
    }
    else if (CurrentUser.Roles.Overlaps(ApproverRoles))
    {
        @if (_approverData is not null)
        {
            <ApproverDashboard Data="@_approverData" RoleLabel="@(_primaryRoleLabel)" ScopeLabel="@(_primaryScopeLabel)" />
        }
    }
    else
    {
        @if (_salesAreaData is not null)
        {
            <SalesAreaDashboard Data="@_salesAreaData" AreaName="@(_areaName)" />
        }
    }
}

@code {
    private static readonly IReadOnlySet<Role> ApproverRoles =
        new HashSet<Role> { Role.AreaHead, Role.Reviewer, Role.DivisionHead };

    private bool _loading = true;

    private SalesAreaDashboardDto? _salesAreaData;
    private ApproverDashboardDto? _approverData;
    private RegionalAdminDashboardDto? _regAdminData;
    private SystemAdminDashboardDto? _sysAdminData;

    private string _areaName = "Area";
    private string _regionName = "Region";
    private string _primaryRoleLabel = "Approver";
    private string _primaryScopeLabel = "Scope";

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.LoadAsync(Db);
        BreadcrumbState.Set(new BreadcrumbItem("Beranda", null));

        if (CurrentUser.Roles.Contains(Role.SystemAdmin))
        {
            _sysAdminData = await DashboardService.GetSystemAdminDashboardAsync();
        }
        else if (CurrentUser.Roles.Contains(Role.RegionalAdmin))
        {
            var regionId = CurrentUser.RegionId ?? Guid.Empty;
            _regionName = CurrentUser.RoleAssignments.FirstOrDefault()?.ScopeLabel ?? "Regional";
            _regAdminData = await DashboardService.GetRegionalAdminDashboardAsync(regionId, CurrentUser.Permissions);
        }
        else if (CurrentUser.Roles.Overlaps(ApproverRoles))
        {
            var assignment = CurrentUser.RoleAssignments.FirstOrDefault();
            _primaryRoleLabel = assignment?.RoleLabel ?? "Approver";
            _primaryScopeLabel = assignment?.ScopeLabel ?? "Scope";
            _approverData = await DashboardService.GetApproverDashboardAsync(CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);
        }
        else
        {
            var areaId = CurrentUser.AreaId ?? Guid.Empty;
            _areaName = CurrentUser.RoleAssignments.FirstOrDefault()?.ScopeLabel ?? "Area";
            _salesAreaData = await DashboardService.GetSalesAreaDashboardAsync(areaId);
        }

        _loading = false;
    }
}
