@using System.ComponentModel.DataAnnotations
@using Microsoft.AspNetCore.Components.Forms
@using Simando.Application.Attachments
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.MasterData
@using Simando.Application.Nol
@using Simando.Domain.Attachments
@using Simando.Domain.MasterData
@using Simando.Domain.Nol
@using Simando.Domain.Registration
@using Simando.Domain.Security
@inject ICompanyService CompanyService
@inject IAttachmentService AttachmentService
@inject IEntityService<Segment> SegmentService
@inject ToastService ToastService

@if (_detail is null && _loading)
{
    <p class="text-sm text-muted-foreground">Memuat Permohonan NOL…</p>
}
else
{
    <div class="space-y-4">
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Permohonan NOL (Lampiran 15)</BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="space-y-4">
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <BbFormFieldInput TValue="string" @bind-Value="_form.NomorNotaDinas" Label="Nomor Nota Dinas *" Disabled="@(!CanEdit)" />
                        <BbFormFieldSelect TValue="RegistrationType" @bind-Value="_form.RegistrationType" Label="Jenis Registrasi *" Options="_regTypeOptions" Disabled="@(!CanEdit)" />
                        <div class="pt-6">
                            <BbFormFieldCheckbox @bind-Checked="_form.SamaDenganA1" Label="Ketentuan sama dengan A1" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <BbFormFieldInput TValue="string" @bind-Value="_form.NamaPimpinanPerusahaan" Label="Nama Pimpinan Perusahaan *" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="string" @bind-Value="_form.JangkaWaktuKontrak" Label="Jangka Waktu Kontrak *" Disabled="@(!CanEdit)" />
                    </div>

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <BbFormFieldSelect TValue="BasisKontrak?" @bind-Value="_form.BasisKontrak" Label="Basis Kontrak *" Placeholder="Pilih basis" Options="_basisKontrakOptions" Disabled="@(!CanEdit)" />
                        <BbFormFieldSelect TValue="SkemaHarga?" @bind-Value="_form.SkemaHarga" Label="Skema Harga *" Placeholder="Pilih skema" Options="_skemaHargaOptions" Disabled="@(!CanEdit)" />
                        <BbFormFieldSelect TValue="Guid?" @bind-Value="_form.SegmentId" Label="Segment *" Placeholder="Pilih segment" Options="_segmentOptions" Disabled="@(!CanEdit)" />
                    </div>

                    @if (_form.SkemaHarga == SkemaHarga.Bersyarat)
                    {
                        <BbFormFieldTextarea @bind-Value="_form.AlasanKontrakBersyarat" Label="Alasan Kontrak Bersyarat *" Disabled="@(!CanEdit)" />
                    }

                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_form.CapexPreGr3" Label="Capex Pre-GR3 (Rp)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_form.BiayaReguler" Label="Biaya Penyambungan Reguler" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_form.BiayaExtra" Label="Biaya Penyambungan Extra" Type="InputType.Number" Disabled="@(!CanEdit)" />
                    </div>

                    <div class="p-3 bg-muted/40 rounded-md">
                        <p class="text-sm font-medium">Total Biaya Penyambungan: <span class="text-primary font-bold">@(((_form.BiayaReguler ?? 0) + (_form.BiayaExtra ?? 0)).ToString("N0"))</span></p>
                    </div>

                    <!-- Dokumen Capex Pre-GR3 (Syarat Gate Pengajuan Approval) -->
                    <div class="pt-4 border-t space-y-3">
                        <div class="flex items-center gap-2">
                            <LucideIcon Name="shield-check" Class="size-4 text-primary" />
                            <h4 class="text-xs font-semibold uppercase tracking-wider text-muted-foreground">Dokumen Pendukung Permohonan NOL &amp; Syarat Pengajuan Approval</h4>
                        </div>

                        <div class="p-3 rounded-lg border bg-muted/20 space-y-2">
                            <div class="flex items-center justify-between gap-2">
                                <div class="flex items-center gap-2">
                                    <LucideIcon Name="file-text" Class="size-4 text-primary shrink-0" />
                                    <div>
                                        <span class="text-xs font-semibold text-foreground">Dokumen Capex Pre-GR3 *</span>
                                        <p class="text-[11px] text-muted-foreground">Berkas perhitungan biaya Capex Pre-GR3.</p>
                                    </div>
                                </div>
                                @if (_capexAttachment is not null)
                                {
                                    <BbBadge Variant="BadgeVariant.Default" Class="text-xs px-2 py-0.5 bg-emerald-600">
                                        <LucideIcon Name="circle-check" Class="size-3 mr-1 inline" /> Terunggah
                                    </BbBadge>
                                }
                                else
                                {
                                    <BbBadge Variant="BadgeVariant.Outline" Class="text-xs px-2 py-0.5 text-amber-600 border-amber-500/40">
                                        Wajib
                                    </BbBadge>
                                }
                            </div>
                            @if (_capexAttachment is not null)
                            {
                                <div class="text-xs text-muted-foreground flex items-center justify-between pt-1">
                                    <span>@_capexAttachment.Filename (@(_capexAttachment.SizeBytes / 1024) KB)</span>
                                    <a href="/api/attachments/@_capexAttachment.Id/download" target="_blank" class="text-primary hover:underline font-medium">Unduh</a>
                                </div>
                            }
                            @if (CanEdit)
                            {
                                <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-2 pt-1">
                                    <InputFile OnChange="OnCapexFileSelected" class="block w-full text-xs text-foreground file:mr-2 file:py-1 file:px-2.5 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-primary-foreground" />
                                    <BbButton Size="ButtonSize.Small" OnClick="UploadCapexAsync" Disabled="@(_selectedCapexFile is null || _uploadingCapex)" Class="shrink-0">
                                        <LucideIcon Name="upload" Class="size-3 mr-1" /> Unggah Capex
                                    </BbButton>
                                </div>
                            }
                        </div>
                    </div>

                    @if (CanEdit)
                    {
                        <div class="flex justify-end pt-4">
                            <BbButton Type="ButtonType.Submit" Disabled="@_saving">@(_saving ? "Menyimpan…" : "Simpan Permohonan NOL")</BbButton>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        </EditForm>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public Guid ActorUserId { get; set; }
    [Parameter] public EffectivePermissions Actor { get; set; } = null!;

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Nomor Nota Dinas wajib diisi")]
        public string? NomorNotaDinas { get; set; }

        [Required(ErrorMessage = "Jenis Registrasi wajib dipilih")]
        public RegistrationType RegistrationType { get; set; } = RegistrationType.RegistrasiBaru;

        public bool SamaDenganA1 { get; set; }

        [Required(ErrorMessage = "Nama Pimpinan Perusahaan wajib diisi")]
        public string? NamaPimpinanPerusahaan { get; set; }

        [Required(ErrorMessage = "Jangka Waktu Kontrak wajib diisi")]
        public string? JangkaWaktuKontrak { get; set; }

        [Required(ErrorMessage = "Basis Kontrak wajib dipilih")]
        public BasisKontrak? BasisKontrak { get; set; }

        [Required(ErrorMessage = "Skema Harga wajib dipilih")]
        public SkemaHarga? SkemaHarga { get; set; }

        [Required(ErrorMessage = "Segment wajib dipilih")]
        public Guid? SegmentId { get; set; }

        public string? AlasanKontrakBersyarat { get; set; }
        public decimal? CapexPreGr3 { get; set; }
        public decimal? BiayaReguler { get; set; }
        public decimal? BiayaExtra { get; set; }
    }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private NolRequestDetail? _detail;
    private FormModel _form = new();

    private List<SelectOption<RegistrationType>> _regTypeOptions =
    [
        new(RegistrationType.RegistrasiBaru, "Registrasi Baru"),
        new(RegistrationType.Amendemen, "Amendemen"),
        new(RegistrationType.Perpanjangan, "Perpanjangan"),
    ];

    private List<SelectOption<BasisKontrak?>> _basisKontrakOptions =
    [
        new(BasisKontrak.Harian, "Harian"),
        new(BasisKontrak.Bulanan, "Bulanan"),
        new(BasisKontrak.Tahunan, "Tahunan"),
    ];

    private List<SelectOption<SkemaHarga?>> _skemaHargaOptions =
    [
        new(SkemaHarga.Reguler, "Reguler"),
        new(SkemaHarga.Sigas, "SiGas"),
        new(SkemaHarga.Bersyarat, "Bersyarat"),
    ];

    private List<SelectOption<Guid?>> _segmentOptions = [];

    protected override async Task OnInitializedAsync()
    {
        var segments = await SegmentService.GetAllAsync();
        _segmentOptions = segments.Select(s => new SelectOption<Guid?>((Guid?)s.Id, s.Name)).ToList();

        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _detail = await CompanyService.GetNolRequestAsync(CompanyId);
        if (_detail is not null)
        {
            _form.NomorNotaDinas = _detail.NomorNotaDinas;
            _form.RegistrationType = _detail.RegistrationType;
            _form.SamaDenganA1 = _detail.SamaDenganA1;
            _form.NamaPimpinanPerusahaan = _detail.NamaPimpinanPerusahaan;
            _form.JangkaWaktuKontrak = _detail.JangkaWaktuKontrak;
            _form.BasisKontrak = _detail.BasisKontrak;
            _form.SkemaHarga = _detail.SkemaHarga;
            _form.SegmentId = _detail.SegmentId;
            _form.AlasanKontrakBersyarat = _detail.AlasanKontrakBersyarat;
            _form.CapexPreGr3 = _detail.CapexPreGr3;
            _form.BiayaReguler = _detail.BiayaPenyambunganReguler;
            _form.BiayaExtra = _detail.BiayaPenyambunganExtra;
        }

        var attachments = await AttachmentService.GetCompanyAttachmentsAsync(CompanyId);
        _capexAttachment = attachments.FirstOrDefault(a => a.Kind == AttachmentKind.CapexPreGr3);

        _loading = false;
    }

    private AttachmentDetail? _capexAttachment;
    private IBrowserFile? _selectedCapexFile;
    private bool _uploadingCapex;

    private void OnCapexFileSelected(InputFileChangeEventArgs e)
    {
        _selectedCapexFile = e.File;
        _error = null;
    }

    private async Task UploadCapexAsync()
    {
        if (_selectedCapexFile is null) return;
        _uploadingCapex = true;
        _error = null;

        try
        {
            await using var stream = _selectedCapexFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var req = new UploadAttachmentRequest(
                AttachmentKind.CapexPreGr3,
                _selectedCapexFile.Name,
                _selectedCapexFile.ContentType ?? "application/octet-stream",
                _selectedCapexFile.Size,
                null,
                stream);

            var result = await AttachmentService.UploadAttachmentAsync(CompanyId, req, ActorUserId);
            if (result.Succeeded)
            {
                _selectedCapexFile = null;
                await LoadDataAsync();
                ToastService.Success("Dokumen Capex Pre-GR3 berhasil diunggah.", "Tersimpan");
            }
            else
            {
                _error = result.Error;
                ToastService.Error(result.Error ?? "Gagal mengunggah dokumen Capex Pre-GR3.", "Gagal");
            }
        }
        catch (Exception ex)
        {
            _error = ex.Message;
            ToastService.Error($"Gagal mengunggah berkas: {ex.Message}", "Gagal");
        }
        finally
        {
            _uploadingCapex = false;
        }
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        var req = new SaveNolRequestRequest(
            _form.NomorNotaDinas,
            _form.RegistrationType,
            _form.SamaDenganA1,
            _detail?.BulanDimulai,
            _form.BasisKontrak,
            _form.SkemaHarga,
            _form.SegmentId,
            _detail?.KodeHarga,
            _detail?.HargaNilai,
            _detail?.HargaCurrency,
            _detail?.HargaUnit,
            _form.AlasanKontrakBersyarat,
            _form.NamaPimpinanPerusahaan,
            _form.JangkaWaktuKontrak,
            _form.CapexPreGr3,
            _form.BiayaReguler,
            _form.BiayaExtra,
            _detail?.Periods ?? [],
            _detail?.DailyBasisRows ?? [],
            _detail?.ReferenceDocumentIds ?? []);

        var result = await CompanyService.SaveNolRequestAsync(CompanyId, req, ActorUserId, Actor);
        if (result.Succeeded)
        {
            await LoadDataAsync();
            ToastService.Success("Data Permohonan NOL berhasil disimpan.", "Tersimpan");
        }
        else
        {
            _error = result.Error;
            ToastService.Error(result.Error ?? "Gagal menyimpan Permohonan NOL.", "Gagal");
        }

        _saving = false;
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
