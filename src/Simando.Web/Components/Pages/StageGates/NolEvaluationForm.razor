@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.Nol
@using Simando.Domain.Nol
@using Simando.Domain.Security
@inject ICompanyService CompanyService
@inject ToastService ToastService

@if (_detail is null && _loading)
{
    <p class="text-sm text-muted-foreground">Memuat Evaluasi NOL…</p>
}
else
{
    <div class="space-y-4">
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Resume Evaluasi (Lampiran 17)</BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="space-y-6">
                    <!-- Section 1: Checkpoint FEED & Capex -->
                    <div>
                        <BbSectionHeader Title="1. Status FEED & Capex Final" />
                        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                            <BbFormFieldSelect TValue="FeedStatus" @bind-Value="_form.FeedStatus" Label="Status FEED *" Options="_feedStatusOptions" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.CapexFinal" Label="Capex Final (Rp)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    <!-- Section 2: Infrastruktur Pipa -->
                    <div>
                        <BbSectionHeader Title="2. Spesifikasi Pipa Induk & Service" />
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.PipaIndukPanjangM" Label="Pipa Induk Panjang (m)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.PipaIndukDiameter" Label="Pipa Induk Diameter" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldSelect TValue="DiameterUnit?" @bind-Value="_form.PipaIndukDiameterUnit" Label="Satuan Diameter" Placeholder="Pilih unit" Options="_unitOptions" Disabled="@(!CanEdit)" />
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.PipaServicePanjangM" Label="Pipa Service Panjang (m)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.PipaServiceDiameter" Label="Pipa Service Diameter" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldSelect TValue="DiameterUnit?" @bind-Value="_form.PipaServiceDiameterUnit" Label="Satuan Diameter" Placeholder="Pilih unit" Options="_unitOptions" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    <!-- Section 3: Meter & MRS -->
                    <div>
                        <BbSectionHeader Title="3. Metering & Spesifikasi MRS" />
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <BbFormFieldInput TValue="string" @bind-Value="_form.SpesifikasiMrs" Label="Spesifikasi MRS" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="string" @bind-Value="_form.GSize" Label="G-Size" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.Tekanan" Label="Tekanan Operasi (barg)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        </div>
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 mt-3">
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.MaksFlowrate" Label="Maks. Flowrate (m³/jam)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.MaksKapasitasMeterM3Jam" Label="Maks. Kapasitas Meter (m³/jam)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="short?" @bind-Value="_form.DurasiPelaksanaanBulan" Label="Durasi Pelaksanaan (Bulan)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    <!-- Section 4: Komersial & Pasokan -->
                    <div>
                        <BbSectionHeader Title="4. Ketentuan Komersial & Pasokan" />
                        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                            <BbFormFieldSelect TValue="StatusRkap?" @bind-Value="_form.StatusRkap" Label="Status RKAP" Placeholder="Pilih status" Options="_rkapOptions" Disabled="@(!CanEdit)" />
                            <BbFormFieldSelect TValue="SkemaPembayaran?" @bind-Value="_form.SkemaPembayaran" Label="Skema Pembayaran" Placeholder="Pilih skema" Options="_skemaPembayaranOptions" Disabled="@(!CanEdit)" />
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_form.KetersediaanPasokanBbtud" Label="Ketersediaan Pasokan (BBTUD)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    <!-- Section 5: Analisis & Kesimpulan -->
                    <div>
                        <BbSectionHeader Title="5. Analisis Kelayakan & Catatan" />
                        <div class="space-y-3">
                            <BbFormFieldTextarea @bind-Value="_form.AnalisisKomersial" Label="Analisis Komersial" Disabled="@(!CanEdit)" />
                            <BbFormFieldTextarea @bind-Value="_form.AnalisisKompetitor" Label="Analisis Kompetitor" Disabled="@(!CanEdit)" />
                            <BbFormFieldTextarea @bind-Value="_form.Kesimpulan" Label="Kesimpulan *" Disabled="@(!CanEdit)" />
                        </div>
                    </div>

                    @if (CanEdit)
                    {
                        <div class="flex justify-end pt-4">
                            <BbButton Type="ButtonType.Submit" Disabled="@_saving">@(_saving ? "Menyimpan…" : "Simpan Evaluasi")</BbButton>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        </EditForm>
    </div>
}

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public bool CanEdit { get; set; }
    [Parameter] public Guid ActorUserId { get; set; }
    [Parameter] public EffectivePermissions Actor { get; set; } = null!;

    private sealed class FormModel
    {
        [Required(ErrorMessage = "Status FEED wajib dipilih")]
        public FeedStatus FeedStatus { get; set; } = FeedStatus.Belum;

        public decimal? CapexFinal { get; set; }
        public decimal? PipaIndukPanjangM { get; set; }
        public decimal? PipaIndukDiameter { get; set; }
        public DiameterUnit? PipaIndukDiameterUnit { get; set; }
        public decimal? PipaServicePanjangM { get; set; }
        public decimal? PipaServiceDiameter { get; set; }
        public DiameterUnit? PipaServiceDiameterUnit { get; set; }
        public string? SpesifikasiMrs { get; set; }
        public string? GSize { get; set; }
        public decimal? Tekanan { get; set; }
        public decimal? MaksFlowrate { get; set; }
        public decimal? MaksKapasitasMeterM3Jam { get; set; }
        public short? DurasiPelaksanaanBulan { get; set; }
        public StatusRkap? StatusRkap { get; set; }
        public SkemaPembayaran? SkemaPembayaran { get; set; }
        public decimal? KetersediaanPasokanBbtud { get; set; }
        public string? AnalisisKomersial { get; set; }
        public string? AnalisisKompetitor { get; set; }

        [Required(ErrorMessage = "Kesimpulan wajib diisi")]
        public string? Kesimpulan { get; set; }
    }

    private bool _loading = true;
    private bool _saving;
    private string? _error;
    private NolEvaluationDetail? _detail;
    private FormModel _form = new();

    private List<SelectOption<FeedStatus>> _feedStatusOptions =
    [
        new(FeedStatus.Belum, "Belum"),
        new(FeedStatus.DalamProses, "Dalam Proses"),
        new(FeedStatus.Selesai, "Selesai"),
    ];

    private List<SelectOption<DiameterUnit?>> _unitOptions =
    [
        new(DiameterUnit.Inch, "Inch"),
        new(DiameterUnit.Mm, "mm"),
    ];

    private List<SelectOption<StatusRkap?>> _rkapOptions =
    [
        new(StatusRkap.Rkap, "RKAP"),
        new(StatusRkap.NonRkap, "Non-RKAP"),
    ];

    private List<SelectOption<SkemaPembayaran?>> _skemaPembayaranOptions =
    [
        new(SkemaPembayaran.JaminanPembayaran, "Jaminan Pembayaran"),
        new(SkemaPembayaran.PembayaranDimuka, "Pembayaran Dimuka"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _detail = await CompanyService.GetNolEvaluationAsync(CompanyId);
        if (_detail is not null)
        {
            _form.FeedStatus = _detail.FeedStatus;
            _form.CapexFinal = _detail.CapexFinal;
            _form.PipaIndukPanjangM = _detail.PipaIndukPanjangM;
            _form.PipaIndukDiameter = _detail.PipaIndukDiameter;
            _form.PipaIndukDiameterUnit = _detail.PipaIndukDiameterUnit;
            _form.PipaServicePanjangM = _detail.PipaServicePanjangM;
            _form.PipaServiceDiameter = _detail.PipaServiceDiameter;
            _form.PipaServiceDiameterUnit = _detail.PipaServiceDiameterUnit;
            _form.SpesifikasiMrs = _detail.SpesifikasiMrs;
            _form.GSize = _detail.GSize;
            _form.Tekanan = _detail.Tekanan;
            _form.MaksFlowrate = _detail.MaksFlowrate;
            _form.MaksKapasitasMeterM3Jam = _detail.MaksKapasitasMeterM3Jam;
            _form.DurasiPelaksanaanBulan = _detail.DurasiPelaksanaanBulan;
            _form.StatusRkap = _detail.StatusRkap;
            _form.SkemaPembayaran = _detail.SkemaPembayaran;
            _form.KetersediaanPasokanBbtud = _detail.KetersediaanPasokanBbtud;
            _form.AnalisisKomersial = _detail.AnalisisKomersial;
            _form.AnalisisKompetitor = _detail.AnalisisKompetitor;
            _form.Kesimpulan = _detail.Kesimpulan;
        }
        _loading = false;
    }

    private async Task SaveAsync()
    {
        _saving = true;
        _error = null;

        var req = new SaveNolEvaluationRequest(
            _form.FeedStatus,
            _detail?.FeedCompletedAt,
            _form.CapexFinal,
            _form.PipaIndukPanjangM,
            _form.PipaIndukDiameter,
            _form.PipaIndukDiameterUnit,
            _form.PipaServicePanjangM,
            _form.PipaServiceDiameter,
            _form.PipaServiceDiameterUnit,
            _form.SpesifikasiMrs,
            _form.GSize,
            _form.Tekanan,
            _form.MaksFlowrate,
            _form.MaksKapasitasMeterM3Jam,
            _form.DurasiPelaksanaanBulan,
            _form.StatusRkap,
            _form.SkemaPembayaran,
            _detail?.JaminanStatus,
            _detail?.JaminanJenis,
            _detail?.JaminanMasaBerlaku,
            _detail?.JaminanPenerbit,
            _form.KetersediaanPasokanBbtud,
            _form.AnalisisKomersial,
            _form.AnalisisKompetitor,
            _form.Kesimpulan,
            _detail?.RadiusKompetitorKm,
            _detail?.Scenarios ?? []);

        var result = await CompanyService.SaveNolEvaluationAsync(CompanyId, req, ActorUserId, Actor);
        if (result.Succeeded)
        {
            await LoadDataAsync();
            ToastService.Success("Resume Evaluasi berhasil disimpan.", "Tersimpan");
        }
        else
        {
            _error = result.Error;
            ToastService.Error(result.Error ?? "Gagal menyimpan Resume Evaluasi.", "Gagal");
        }

        _saving = false;
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
