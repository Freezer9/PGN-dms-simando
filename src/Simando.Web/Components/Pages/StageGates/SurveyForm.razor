                        <BbTableCell Class="text-left">@(_fuelTypes.FirstOrDefault(f => f.Value == row.FuelTypeId)?.Text ?? "-")</BbTableCell>
                        <BbTableCell Class="text-right">@(row.KonsumsiPerBulan?.ToString("N0") ?? "-") @(_fuelConsumptionUnits.FirstOrDefault(u => u.Value == row.KonsumsiUnitId)?.Text)</BbTableCell>
                        <BbTableCell Class="text-right font-mono font-semibold">
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded bg-emerald-50 text-emerald-800 border border-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-300 text-xs">
                                @row.KonversiKeGas.ToString("N2") MMBTU
                            </span>
                        </BbTableCell>
                        @if (CanEdit)
                        {
                            <BbTableCell Class="text-center">
                                <div class="flex items-center justify-center gap-1">
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => StartEditEquipment(row))" AriaLabel="Ubah">
                                                <LucideIcon Name="pencil" Class="size-3.5" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => DeleteEquipmentAsync(row.Id))" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30">
                                                <LucideIcon Name="trash-2" Class="size-3.5" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Hapus</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </BbTableCell>
                        }
                    </BbTableRow>
                }
            </BbTableBody>
        </BbTable>
        </div>
        @if (CanEdit)
        {
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="StartAddEquipment">
                <LucideIcon Name="plus" Class="size-4 mr-1" /> Tambah Peralatan
            </BbButton>
