                    <BbTableHeaderCell TData="SurveyEquipmentDetail" Class="w-1/6 min-w-[170px] text-right">Kapasitas</BbTableHeaderCell>
                    <BbTableHeaderCell TData="SurveyEquipmentDetail" Class="w-1/6 min-w-[150px] text-center">Pola Operasi</BbTableHeaderCell>
