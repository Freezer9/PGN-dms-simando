        <BbDialog @bind-Open="_equipmentDialogOpen">
            <BbDialogContent Class="max-w-lg">
                <EditForm Model="_equipmentForm" OnValidSubmit="SaveEquipmentRowAsync" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />
                    <BbDialogHeader>
                        <BbDialogTitle>@(_editingEquipmentId is null ? "Tambah Peralatan" : "Ubah Peralatan")</BbDialogTitle>
                    </BbDialogHeader>
                    <div class="py-4 space-y-3">
                        <BbFormFieldInput TValue="string" @bind-Value="_equipmentForm.JenisPeralatan" Label="Jenis Peralatan *" Placeholder="Contoh: Boiler, Burner, Kiln" />
                        <div class="grid grid-cols-2 gap-4">
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_equipmentForm.Kapasitas" Label="Kapasitas" Type="InputType.Number" Class="w-full" InputClass="w-full" />
                            <BbFormFieldCombobox TValue="Guid?"
                                                 @bind-Value="_equipmentForm.KapasitasUnitId"
                                                 Label="Satuan Kapasitas"
