@using BlazorBlueprint.Primitives.Table
@using BlazorBlueprint.Icons.Lucide
@using Microsoft.AspNetCore.Components.Forms
@using Simando.Application.Attachments
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.MasterData
@using Simando.Application.Security
@using Simando.Domain.Attachments
@using Simando.Domain.MasterData
@using Simando.Domain.Registration
@using Simando.Domain.Security
@using Simando.Domain.Survey
@inject ICompanyService CompanyService
@inject IAttachmentService AttachmentService
@inject IUnitLookupService UnitLookupService
@inject IEntityService<Country> CountryService
@inject IEntityService<FuelType> FuelTypeService
@inject ToastService ToastService

@if (_detail is null)
{
    <p class="text-sm text-muted-foreground">Memuat…</p>
}
else
{
    <div class="grid grid-cols-1 lg:grid-cols-[180px_1fr] gap-6">
        <nav class="hidden lg:flex flex-col gap-1 text-sm sticky top-20 self-start">
            @foreach (var navItem in Sections)
            {
                <a href="@($"/companies/{CompanyId}/survei#survei-{navItem.Id}")" class="px-2 py-1 rounded hover:bg-muted text-muted-foreground hover:text-foreground">@navItem.Title</a>
            }
        </nav>

        <div class="space-y-4 min-w-0">
            @if (_headerError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@_headerError</BbAlertDescription>
                </BbAlert>
            }

            <!-- Floating Live Energy Demand Summary Bar (Proposal 03) -->
            <div class="sticky top-16 z-20 p-3.5 rounded-lg border border-primary/30 bg-background/95 backdrop-blur-sm shadow-xs flex flex-col sm:flex-row sm:items-center sm:justify-between gap-3">
                <div class="flex items-center gap-3">
                    <div class="p-2 rounded-md bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300 shrink-0">
                        <LucideIcon Name="flame" Class="size-5" />
                    </div>
                    <div>
                        <div class="text-[11px] text-muted-foreground font-semibold uppercase tracking-wide">Total Kebutuhan Energi (MMBTU/Bulan)</div>
                        <div class="text-lg font-bold text-foreground">
                            @TotalJumlahKebutuhanEnergi.ToString("N2") <span class="text-xs font-semibold text-primary">MMBTU</span>
                            <span class="text-xs font-normal text-muted-foreground ml-2">(@_equipment.Count Unit Peralatan)</span>
                        </div>
                    </div>
                </div>
                <div class="flex items-center gap-4 text-xs border-t sm:border-t-0 sm:border-l pt-2 sm:pt-0 sm:pl-4 border-border shrink-0">
                    <div>
                        <span class="text-muted-foreground block text-[11px]">Jarak Pipa:</span>
                        <span class="font-semibold text-foreground">@(_pipaTerdekatJarakM.HasValue ? $"{_pipaTerdekatJarakM:N0} m" : "-")</span>
                    </div>
                    <div>
                        <span class="text-muted-foreground block text-[11px]">Diameter:</span>
                        <span class="font-semibold text-foreground">@(_pipaTerdekatDiameter.HasValue ? $"{_pipaTerdekatDiameter} in" : "-")</span>
                    </div>
                    <div>
                        <span class="text-muted-foreground block text-[11px]">Tekanan:</span>
                        <span class="font-semibold text-foreground">@(_pipaTerdekatTekanan.HasValue ? $"{_pipaTerdekatTekanan} barg" : "-")</span>
                    </div>
                </div>
            </div>

            <!-- Dokumen KK0 Ber-TTD (Signed KK0) Card -->
            <BbCard Class="border-emerald-500/30 bg-emerald-50/20 dark:bg-emerald-950/10">
                <BbCardHeader Class="pb-2">
                    <div class="flex items-center justify-between gap-2 flex-wrap">
                        <div class="flex items-center gap-2">
                            <div class="p-1.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-900/50 dark:text-emerald-300">
                                <LucideIcon Name="file-check-2" Class="size-4" />
                            </div>
                            <div>
                                <BbCardTitle Class="text-sm font-semibold">Dokumen KK0 Ber-TTD (Signed KK0)</BbCardTitle>
                                <p class="text-xs text-muted-foreground">Unggah berkas KK0 yang telah ditandatangani untuk pemenuhan syarat registrasi Form A1.</p>
                            </div>
                        </div>
                        @if (_kk0Attachment is not null)
                        {
                            <BbBadge Variant="BadgeVariant.Default" Class="text-xs px-2 py-0.5 bg-emerald-600 hover:bg-emerald-700">
                                <LucideIcon Name="circle-check" Class="size-3 mr-1 inline" /> Terunggah (v@_kk0Attachment.Version)
                            </BbBadge>
                        }
                        else
                        {
                            <BbBadge Variant="BadgeVariant.Outline" Class="text-xs px-2 py-0.5 text-amber-600 border-amber-500/40">
                                Belum Ada Berkas
                            </BbBadge>
                        }
                    </div>
                </BbCardHeader>
                <BbCardContent Class="space-y-3">
                    @if (_kk0Attachment is not null)
                    {
                        <div class="flex items-center justify-between p-2.5 rounded border bg-background text-xs">
                            <div class="flex items-center gap-2 min-w-0">
                                <LucideIcon Name="file-text" Class="size-4 text-emerald-600 shrink-0" />
                                <span class="font-medium truncate">@_kk0Attachment.Filename</span>
                                <span class="text-muted-foreground text-[11px]">(@(_kk0Attachment.SizeBytes / 1024) KB)</span>
                                <span class="text-muted-foreground text-[11px]">· @_kk0Attachment.UploadedAt.ToLocalTime().ToString("dd/MM/yyyy HH:mm")</span>
                            </div>
                            <a href="/api/attachments/@_kk0Attachment.Id/download" target="_blank" class="text-primary hover:underline text-xs font-semibold shrink-0">
                                Unduh
                            </a>
                        </div>
                    }

                    @if (CanEdit)
                    {
                        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3 pt-1">
                            <div class="flex-1 min-w-0">
                                <InputFile OnChange="OnKk0FileSelected" class="block w-full text-xs text-foreground file:mr-3 file:py-1.5 file:px-3 file:rounded-md file:border-0 file:text-xs file:font-semibold file:bg-primary file:text-primary-foreground hover:file:bg-primary/90" />
                            </div>
                            <div class="w-44 shrink-0">
                                <BbFormFieldSelect TValue="SignatureMethod?" @bind-Value="_kk0SigMethod" Placeholder="Metode TTD" Options="_sigMethodOptions" Class="text-xs" />
                            </div>
                            <BbButton Size="ButtonSize.Small" OnClick="UploadKk0Async" Disabled="@(_selectedKk0File is null || _uploadingKk0)" Class="shrink-0">
                                <LucideIcon Name="upload" Class="size-3.5 mr-1" />
                                @(_uploadingKk0 ? "Mengunggah…" : "Unggah KK0")
                            </BbButton>
                        </div>
                        @if (_kk0UploadError is not null)
                        {
                            <p class="text-xs text-destructive mt-1">@_kk0UploadError</p>
                        }
                    }
                </BbCardContent>
            </BbCard>

            <div id="survei-operasional" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Operasional</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                        <BbFormFieldInput TValue="int?" @bind-Value="_jumlahKaryawan" Label="Jumlah Karyawan" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="short?" @bind-Value="_jumlahShift" Label="Jumlah Shift (1–3)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_jamKerjaPerHari" Label="Jam Kerja / Hari" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="short?" @bind-Value="_hariPerMinggu" Label="Hari / Minggu" Type="InputType.Number" Disabled="@(!CanEdit)" />
                    </div>
                    <div class="mt-4 border-t pt-3 space-y-2">
                        <span class="text-xs font-semibold text-muted-foreground uppercase">Beban Puncak (Peak Load Windows)</span>
                        <div class="grid grid-cols-1 sm:grid-cols-4 gap-4">
                            <BbFormFieldInput TValue="TimeOnly?" @bind-Value="_bebanPuncak1Mulai" Label="Window 1 Mulai" Type="InputType.Time" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                            <BbFormFieldInput TValue="TimeOnly?" @bind-Value="_bebanPuncak1Selesai" Label="Window 1 Selesai" Type="InputType.Time" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                            <BbFormFieldInput TValue="TimeOnly?" @bind-Value="_bebanPuncak2Mulai" Label="Window 2 Mulai" Type="InputType.Time" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                            <BbFormFieldInput TValue="TimeOnly?" @bind-Value="_bebanPuncak2Selesai" Label="Window 2 Selesai" Type="InputType.Time" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                        </div>
                    </div>
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-produk" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Produk Utama</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    @RenderProductTable()
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-bahan-baku" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Bahan Baku</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    @RenderRawMaterialTable()
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-pasar" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Orientasi Pasar</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    @RenderMarketTable()
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-energi" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Kebutuhan Energi</BbCardTitle></BbCardHeader>
                <BbCardContent class="space-y-4">
                    <BbFormFieldCheckboxGroup TValue="KebutuhanEnergiJenis" @bind-Values="_kebutuhanEnergiSelected" Label="Jenis kebutuhan energi" Disabled="@(!CanEdit)">
                        @foreach (var jenis in Enum.GetValues<KebutuhanEnergiJenis>())
                        {
                            <BbCheckboxGroupItem TValue="KebutuhanEnergiJenis" Value="jenis" Label="@SurveyLabels.KebutuhanEnergiLabel(jenis)" />
                        }
                    </BbFormFieldCheckboxGroup>
                    @if (_kebutuhanEnergiSelected.Contains(KebutuhanEnergiJenis.Lainnya))
                    {
                        <BbFormFieldInput TValue="string" @bind-Value="_kebutuhanEnergiLainnya" Label="Jenis Lainnya" Disabled="@(!CanEdit)" />
                    }
                    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_kapasitasNilai" Label="Kapasitas" Type="InputType.Number" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                        <BbFormFieldSelect TValue="Guid?" @bind-Value="_kapasitasUnitId" Label="Satuan Kapasitas" Placeholder="Pilih satuan" Options="_capacityUnits" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_pemakaianNilai" Label="Pemakaian" Type="InputType.Number" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                        <BbFormFieldSelect TValue="Guid?" @bind-Value="_pemakaianUnitId" Label="Satuan Pemakaian" Placeholder="Pilih satuan" Options="_energyUsageUnits" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                    </div>
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-peralatan" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Perincian Bahan Bakar yang Dipakai Saat Ini</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    @RenderEquipmentTable()
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-pipa" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Pipa Gas Terdekat</BbCardTitle></BbCardHeader>
                <BbCardContent>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_pipaTerdekatJarakM" Label="Jarak (meter)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_pipaTerdekatDiameter" Label="Diameter (inch)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_pipaTerdekatTekanan" Label="Tekanan (barg)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                    </div>
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-bahan-bakar" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Bahan Bakar Eksisting &amp; Listrik</BbCardTitle></BbCardHeader>
                <BbCardContent class="space-y-4">
                    <BbFormFieldCheckboxGroup TValue="BahanBakarEksisting" @bind-Values="_bahanBakarSelected" Label="Bahan Bakar Eksisting" Disabled="@(!CanEdit)">
                        @foreach (var bahanBakar in Enum.GetValues<BahanBakarEksisting>())
                        {
                            <BbCheckboxGroupItem TValue="BahanBakarEksisting" Value="bahanBakar" Label="@SurveyLabels.BahanBakarLabel(bahanBakar)" />
                        }
                    </BbFormFieldCheckboxGroup>
                    <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                        <BbFormFieldInput TValue="string" @bind-Value="_namaPemasok" Label="Nama Pemasok" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_kapasitasListrikKw" Label="Kapasitas Listrik (kW)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_pemakaianListrikKwh" Label="Pemakaian Listrik (kWh)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                    </div>
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-rencana" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader><BbCardTitle>Rencana Pemanfaatan Gas &amp; Lainnya</BbCardTitle></BbCardHeader>
                <BbCardContent class="space-y-4">
                    <BbFormFieldCheckboxGroup TValue="RencanaPemanfaatanGas" @bind-Values="_rencanaSelected" Label="Rencana Pemanfaatan Gas" Disabled="@(!CanEdit)">
                        @foreach (var rencana in Enum.GetValues<RencanaPemanfaatanGas>())
                        {
                            <BbCheckboxGroupItem TValue="RencanaPemanfaatanGas" Value="rencana" Label="@SurveyLabels.RencanaPemanfaatanGasLabel(rencana)" />
                        }
                    </BbFormFieldCheckboxGroup>
                    <BbFormFieldTextarea @bind-Value="_deskripsiProsesProduksi" Label="Deskripsi Proses Produksi" Disabled="@(!CanEdit)" />
                    <BbFormFieldInput TValue="decimal?" @bind-Value="_minEfisiensiDiharapkanPct" Label="Minimum Efisiensi yang Diharapkan (%)" Type="InputType.Number" Disabled="@(!CanEdit)" />
                    <BbFormFieldTextarea @bind-Value="_keteranganLain" Label="Keterangan Lain" Disabled="@(!CanEdit)" />
                </BbCardContent>
            </BbCard>
            </div>

            <div id="survei-surveyor" class="scroll-mt-40">
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Informasi Surveyor &amp; Evaluasi</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                        <BbFormFieldDatePicker @bind-Value="_tanggalSurvey" Label="Tanggal Survei *" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                        <BbFormFieldCombobox TValue="Guid?"
                                             @bind-Value="_surveyorUserId"
                                             Label="Surveyor *"
                                             Required="true"
                                             Options="Surveyors"
                                             Disabled="@(!CanEdit)"
                                             Placeholder="Pilih surveyor"
                                             SearchPlaceholder="Cari surveyor..."
                                             EmptyMessage="Tidak ada surveyor"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        <BbFormFieldInput TValue="decimal?" @bind-Value="_willingnessToPayUsdMmbtu" Label="Willingness To Pay (USD/MMBtu)" Type="InputType.Number" Disabled="@(!CanEdit)" Class="w-full" InputClass="w-full" />
                    </div>
                </BbCardContent>
            </BbCard>
            </div>

            @if (CanEdit)
            {
                <div class="flex justify-end pt-2">
                    <BbButton OnClick="SaveHeaderAsync" Size="ButtonSize.Default">Simpan Data Survei</BbButton>
                </div>
            }
        </div>
    </div>
}

@code {
    private static readonly (string Id, string Title)[] Sections =
    [
        ("operasional", "Operasional"),
        ("produk", "Produk Utama"),
        ("bahan-baku", "Bahan Baku"),
        ("pasar", "Orientasi Pasar"),
        ("energi", "Kebutuhan Energi"),
        ("peralatan", "Peralatan"),
        ("pipa", "Pipa Terdekat"),
        ("bahan-bakar", "Bahan Bakar"),
        ("rencana", "Rencana & Lainnya"),
        ("surveyor", "Surveyor"),
    ];

    [Parameter, EditorRequired]
    public Guid CompanyId { get; set; }

    [Parameter]
    public bool CanEdit { get; set; }

    [Parameter, EditorRequired]
    public Guid ActorUserId { get; set; }

    [Parameter, EditorRequired]
    public EffectivePermissions Actor { get; set; }

    // Passed down rather than fetched here — IUserService holds a directly
    // injected (not IDbContextFactory-backed) SimandoDbContext, shared for
    // the whole circuit; CompanyHub already fetches this list in its own
    // LoadAsync, and a second concurrent call from this component corrupts
    // that shared context (ObjectDisposedException / command-in-progress).
    [Parameter]
    public IReadOnlyList<SelectOption<Guid?>> Surveyors { get; set; } = [];

    [Parameter]
    public EventCallback OnSaved { get; set; }

    private SurveyDetail? _detail;
    private string? _headerError;

    private int? _jumlahKaryawan;
    private short? _jumlahShift;
    private decimal? _jamKerjaPerHari;
    private short? _hariPerMinggu;
    private TimeOnly? _bebanPuncak1Mulai;
    private TimeOnly? _bebanPuncak1Selesai;
    private TimeOnly? _bebanPuncak2Mulai;
    private TimeOnly? _bebanPuncak2Selesai;
    private IReadOnlyCollection<KebutuhanEnergiJenis> _kebutuhanEnergiSelected = [];
    private string? _kebutuhanEnergiLainnya;
    private decimal? _kapasitasNilai;
    private Guid? _kapasitasUnitId;
    private decimal? _pemakaianNilai;
    private Guid? _pemakaianUnitId;
    private decimal? _pipaTerdekatJarakM;
    private decimal? _pipaTerdekatDiameter;
    private decimal? _pipaTerdekatTekanan;
    private IReadOnlyCollection<BahanBakarEksisting> _bahanBakarSelected = [];
    private string? _namaPemasok;
    private decimal? _kapasitasListrikKw;
    private decimal? _pemakaianListrikKwh;
    private IReadOnlyCollection<RencanaPemanfaatanGas> _rencanaSelected = [];
    private string? _deskripsiProsesProduksi;
    private decimal? _minEfisiensiDiharapkanPct;
    private string? _keteranganLain;
    private DateTime? _tanggalSurvey;
    private Guid? _surveyorUserId;
    private decimal? _willingnessToPayUsdMmbtu;

    private List<SelectOption<Guid?>> _capacityUnits = [];
    private List<SelectOption<Guid?>> _energyUsageUnits = [];
    private List<SelectOption<Guid?>> _rawMaterialUnits = [];
    private List<SelectOption<Guid?>> _fuelConsumptionUnits = [];
    private List<SelectOption<Guid?>> _countries = [];
    private List<SelectOption<Guid?>> _fuelTypes = [];

    private bool _productDialogOpen;
    private bool _rawMaterialDialogOpen;
    private bool _marketDialogOpen;
    private bool _equipmentDialogOpen;

    private sealed class ProductFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama produk wajib diisi.")]
        public string Produk { get; set; } = "";
        public decimal? Kapasitas { get; set; }
        public decimal? HargaProduk { get; set; }
        public string? Catatan { get; set; }
    }

    private sealed class RawMaterialFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama bahan baku wajib diisi.")]
        public string? Bahan { get; set; }
        public Asal? Asal { get; set; }
        public Guid? CountryId { get; set; }
        public decimal? Volume { get; set; }
        public Guid? SatuanUnitId { get; set; }
    }

    private sealed class MarketFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama produk / bahan wajib diisi.")]
        public string? Bahan { get; set; }
        public Asal? Asal { get; set; }
        public Guid? CountryId { get; set; }
        public decimal? Volume { get; set; }
        public Guid? SatuanUnitId { get; set; }
    }

    private sealed class EquipmentFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Jenis peralatan wajib diisi.")]
        public string JenisPeralatan { get; set; } = "";
        public decimal? Kapasitas { get; set; }
        public Guid? KapasitasUnitId { get; set; }
        public decimal? JamPerHari { get; set; }
        public short? HariPerMinggu { get; set; }
        public Guid? FuelTypeId { get; set; }
        public decimal? HargaBahanBakar { get; set; }
        public decimal? KonsumsiPerBulan { get; set; }
        public Guid? KonsumsiUnitId { get; set; }
        public decimal KonversiKeGas { get; set; }
    }

    private List<SurveyProductDetail> _products = [];
    private Guid? _editingProductId;
    private ProductFormModel _productForm = new();
    private string? _productError;

    private List<SurveyRawMaterialDetail> _rawMaterials = [];
    private Guid? _editingRawMaterialId;
    private RawMaterialFormModel _rawMaterialForm = new();
    private string? _rawMaterialError;

    private List<SurveyMarketDetail> _markets = [];
    private Guid? _editingMarketId;
    private MarketFormModel _marketForm = new();
    private string? _marketError;

    private List<SurveyEquipmentDetail> _equipment = [];
    private Guid? _editingEquipmentId;
    private EquipmentFormModel _equipmentForm = new();
    private string? _equipmentError;

    private AttachmentDetail? _kk0Attachment;
    private IBrowserFile? _selectedKk0File;
    private SignatureMethod? _kk0SigMethod;
    private bool _uploadingKk0;
    private string? _kk0UploadError;

    private List<SelectOption<SignatureMethod?>> _sigMethodOptions =
    [
        new(SignatureMethod.Wet, "Tanda Tangan Basah"),
        new(SignatureMethod.Digital, "Tanda Tangan Digital"),
    ];

    private void OnKk0FileSelected(InputFileChangeEventArgs e)
    {
        _selectedKk0File = e.File;
        _kk0UploadError = null;
    }

    private async Task UploadKk0Async()
    {
        if (_selectedKk0File is null) return;
        _uploadingKk0 = true;
        _kk0UploadError = null;

        try
        {
            await using var stream = _selectedKk0File.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024);
            var req = new UploadAttachmentRequest(
                AttachmentKind.Kk0,
                _selectedKk0File.Name,
                _selectedKk0File.ContentType ?? "application/octet-stream",
                _selectedKk0File.Size,
                _kk0SigMethod,
                stream);

            var result = await AttachmentService.UploadAttachmentAsync(CompanyId, req, ActorUserId);
            if (result.Succeeded)
            {
                _selectedKk0File = null;
                await LoadAsync();
                ToastService.Success("Dokumen KK0 Ber-TTD berhasil diunggah.", "Tersimpan");
            }
            else
            {
                _kk0UploadError = result.Error;
                ToastService.Error(result.Error ?? "Gagal mengunggah berkas KK0.", "Gagal");
            }
        }
        catch (Exception ex)
        {
            _kk0UploadError = ex.Message;
            ToastService.Error($"Gagal mengunggah berkas: {ex.Message}", "Gagal");
        }
