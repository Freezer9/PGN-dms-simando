    private async Task LoadAsync()
    {
        _detail = await CompanyService.GetSurveyAsync(CompanyId);

        _jumlahKaryawan = _detail.JumlahKaryawan;
        _jumlahShift = _detail.JumlahShift;
        _jamKerjaPerHari = _detail.JamKerjaPerHari;
        _hariPerMinggu = _detail.HariPerMinggu;
        _bebanPuncak1Mulai = _detail.BebanPuncak1Mulai;
        _bebanPuncak1Selesai = _detail.BebanPuncak1Selesai;
        _bebanPuncak2Mulai = _detail.BebanPuncak2Mulai;
        _bebanPuncak2Selesai = _detail.BebanPuncak2Selesai;
        _kebutuhanEnergiLainnya = _detail.KebutuhanEnergiLainnya;
        _kapasitasNilai = _detail.KapasitasNilai;
        _kapasitasUnitId = _detail.KapasitasUnitId;
        _pemakaianNilai = _detail.PemakaianNilai;
        _pemakaianUnitId = _detail.PemakaianUnitId;
        _pipaTerdekatJarakM = _detail.PipaTerdekatJarakM;
        _pipaTerdekatDiameter = _detail.PipaTerdekatDiameter;
        _pipaTerdekatTekanan = _detail.PipaTerdekatTekanan;
        _namaPemasok = _detail.NamaPemasok;
        _kapasitasListrikKw = _detail.KapasitasListrikKw;
        _pemakaianListrikKwh = _detail.PemakaianListrikKwh;
        _deskripsiProsesProduksi = _detail.DeskripsiProsesProduksi;
        _minEfisiensiDiharapkanPct = _detail.MinEfisiensiDiharapkanPct;
        _keteranganLain = _detail.KeteranganLain;
        _tanggalSurvey = _detail.TanggalSurvey?.ToDateTime(TimeOnly.MinValue);
        _surveyorUserId = _detail.SurveyorUserId;
        _willingnessToPayUsdMmbtu = _detail.WillingnessToPayUsdMmbtu;

        _kebutuhanEnergiSelected = Enum.GetValues<KebutuhanEnergiJenis>()
            .Where(f => _detail.KebutuhanEnergi?.HasFlag(f) == true).ToList();
        _bahanBakarSelected = Enum.GetValues<BahanBakarEksisting>()
            .Where(f => _detail.BahanBakarEksisting?.HasFlag(f) == true).ToList();
        _rencanaSelected = Enum.GetValues<RencanaPemanfaatanGas>()
            .Where(f => _detail.RencanaPemanfaatanGas?.HasFlag(f) == true).ToList();

        _products = _detail.Products.ToList();
        _rawMaterials = _detail.RawMaterials.ToList();
        _markets = _detail.Markets.ToList();
        _equipment = _detail.Equipment.ToList();

        var attachments = await AttachmentService.GetCompanyAttachmentsAsync(CompanyId);
        _kk0Attachment = attachments.FirstOrDefault(a => a.Kind == AttachmentKind.Kk0 || a.Kind == AttachmentKind.A1);

        _editingProductId = _editingRawMaterialId = _editingMarketId = _editingEquipmentId = null;
    }

    private decimal TotalJumlahKebutuhanEnergi => _equipment.Sum(e => e.KonversiKeGas);

    private static KebutuhanEnergiJenis? CombineFlags(IReadOnlyCollection<KebutuhanEnergiJenis> selected) =>
        selected.Count == 0 ? null : selected.Aggregate((a, b) => a | b);

    private static BahanBakarEksisting? CombineFlags(IReadOnlyCollection<BahanBakarEksisting> selected) =>
        selected.Count == 0 ? null : selected.Aggregate((a, b) => a | b);

    private static RencanaPemanfaatanGas? CombineFlags(IReadOnlyCollection<RencanaPemanfaatanGas> selected) =>
        selected.Count == 0 ? null : selected.Aggregate((a, b) => a | b);

    private async Task SaveHeaderAsync()
    {
        _headerError = null;

        if (_tanggalSurvey is null)
        {
            _headerError = "Tanggal Survei wajib diisi.";
            ToastService.Error(_headerError, "Validasi Gagal");
            return;
        }

        if (_surveyorUserId is null)
        {
            _headerError = "Surveyor wajib dipilih.";
            ToastService.Error(_headerError, "Validasi Gagal");
            return;
        }

        var headerRequest = new SaveSurveyRequest(
            _tanggalSurvey is { } dt ? DateOnly.FromDateTime(dt) : null,
            _surveyorUserId,
            _jumlahKaryawan,
            _jumlahShift,
            _jamKerjaPerHari,
            _hariPerMinggu,
            _bebanPuncak1Mulai,
            _bebanPuncak1Selesai,
            _bebanPuncak2Mulai,
            _bebanPuncak2Selesai,
            CombineFlags(_kebutuhanEnergiSelected),
            _kebutuhanEnergiLainnya,
            _kapasitasNilai,
            _kapasitasUnitId,
            _pemakaianNilai,
            _pemakaianUnitId,
            _pipaTerdekatJarakM,
            _pipaTerdekatDiameter,
            _pipaTerdekatTekanan,
            CombineFlags(_bahanBakarSelected),
            _namaPemasok,
            _kapasitasListrikKw,
            _pemakaianListrikKwh,
            CombineFlags(_rencanaSelected),
            _deskripsiProsesProduksi,
            _minEfisiensiDiharapkanPct,
            _willingnessToPayUsdMmbtu,
            _keteranganLain);

        var productRequests = _products.Select(p => new SaveSurveyProductRequest(p.Produk, p.Kapasitas, p.HargaProduk, p.Catatan)).ToList();
        var rawMaterialRequests = _rawMaterials.Select(r => new SaveSurveyRawMaterialRequest(r.Bahan, r.Asal, r.CountryId, r.Volume, r.SatuanUnitId)).ToList();
        var marketRequests = _markets.Select(m => new SaveSurveyMarketRequest(m.Bahan, m.Asal, m.CountryId, m.Volume, m.SatuanUnitId)).ToList();
        var equipmentRequests = _equipment.Select(e => new SaveSurveyEquipmentRequest(
            e.JenisPeralatan, e.Kapasitas, e.KapasitasUnitId, e.JamPerHari, e.HariPerMinggu,
            e.FuelTypeId, e.HargaBahanBakar, e.KonsumsiPerBulan, e.KonsumsiUnitId, e.KonversiKeGas)).ToList();

        var result = await CompanyService.SaveSurveyFullAsync(
            CompanyId, headerRequest, productRequests, rawMaterialRequests, marketRequests, equipmentRequests, ActorUserId, Actor);

        if (!result.Succeeded)
        {
            _headerError = result.Error;
            ToastService.Error(result.Error ?? "Gagal menyimpan formulir survei.", "Gagal");
            return;
        }

        await LoadAsync();
        ToastService.Success("Formulir survei berhasil disimpan. Tahap berlanjut ke A1.", "Tersimpan");
        if (OnSaved.HasDelegate)
        {
            await OnSaved.InvokeAsync();
        }
    }

