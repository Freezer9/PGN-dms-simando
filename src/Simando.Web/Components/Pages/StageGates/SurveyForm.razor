    private void StartAddEquipment()
    {
        _editingEquipmentId = null;
        _equipmentForm = new EquipmentFormModel();
        _equipmentError = null;
        _equipmentDialogOpen = true;
    }

    private void StartEditEquipment(SurveyEquipmentDetail row)
    {
        _editingEquipmentId = row.Id;
        _equipmentForm = new EquipmentFormModel
        {
            JenisPeralatan = row.JenisPeralatan,
            Kapasitas = row.Kapasitas,
            KapasitasUnitId = row.KapasitasUnitId,
            JamPerHari = row.JamPerHari,
            HariPerMinggu = row.HariPerMinggu,
            FuelTypeId = row.FuelTypeId,
            HargaBahanBakar = row.HargaBahanBakar,
            KonsumsiPerBulan = row.KonsumsiPerBulan,
            KonsumsiUnitId = row.KonsumsiUnitId,
            KonversiKeGas = row.KonversiKeGas,
        };
        _equipmentError = null;
        _equipmentDialogOpen = true;
    }

    private void CancelEquipmentEdit()
    {
        _editingEquipmentId = null;
        _equipmentError = null;
        _equipmentDialogOpen = false;
    }

    private void SaveEquipmentRowAsync()
    {
        _equipmentError = null;

        if (_editingEquipmentId is { } id)
        {
            var idx = _equipment.FindIndex(e => e.Id == id);
            if (idx >= 0)
            {
                _equipment[idx] = new SurveyEquipmentDetail(
                    id, _equipmentForm.JenisPeralatan, _equipmentForm.Kapasitas, _equipmentForm.KapasitasUnitId,
                    _equipmentForm.JamPerHari, _equipmentForm.HariPerMinggu, _equipmentForm.FuelTypeId,
                    _equipmentForm.HargaBahanBakar, _equipmentForm.KonsumsiPerBulan, _equipmentForm.KonsumsiUnitId,
                    _equipmentForm.KonversiKeGas, (short)idx);
            }
        }
        else
        {
            _equipment.Add(new SurveyEquipmentDetail(
                Guid.NewGuid(), _equipmentForm.JenisPeralatan, _equipmentForm.Kapasitas, _equipmentForm.KapasitasUnitId,
                _equipmentForm.JamPerHari, _equipmentForm.HariPerMinggu, _equipmentForm.FuelTypeId,
                _equipmentForm.HargaBahanBakar, _equipmentForm.KonsumsiPerBulan, _equipmentForm.KonsumsiUnitId,
                _equipmentForm.KonversiKeGas, (short)_equipment.Count));
        }

        _equipmentDialogOpen = false;
    }

    private void DeleteEquipmentAsync(Guid id)
    {
        _equipment.RemoveAll(e => e.Id == id);
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
