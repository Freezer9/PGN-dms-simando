                                                <LucideIcon Name="pencil" Class="size-3.5" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => DeleteMarketAsync(row.Id))" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30">
                                                <LucideIcon Name="trash-2" Class="size-3.5" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Hapus</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </BbTableCell>
                        }
                    </BbTableRow>
                }
            </BbTableBody>
        </BbTable>
        </div>
        @if (CanEdit)
        {
            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(_markets.Count >= 4)" OnClick="StartAddMarket">
                <LucideIcon Name="plus" Class="size-4 mr-1" /> Tambah Pasar
            </BbButton>
        }

        <BbDialog @bind-Open="_marketDialogOpen">
            <BbDialogContent>
                <EditForm Model="_marketForm" OnValidSubmit="SaveMarketRowAsync" OnInvalidSubmit="HandleInvalidSubmit">
                    <DataAnnotationsValidator />
                    <BbDialogHeader>
                        <BbDialogTitle>@(_editingMarketId is null ? "Tambah Orientasi Pasar" : "Ubah Orientasi Pasar")</BbDialogTitle>
                    </BbDialogHeader>
                    <div class="py-4 space-y-3">
                        <BbFormFieldInput TValue="string" @bind-Value="_marketForm.Bahan" Label="Nama Produk / Bahan *" Placeholder="Masukkan nama bahan" />
                        <BbFormFieldSelect TValue="Asal?" @bind-Value="_marketForm.Asal" Label="Pasar" Placeholder="Pilih pasar">
                            <BbSelectItem Value="@((Asal?)Asal.Lokal)" Text="Lokal" />
                            <BbSelectItem Value="@((Asal?)Asal.Impor)" Text="Ekspor" />
                        </BbFormFieldSelect>
                        <BbFormFieldCombobox TValue="Guid?"
                                             @bind-Value="_marketForm.CountryId"
                                             Label="Negara Tujuan"
                                             Options="_countries"
                                             Placeholder="Pilih negara"
                                             SearchPlaceholder="Cari negara..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        <div class="grid grid-cols-2 gap-4">
                            <BbFormFieldInput TValue="decimal?" @bind-Value="_marketForm.Volume" Label="Volume" Type="InputType.Number" Class="w-full" InputClass="w-full" />
                            <BbFormFieldCombobox TValue="Guid?"
                                                 @bind-Value="_marketForm.SatuanUnitId"
                                                 Label="Satuan"
                                                 Options="_rawMaterialUnits"
                                                 Placeholder="Pilih satuan"
                                                 SearchPlaceholder="Cari satuan..."
                                                 EmptyMessage="Tidak ditemukan"
                                                 MatchTriggerWidth
                                                 Class="w-full"
                                                 InputClass="w-full text-xs" />
                        </div>
                        @if (_marketError is not null)
                        {
                            <BbAlert Variant="AlertVariant.Danger">
                                <BbAlertDescription>@_marketError</BbAlertDescription>
                            </BbAlert>
                        }
                    </div>
                    <BbDialogFooter>
                        <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="CancelMarketEdit">Batal</BbButton>
                        <BbButton Type="ButtonType.Submit">Terapkan</BbButton>
                    </BbDialogFooter>
                </EditForm>
            </BbDialogContent>
        </BbDialog>
    </div>;

    private void StartAddMarket()
    {
        _editingMarketId = null;
        _marketForm = new MarketFormModel();
        _marketError = null;
        _marketDialogOpen = true;
    }

    private void StartEditMarket(SurveyMarketDetail row)
    {
        _editingMarketId = row.Id;
        _marketForm = new MarketFormModel
        {
            Bahan = row.Bahan,
            Asal = row.Asal,
            CountryId = row.CountryId,
            Volume = row.Volume,
            SatuanUnitId = row.SatuanUnitId,
        };
        _marketError = null;
        _marketDialogOpen = true;
    }

    private void CancelMarketEdit()
    {
        _editingMarketId = null;
        _marketError = null;
        _marketDialogOpen = false;
    }

    private void SaveMarketRowAsync()
    {
        _marketError = null;

        if (_editingMarketId is { } id)
        {
            var idx = _markets.FindIndex(m => m.Id == id);
            if (idx >= 0)
            {
                _markets[idx] = new SurveyMarketDetail(id, _marketForm.Bahan, _marketForm.Asal, _marketForm.CountryId, _marketForm.Volume, _marketForm.SatuanUnitId, (short)idx);
            }
        }
        else
        {
            _markets.Add(new SurveyMarketDetail(Guid.NewGuid(), _marketForm.Bahan, _marketForm.Asal, _marketForm.CountryId, _marketForm.Volume, _marketForm.SatuanUnitId, (short)_markets.Count));
        }

        _marketDialogOpen = false;
    }

    private void DeleteMarketAsync(Guid id)
    {
        _markets.RemoveAll(m => m.Id == id);
    }

    private RenderFragment RenderEquipmentTable() => @<div class="space-y-2">
