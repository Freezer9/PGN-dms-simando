@using Simando.Application.Dashboard
@using Simando.Application.Directory
@using Simando.Domain.Audit
@using Simando.Domain.Directory
@using Simando.Domain.Workflow
@using Simando.Web.Components.Shared
@inject NavigationManager NavigationManager
@inject IJSRuntime JS
@inject ICompanyService Service
@implements IAsyncDisposable

<div class="space-y-6">
    <!-- Header with Quick Action Shortcuts Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Beranda Sales Area</h1>
            <p class="text-xs text-muted-foreground mt-1">Area: <strong class="text-foreground">@AreaName</strong> ·
                Ringkasan tugas, pipeline sales, dan peta sebaran pelanggan.</p>
            </div>
            <div class="flex flex-wrap items-center gap-2">
                <BbButton Href="/directory/new" Variant="ButtonVariant.Default" Size="ButtonSize.Small"
                          Class="gap-1.5 shadow-xs">
                    <LucideIcon Name="plus" Class="size-4" />
                    <span>Tambah Perusahaan Baru</span>
                </BbButton>
                <BbButton Href="/map" Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="gap-1.5">
                    <LucideIcon Name="map-pin" Class="size-4" />
                    <span>Peta Explorer</span>
                </BbButton>
                <BbButton Href="/tasks" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Class="gap-1.5">
                    @* <LucideIcon Name="check-square" Class="size-4" /> *@
                    <span>Antrean Berkas</span>
                </BbButton>
            </div>
        </div>

        <!-- 1. Top Row Unified KPI Stat Cards -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <BbStatTile Label="Total Pipeline Saya" Value="@TotalPipelineCount.ToString("N0")"
                        Subtext="@($"Registrasi perusahaan di {AreaName}")" Icon="rocket" />

            <BbStatTile Label="Perlu Tindakan Anda" Value="@Data.ReturnedWorkItems.Count.ToString("N0")"
                        Subtext="@(Data.ReturnedWorkItems.Count > 0 ? "Memerlukan revisi / pengajuan ulang" : "Semua draf & pengajuan lancar")"
                        Icon="triangle-alert"
                        Class="@(Data.ReturnedWorkItems.Count > 0 ? "border-amber-300 bg-amber-50/30 dark:border-amber-800 dark:bg-amber-950/20" : "")" />

            <BbStatTile Label="Dalam Persetujuan" Value="@Data.ActiveApprovalItems.Count.ToString("N0")"
                        Subtext="Menunggu tinjauan reviewer / approver" Icon="clock" />

            <BbStatTile Label="Terbit NOL / RL" Value="@Data.StageCounts.GetValueOrDefault((byte)6, 0).ToString("N0")"
                        Subtext="Izin prinsip telah diterbitkan" Icon="file-check-2"
                        Class="border-emerald-200 bg-emerald-50/20 dark:border-emerald-900/40 dark:bg-emerald-950/20" />
        </div>

        <!-- 2. Perlu Tindakan Anda (Returned Work Panel) -->
        @if (Data.ReturnedWorkItems.Count > 0)
        {
            <BbCard Class="border-amber-300 bg-amber-50/20 dark:border-amber-800/60 dark:bg-amber-950/20">
                <BbCardHeader Class="pb-3">
                    <div class="flex items-center gap-2 text-amber-800 dark:text-amber-300 font-semibold text-sm">
                        <LucideIcon Name="triangle-alert" Class="size-4 text-amber-600 dark:text-amber-400" />
                        <span>Perlu Tindakan Anda (@Data.ReturnedWorkItems.Count)</span>
                    </div>
                </BbCardHeader>
                <BbCardContent Class="space-y-3">
                    @foreach (var item in Data.ReturnedWorkItems)
                    {
                        <div
                            class="p-3.5 border rounded-lg bg-background flex flex-col md:flex-row md:items-center justify-between gap-3 shadow-xs">
                            <div class="space-y-1">
                                <div class="flex items-center gap-2">
                                    <span class="font-semibold text-sm text-foreground">@item.CompanyName</span>
                                    <span
                                        class="text-xs px-2 py-0.5 rounded font-semibold @(item.Action == StatusEventAction.Tolak ? "bg-rose-100 text-rose-800 dark:bg-rose-900/40 dark:text-rose-300" : "bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300")">
                                        @(item.Action == StatusEventAction.Tolak ? "Ditolak" : "Dikembalikan (Revisi)") oleh
                                        @item.ActorRoleLabel
                                    </span>
                                </div>
                                <p class="text-xs text-muted-foreground italic">"@item.ReturnReason"</p>
                                <p class="text-[11px] text-muted-foreground/80 flex items-center gap-1">
                                    <LucideIcon Name="clock" Class="size-3 shrink-0" />
                                    @item.ReturnedAt.ToString("dd MMM yyyy HH:mm")
                                </p>
                            </div>
                            <a href="/companies/@item.CompanyId"
                               class="inline-flex items-center justify-center rounded-md text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 h-8 px-3.5 whitespace-nowrap self-start md:self-center">
                                Buka Record
                            </a>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        }

        <!-- 3. Pipeline Penjualan Saya (Stage Grid) -->
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Pipeline Penjualan Saya</BbCardTitle>
                <BbCardDescription>Klik salah satu tahap di bawah ini untuk memfilter direktori perusahaan pada tahap
                    tersebut.</BbCardDescription>
                </BbCardHeader>
                <BbCardContent>
                    <div class="grid grid-cols-2 sm:grid-cols-4 lg:grid-cols-8 gap-3">
                        @for (var i = 0; i < CompanyLabels.StageLabels.Length; i++)
                        {
                            var stageNum = (byte)(i + 1);
                            var count = Data.StageCounts.GetValueOrDefault(stageNum, 0);
                            var color = CompanyLabels.StageDotColor(stageNum);
                            <a href="/directory?stage=@stageNum"
                               class="group flex flex-col items-center justify-center p-3 border rounded-lg hover:border-primary/50 hover:bg-accent/40 transition-all text-center space-y-1 bg-card">
                                <div class="flex items-center gap-1.5">
                                    <span class="size-2 rounded-full" style="background-color: @color"></span>
                                    <span
                                    class="text-xs text-muted-foreground font-medium group-hover:text-foreground transition-colors">@CompanyLabels.StageLabels[i]</span>
                                </div>
                                <span class="text-xl font-bold tracking-tight text-foreground">@count</span>
                            </a>
                        }
                    </div>
                </BbCardContent>
            </BbCard>

            <!-- 4. Dalam Proses Persetujuan & Peta Prospek Grid -->
            <div class="grid grid-cols-1 lg:grid-cols-2 gap-6">
                <!-- Dalam Proses Persetujuan -->
                <BbCard>
                    <BbCardHeader>
                        <BbCardTitle>Dalam Proses Persetujuan</BbCardTitle>
                        <BbCardDescription>Daftar permohonan yang sedang berada dalam jalur tinjauan pihak lain.
                        </BbCardDescription>
                    </BbCardHeader>
                    <BbCardContent>
                        @if (Data.ActiveApprovalItems.Count == 0)
                        {
                            <BbEmpty Title="Tidak ada berkas aktif"
                                     Description="Seluruh berkas yang Anda ajukan saat ini dalam proses atau telah selesai."
                                     Size="EmptySize.Small" />
                        }
                        else
                        {
                            <div class="divide-y border rounded-md overflow-hidden">
                                @foreach (var item in Data.ActiveApprovalItems)
                                {
                                    <a href="/companies/@item.CompanyId"
                                       class="flex items-center justify-between p-3 text-xs hover:bg-muted/40 transition-colors">
                                        <div>
                                            <div class="font-semibold text-foreground">@item.CompanyName</div>
                                            <div class="text-muted-foreground text-[11px]">@item.CompanyNomor</div>
                                        </div>
                                        <div class="text-right">
                                            <span
                                            class="px-2 py-0.5 rounded bg-muted text-muted-foreground font-medium text-[11px]">@item.HolderLabel</span>
                                            <div
                                                class="text-[10px] text-muted-foreground/80 mt-0.5 flex items-center justify-end gap-1">
                                                <LucideIcon Name="clock" Class="size-3" />
                                                @((int)(DateTimeOffset.UtcNow - item.SubmittedAt).TotalHours)h lalu
                                            </div>
                                        </div>
                                    </a>
                                }
                            </div>
                        }
                    </BbCardContent>
                </BbCard>

                <!-- Peta Sebaran Pelanggan & Prospek Interactive Preview -->
                <BbCard>
                    <BbCardHeader Class="flex flex-row items-center justify-between">
                        <div>
                            <BbCardTitle>Peta Sebaran Pelanggan &amp; Prospek</BbCardTitle>
                            <BbCardDescription>Sebaran posisi lokasi perusahaan &amp; status jalur di area @AreaName.
                            </BbCardDescription>
                        </div>
                        <a href="/map"
                           class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                            Buka Peta Penuh
                            <LucideIcon Name="arrow-right" Class="size-3.5" />
                        </a>
                    </BbCardHeader>
                    <BbCardContent>
                        <div id="@_elementId"
                             style="height: 220px; width: 100%; border-radius: var(--radius); overflow: hidden;"></div>
                    </BbCardContent>
                </BbCard>
            </div>
        </div>

@code {
    [Parameter, EditorRequired] public SalesAreaDashboardDto Data { get; set; } = null!;
    [Parameter, EditorRequired] public string AreaName { get; set; } = "Area";

    private int TotalPipelineCount => Data.StageCounts.GetValueOrDefault((byte)1, 0);

    private readonly string _elementId = $"dashboard-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<SalesAreaDashboard>? _dotNetRef;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        try
        {
            var filter = new CompanyListFilter();
            var rows = (await Service.GetListAsync(filter))
                .Where(r => r.Latitude is not null && r.Longitude is not null)
                .ToList();

            var pins = rows.Select(r => new
            {
                id = r.Id,
                lat = r.Latitude,
                lng = r.Longitude,
                stageBucket = r.Status == RecordStatus.IssuedNol ? "nol" : Math.Min(r.CurrentStage, (byte)6).ToString(),
                dashed = r.PosisiPelanggan == PosisiPelanggan.Pengembangan,
                size = 1.0,
                nomor = r.Nomor,
                nama = r.NamaPerusahaan,
                industryTypeName = r.IndustryTypeName,
                posisiPelangganLabel = r.PosisiPelanggan is null ? null : CompanyLabels.PosisiPelangganLabel(r.PosisiPelanggan),
                stageLabel = $"Tahap {r.CurrentStage} {CompanyLabels.StageLabel(r.CurrentStage)}",
                salesUserName = r.SalesUserName,
            }).ToList();

            _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/full-map.js");
            _dotNetRef = DotNetObjectReference.Create(this);
            await _module.InvokeVoidAsync("initMap", _elementId, _dotNetRef, pins, false);
        }
        catch
        {
            // Fallback for SSG/prerender environment
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            try
            {
                await _module.InvokeVoidAsync("dispose", _elementId);
            }
            catch
            {
            }
            await _module.DisposeAsync();
        }
        _dotNetRef?.Dispose();
    }
}
