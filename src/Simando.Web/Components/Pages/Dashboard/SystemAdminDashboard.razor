@using Simando.Application.Dashboard
@using Simando.Web.Components.Shared

<div class="space-y-6">
    <!-- Header with Action Shortcuts Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Beranda Administrator Sistem</h1>
            <p class="text-xs text-muted-foreground mt-1">Kesehatan master data, konfigurasi platform, dan manajemen sistem.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <BbButton Href="/admin/stuck-steps" Variant="ButtonVariant.Default" Size="ButtonSize.Small" Class="gap-1.5 shadow-xs">
                <LucideIcon Name="alert-triangle" Class="size-4" />
                <span>Langkah Tertahan</span>
            </BbButton>
            <BbButton Href="/admin/break-glass" Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="gap-1.5">
                <LucideIcon Name="shield-alert" Class="size-4" />
                <span>Audit Break-Glass</span>
            </BbButton>
            <BbButton Href="/master/organisation" Variant="ButtonVariant.Secondary" Size="ButtonSize.Small" Class="gap-1.5">
                <LucideIcon Name="users" Class="size-4" />
                <span>Organisasi &amp; Akses</span>
            </BbButton>
        </div>
    </div>

    <!-- 1. Top Row Unified KPI Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <BbStatTile Label="Pengguna Aktif"
                    Value="@Data.ActiveUsersCount.ToString("N0")"
                    Subtext="Total akun terdaftar di sistem"
                    Icon="users" />

        <BbStatTile Label="Sales Area Terdaftar"
                    Value="@Data.ActiveAreasCount.ToString("N0")"
                    Subtext="@($"{Data.ActiveRegionsCount} Region Wilayah")"
                    Icon="map-pin" />

        <BbStatTile Label="Template Dokumen"
                    Value="@Data.DocumentTemplatesCount.ToString("N0")"
                    Subtext="Template berkas Word (.docx)"
                    Icon="file-text" />

        <BbStatTile Label="Kesehatan Master Data"
                    Value="@($"{Data.HealthItems.Count(h => h.IsHealthy)} / {Data.HealthItems.Count}")"
                    Subtext="@(Data.HealthItems.All(h => h.IsHealthy) ? "Seluruh modul terkonfigurasi" : "Perlu kelengkapan master data")"
                    Icon="shield-check"
                    Class="@(Data.HealthItems.All(h => h.IsHealthy) ? "border-emerald-200 bg-emerald-50/20 dark:border-emerald-900/40 dark:bg-emerald-950/20" : "border-amber-300 bg-amber-50/30 dark:border-amber-800 dark:bg-amber-950/20")" />
    </div>

    <!-- 2. Master Data Health Checklist -->
    <BbCard Class="@(Data.HealthItems.All(h => h.IsHealthy) ? "" : "border-amber-300 bg-amber-50/10 dark:border-amber-800/60 dark:bg-amber-950/10")">
        <BbCardHeader>
            <div class="flex items-center gap-2 font-semibold text-sm @(Data.HealthItems.All(h => h.IsHealthy) ? "text-foreground" : "text-amber-800 dark:text-amber-300")">
                <LucideIcon Name="@(Data.HealthItems.All(h => h.IsHealthy) ? "shield-check" : "triangle-alert")" Class="size-4 text-amber-600 dark:text-amber-400" />
                <span>Perlu Perhatian (Konfigurasi Master Data)</span>
            </div>
        </BbCardHeader>
        <BbCardContent>
            <div class="space-y-2">
                @foreach (var item in Data.HealthItems)
                {
                    <div class="p-3 border rounded-md bg-background flex items-center justify-between gap-3 text-xs shadow-xs">
                        <div class="flex items-center gap-2.5">
                            @if (item.IsHealthy)
                            {
                                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-emerald-100 text-emerald-800 dark:bg-emerald-900/40 dark:text-emerald-300">
                                    <LucideIcon Name="check" Class="size-3" />
                                </span>
                            }
                            else
                            {
                                <span class="flex size-5 shrink-0 items-center justify-center rounded-full bg-amber-100 text-amber-800 dark:bg-amber-900/40 dark:text-amber-300">
                                    <LucideIcon Name="triangle-alert" Class="size-3" />
                                </span>
                            }
                            <div>
                                <div class="font-semibold text-foreground">@item.Title</div>
                                <div class="text-muted-foreground text-[11px]">@item.Description</div>
                            </div>
                        </div>
                        <a href="/master/reference-documents" class="text-xs font-semibold text-primary hover:underline whitespace-nowrap">
                            Kelola
                        </a>
                    </div>
                }
            </div>
        </BbCardContent>
    </BbCard>

    <!-- 3. Master Data Quick Shortcut Cards Grid -->
    <div class="space-y-3">
        <h3 class="text-sm font-semibold tracking-tight text-foreground">Akses Cepat Master Data</h3>
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
            <a href="/master/industry-types" class="group p-4 border rounded-lg bg-card hover:border-primary/50 hover:bg-accent/40 transition-all space-y-2">
                <div class="flex items-center justify-between">
                    <span class="p-2 rounded-md bg-primary/10 text-primary group-hover:bg-primary group-hover:text-primary-foreground transition-colors">
                        <LucideIcon Name="factory" Class="size-5" />
                    </span>
                    <LucideIcon Name="arrow-right" Class="size-4 text-muted-foreground group-hover:text-primary transition-colors" />
                </div>
                <div>
                    <h4 class="font-semibold text-sm text-foreground">Jenis Industri</h4>
                    <p class="text-xs text-muted-foreground">Kelola sektor &amp; klasifikasi pelanggan</p>
                </div>
            </a>

            <a href="/master/fuel-types" class="group p-4 border rounded-lg bg-card hover:border-primary/50 hover:bg-accent/40 transition-all space-y-2">
                <div class="flex items-center justify-between">
                    <span class="p-2 rounded-md bg-amber-500/10 text-amber-600 dark:text-amber-400 group-hover:bg-amber-600 group-hover:text-white transition-colors">
                        <LucideIcon Name="flame" Class="size-5" />
                    </span>
                    <LucideIcon Name="arrow-right" Class="size-4 text-muted-foreground group-hover:text-amber-600 transition-colors" />
                </div>
                <div>
                    <h4 class="font-semibold text-sm text-foreground">Bahan Bakar Exists</h4>
                    <p class="text-xs text-muted-foreground">Katalog jenis bahan bakar industri</p>
                </div>
            </a>

            <a href="/master/meter-sizes" class="group p-4 border rounded-lg bg-card hover:border-primary/50 hover:bg-accent/40 transition-all space-y-2">
                <div class="flex items-center justify-between">
                    <span class="p-2 rounded-md bg-blue-500/10 text-blue-600 dark:text-blue-400 group-hover:bg-blue-600 group-hover:text-white transition-colors">
                        <LucideIcon Name="gauge" Class="size-5" />
                    </span>
                    <LucideIcon Name="arrow-right" Class="size-4 text-muted-foreground group-hover:text-blue-600 transition-colors" />
                </div>
                <div>
                    <h4 class="font-semibold text-sm text-foreground">Ukuran Meter (G-Size)</h4>
                    <p class="text-xs text-muted-foreground">Spesifikasi &amp; kapasitas MRS</p>
                </div>
            </a>

            <a href="/master/reference-documents" class="group p-4 border rounded-lg bg-card hover:border-primary/50 hover:bg-accent/40 transition-all space-y-2">
                <div class="flex items-center justify-between">
                    <span class="p-2 rounded-md bg-emerald-500/10 text-emerald-600 dark:text-emerald-400 group-hover:bg-emerald-600 group-hover:text-white transition-colors">
                        <LucideIcon Name="file-text" Class="size-5" />
                    </span>
                    <LucideIcon Name="arrow-right" Class="size-4 text-muted-foreground group-hover:text-emerald-600 transition-colors" />
                </div>
                <div>
                    <h4 class="font-semibold text-sm text-foreground">Dokumen Acuan</h4>
                    <p class="text-xs text-muted-foreground">Syarat &amp; ketentuan kebijakan NOL</p>
                </div>
            </a>
        </div>
    </div>
</div>

@code {
    [Parameter, EditorRequired] public SystemAdminDashboardDto Data { get; set; } = null!;
}
