@using Simando.Application.Dashboard
@using Simando.Application.Directory
@using Simando.Domain.Audit
@using Simando.Domain.Directory
@using Simando.Web.Components.Shared

<div class="space-y-6">
    <!-- Header with Action Shortcuts Bar -->
    <div class="flex flex-col md:flex-row md:items-center md:justify-between gap-4">
        <div>
            <h1 class="text-2xl font-bold tracking-tight text-foreground">Beranda @RoleLabel</h1>
            <p class="text-xs text-muted-foreground mt-1">Lingkup: <strong class="text-foreground">@ScopeLabel</strong> · Daftar tugas verifikasi &amp; persetujuan berkas.</p>
        </div>
        <div class="flex flex-wrap items-center gap-2">
            <BbButton Href="/tasks" Variant="ButtonVariant.Default" Size="ButtonSize.Small" Class="gap-1.5 shadow-xs">
                <LucideIcon Name="check-square" Class="size-4" />
                <span>Antrean Tugas Saya</span>
            </BbButton>
            <BbButton Href="/directory" Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Class="gap-1.5">
                <LucideIcon Name="building-2" Class="size-4" />
                <span>Direktori Perusahaan</span>
            </BbButton>
        </div>
    </div>

    <!-- 1. Top Row Unified KPI Stat Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4">
        <BbStatTile Label="Menunggu Persetujuan Anda"
                    Value="@Data.PendingApprovals.Count.ToString("N0")"
                    Subtext="@(Data.PendingApprovals.Count > 0 ? "Memerlukan verifikasi Anda" : "Semua persetujuan selesai")"
                    Icon="clock"
                    Class="@(Data.PendingApprovals.Count > 0 ? "border-amber-300 bg-amber-50/30 dark:border-amber-800 dark:bg-amber-950/20" : "")" />

        <BbStatTile Label="Total Record Aktif"
                    Value="@Data.TotalActiveRecords.ToString("N0")"
                    Subtext="@($"Dalam lingkup {ScopeLabel}")"
                    Icon="file-text" />

        <BbStatTile Label="Terbit NOL Bulan Ini"
                    Value="@Data.NolIssuedThisMonth.ToString("N0")"
                    Subtext="Izin prinsip telah diterbitkan"
                    Icon="file-check-2"
                    Class="border-emerald-200 bg-emerald-50/20 dark:border-emerald-900/40 dark:bg-emerald-950/20" />

        <BbStatTile Label="Disetujui Bulan Ini"
                    Value="@Data.Performance.ApprovedThisMonth.ToString("N0")"
                    Subtext="@($"Rata-rata tinjau: {Data.Performance.AverageTurnaroundDays:F1} hari")"
                    Icon="check-circle-2" />
    </div>

    <!-- 2. Menunggu Persetujuan Anda Table -->
    <BbCard>
        <BbCardHeader Class="flex flex-row items-center justify-between">
            <div>
                <BbCardTitle>Menunggu Persetujuan Anda (@Data.PendingApprovals.Count)</BbCardTitle>
                <BbCardDescription>Daftar berkas yang memerlukan tindakan verifikasi / persetujuan Anda.</BbCardDescription>
            </div>
            <a href="/tasks" class="inline-flex items-center gap-1 text-xs font-semibold text-primary hover:underline">
                Lihat Semua <LucideIcon Name="arrow-right" Class="size-3.5" />
            </a>
        </BbCardHeader>
        <BbCardContent>
            <BbDataTable TData="PendingApprovalItem" Data="Data.PendingApprovals" InitialPageSize="10" AriaLabel="Menunggu persetujuan Anda">
                <Columns>
                    <BbDataTableColumn TData="PendingApprovalItem" TValue="string" Header="Nama Perusahaan">
                        <CellTemplate Context="item">
                            <div class="flex flex-col">
                                <span class="font-semibold text-foreground">@item.CompanyName</span>
                                <span class="text-xs text-muted-foreground">@item.CompanyNomor</span>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="PendingApprovalItem" TValue="string" Header="Tahap" Width="140px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="item">
                            <span class="text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-800 font-medium dark:bg-blue-900/40 dark:text-blue-300">
                                @CompanyLabels.StageLabel(item.Stage)
                            </span>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="PendingApprovalItem" TValue="string" Header="Diajukan Oleh" Property="@(item => item.SubmittedByName)" Sortable="true" Width="140px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                    <BbDataTableColumn TData="PendingApprovalItem" TValue="string" Header="Durasi SLA" Width="130px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="item">
                            @{
                                var waitingDays = (int)(DateTimeOffset.UtcNow - item.WaitingSince).TotalDays;
                                var badgeStyle = waitingDays switch
                                {
                                    > 7 => "bg-rose-50 text-rose-700 border-rose-200 animate-pulse dark:bg-rose-900/40 dark:text-rose-300",
                                    >= 3 => "bg-amber-50 text-amber-700 border-amber-200 dark:bg-amber-900/40 dark:text-amber-300",
                                    _ => "bg-emerald-50 text-emerald-700 border-emerald-200 dark:bg-emerald-900/40 dark:text-emerald-300"
                                };
                            }
                            <span class="inline-flex items-center gap-1 px-2 py-0.5 rounded border text-[11px] font-semibold @badgeStyle">
                                <LucideIcon Name="clock" Class="size-3 shrink-0" />
                                @(waitingDays == 0 ? "Hari ini" : $"{waitingDays} hari")
                            </span>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="PendingApprovalItem" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="item">
                            <div class="flex items-center justify-center">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Href="@($"/companies/{item.CompanyId}")" Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Tinjau">
                                            <LucideIcon Name="eye" Class="size-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Tinjau</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Tidak ada tugas" Description="Tidak ada yang menunggu persetujuan Anda saat ini." />
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>

    <!-- 3. Ringkasan Area & Kinerja Persetujuan Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
        <!-- Ringkasan Area -->
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Ringkasan</BbCardTitle>
            </BbCardHeader>
            <BbCardContent Class="space-y-3 text-xs">
                <div class="flex justify-between py-1.5 border-b">
                    <span class="text-muted-foreground">Total Record Aktif:</span>
                    <span class="font-bold text-foreground">@Data.TotalActiveRecords</span>
                </div>
                <div class="flex justify-between py-1.5 border-b">
                    <span class="text-muted-foreground">Menunggu Persetujuan:</span>
                    <span class="font-bold text-foreground">@Data.TotalPendingApprovals</span>
                </div>
                <div class="flex justify-between py-1.5">
                    <span class="text-muted-foreground">Terbit NOL Bulan Ini:</span>
                    <span class="font-bold text-emerald-700 dark:text-emerald-400">@Data.NolIssuedThisMonth</span>
                </div>
            </BbCardContent>
        </BbCard>

        <!-- Kinerja Persetujuan Saya -->
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Kinerja Persetujuan Saya</BbCardTitle>
            </BbCardHeader>
            <BbCardContent Class="space-y-3 text-xs">
                <div class="flex justify-between py-1.5 border-b">
                    <span class="text-muted-foreground">Rata-rata Waktu Tinjau:</span>
                    <span class="font-bold text-foreground">@Data.Performance.AverageTurnaroundDays.ToString("F1") hari</span>
                </div>
                <div class="flex justify-between py-1.5 border-b">
                    <span class="text-muted-foreground">Disetujui Bulan Ini:</span>
                    <span class="font-bold text-emerald-700 dark:text-emerald-400">@Data.Performance.ApprovedThisMonth</span>
                </div>
                <div class="flex justify-between py-1.5">
                    <span class="text-muted-foreground">Revisi / Tolak Bulan Ini:</span>
                    <span class="font-bold text-amber-700 dark:text-amber-400">@Data.Performance.RevisedThisMonth</span>
                </div>
            </BbCardContent>
        </BbCard>
    </div>

    <!-- 4. Aktivitas Terbaru -->
    <BbCard>
        <BbCardHeader>
            <BbCardTitle>Aktivitas Terbaru</BbCardTitle>
        </BbCardHeader>
        <BbCardContent>
            @if (Data.RecentActivity.Count == 0)
            {
                <div class="p-4 text-center text-xs text-muted-foreground border rounded-md">Belum ada aktivitas persetujuan tercatat.</div>
            }
            else
            {
                <div class="space-y-2 text-xs divide-y">
                    @foreach (var act in Data.RecentActivity)
                    {
                        <div class="pt-2 flex items-center gap-2">
                            <span class="text-muted-foreground/80 font-mono">@act.OccurredAt.ToString("HH:mm")</span>
                            <span class="font-semibold text-foreground">@act.ActorName</span>
                            <span class="text-muted-foreground">@act.Action.ToString()</span>
                            <span class="font-semibold text-primary">@act.CompanyName</span>
                            <span class="text-muted-foreground inline-flex items-center gap-1">
                                <LucideIcon Name="arrow-right" Class="size-3" />
                                @act.NextHolderLabel
                            </span>
                        </div>
                    }
                </div>
            }
        </BbCardContent>
    </BbCard>
</div>

@code {
    [Parameter, EditorRequired] public ApproverDashboardDto Data { get; set; } = null!;
    [Parameter, EditorRequired] public string RoleLabel { get; set; } = "Approver";
    [Parameter, EditorRequired] public string ScopeLabel { get; set; } = "Scope";
}
