@page "/reports/nol-outcomes"
@inherits AdminPageBase
@using Simando.Application.Reports
@using Simando.Domain.Security
@inject IReportsService ReportsService

<PageTitle>Hasil NOL / RL - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="space-y-6">
        <BbPageHeader Title="Laporan Hasil Penerbitan NOL / RL" Subtitle="Rasio penerbitan No Objection Letter (NOL) vs Refusal Letter (RL) dan alasan penolakan.">
            <Actions>
                <a href="/reports/export/nol-outcomes" download target="_blank" class="inline-flex items-center justify-center rounded-md text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4">
                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                    Ekspor Excel (.xlsx)
                </a>
            </Actions>
        </BbPageHeader>

        @if (_data is null)
        {
            <p class="text-sm text-muted-foreground">Memuat laporan hasil NOL / RL…</p>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
                <BbCard>
                    <BbCardContent Class="pt-4 text-center">
                        <div class="text-3xl font-bold text-foreground">@_data.TotalEvaluated</div>
                        <div class="text-xs text-muted-foreground mt-1">Total Evaluasi Selesai</div>
                    </BbCardContent>
                </BbCard>
                <BbCard Class="border-emerald-200 bg-emerald-50/10">
                    <BbCardContent Class="pt-4 text-center">
                        <div class="text-3xl font-bold text-emerald-700">@_data.NolCount <span class="text-sm font-normal">(@_data.NolPercentage.ToString("F1")%)</span></div>
                        <div class="text-xs text-muted-foreground mt-1">NOL Disetujui</div>
                    </BbCardContent>
                </BbCard>
                <BbCard Class="border-amber-200 bg-amber-50/10">
                    <BbCardContent Class="pt-4 text-center">
                        <div class="text-3xl font-bold text-amber-700">@_data.RlCount <span class="text-sm font-normal">(@_data.RlPercentage.ToString("F1")%)</span></div>
                        <div class="text-xs text-muted-foreground mt-1">RL (Tolak / Bersyarat)</div>
                    </BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Kategori Alasan Penolakan & Catatan Khusus</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <div class="space-y-3">
                        @foreach (var reason in _data.RejectionReasons)
                        {
                            <div class="p-3 border rounded-md bg-background flex items-center justify-between text-xs">
                                <span class="font-semibold text-foreground">@reason.ReasonCategoryName</span>
                                <span class="font-bold text-amber-700">@reason.Count record (@reason.Percentage.ToString("F1")%)</span>
                            </div>
                        }
                    </div>
                </BbCardContent>
            </BbCard>
        }
    </div>
}

@code {
    private NolOutcomesReportDto? _data;

    protected override Capability[] RequiredCapabilities => [Capability.ViewDashboardFunnel];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Laporan", "/reports"),
        new("Hasil NOL / RL", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        _data = await ReportsService.GetNolOutcomesAsync(CurrentUser.Permissions);
    }
}
