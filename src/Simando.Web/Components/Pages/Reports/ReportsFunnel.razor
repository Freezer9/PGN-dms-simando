@page "/reports/funnel"
@inherits AdminPageBase
@using Simando.Application.Reports
@using Simando.Domain.Security
@inject IReportsService ReportsService

<PageTitle>Funnel &amp; Konversi Sales - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="space-y-6">
        <BbPageHeader Title="Laporan Funnel & Konversi Sales (Sales Funnel)" Subtitle="Analisis tingkat konversi dan akumulasi berkas dari direktori awal hingga penerbitan.">
            <Actions>
                <a href="/reports/export/funnel" download target="_blank" class="inline-flex items-center justify-center rounded-md text-xs font-semibold bg-primary text-primary-foreground hover:bg-primary/90 h-9 px-4">
                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                    Ekspor Excel (.xlsx)
                </a>
            </Actions>
        </BbPageHeader>

        @if (_data is null)
        {
            <p class="text-sm text-muted-foreground">Memuat laporan corong penjualan…</p>
        }
        else
        {
            <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                <BbCard>
                    <BbCardContent Class="pt-4 text-center">
                        <div class="text-3xl font-bold text-foreground">@_data.TotalRecords</div>
                        <div class="text-xs text-muted-foreground mt-1">Total Record Masuk (Tahap 1)</div>
                    </BbCardContent>
                </BbCard>
                <BbCard>
                    <BbCardContent Class="pt-4 text-center">
                        <div class="text-3xl font-bold text-emerald-600">@_data.OverallConversionRatePct.ToString("F1")%</div>
                        <div class="text-xs text-muted-foreground mt-1">Tingkat Konversi Akhir (Tahap 8)</div>
                    </BbCardContent>
                </BbCard>
            </div>

            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Rincian Tahap & Konversi</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <div class="space-y-3">
                        @foreach (var stage in _data.Stages)
                        {
                            <div class="p-3 border rounded-md bg-background space-y-2">
                                <div class="flex items-center justify-between text-xs">
                                    <span class="font-semibold text-foreground">Tahap @stage.Stage : @stage.StageName</span>
                                    <span class="font-bold text-primary">@stage.RecordCount record (@stage.ConversionRatePct.ToString("F1")%)</span>
                                </div>
                                <div class="w-full bg-muted rounded-full h-2 overflow-hidden">
                                    <div class="bg-primary h-2 rounded-full transition-all" style="width: @(Math.Max(5, stage.ConversionRatePct))%"></div>
                                </div>
                                <div class="text-[11px] text-muted-foreground text-right inline-flex items-center justify-end gap-1 w-full"><LucideIcon Name="clock" Class="h-3 w-3" /> Rata-rata turnaround: @stage.AvgTurnaroundDays.ToString("F1") hari</div>
                            </div>
                        }
                    </div>
                </BbCardContent>
            </BbCard>
        }
    </div>
}

@code {
    private FunnelReportDto? _data;

    protected override Capability[] RequiredCapabilities => [Capability.ViewDashboardFunnel];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Laporan", "/reports"),
        new("Funnel & Konversi Sales", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        _data = await ReportsService.GetFunnelAsync(CurrentUser.Permissions);
    }
}
