@page "/map"
@inherits AdminPageBase
@implements IAsyncDisposable
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.Geography
@using Simando.Domain.Directory
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@using Simando.Domain.Workflow
@inject ICompanyService Service
@inject IGeographyService GeographyService
@inject IEntityService<IndustryType> IndustryTypeService
@inject IJSRuntime JS

<PageTitle>Peta Sebaran Pelanggan & Prospek - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="flex flex-col md:flex-row gap-4" style="height: calc(100vh - 140px);">
        <!-- Filter & Layer Controls Sidebar -->
        <div class="w-full md:w-72 shrink-0 overflow-y-auto space-y-4">
            <!-- Geographical & Attributes Filter Card -->
            <BbCard>
                <BbCardHeader Class="p-4 pb-2 flex flex-row items-center justify-between">
                    <BbCardTitle>Filter Lokasi &amp; Industri</BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="p-4 pt-0 space-y-2.5">
                    <BbCombobox TValue="string"
                                Value="@_provinceId"
                                ValueChanged="OnProvinceChanged"
                                Options="ProvinceOptions"
                                Placeholder="Provinsi: Semua"
                                SearchPlaceholder="Cari provinsi..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-full h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_regencyId"
                                ValueChanged="OnRegencyChanged"
                                Options="RegencyOptions"
                                Disabled="@(_provinceId == "")"
                                Placeholder="Kota/Kab: Semua"
                                SearchPlaceholder="Cari kota/kab..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-full h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_districtId"
                                ValueChanged="OnDistrictChanged"
                                Options="DistrictOptions"
                                Disabled="@(_regencyId == "")"
                                Placeholder="Kecamatan: Semua"
                                SearchPlaceholder="Cari kecamatan..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-full h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_villageId"
                                ValueChanged="OnVillageChanged"
                                Options="VillageOptions"
                                Disabled="@(_districtId == "")"
                                Placeholder="Kel/Desa: Semua"
                                SearchPlaceholder="Cari kel/desa..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-full h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_industryTypeId"
                                ValueChanged="OnIndustryTypeChanged"
                                Options="IndustryTypeOptions"
                                Placeholder="Jenis Produksi: Semua"
                                SearchPlaceholder="Cari jenis produksi..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-full h-8 text-xs" />

                    <BbSelect TValue="string"
                              Value="@_posisiPelanggan"
                              ValueChanged="OnPosisiPelangganChanged"
                              Options="PosisiPelangganOptions"
                              Placeholder="Posisi Pelanggan: Semua"
                              Class="w-full h-8 text-xs" />

                    <BbSelect TValue="string"
                              Value="@_kawasan"
                              ValueChanged="OnKawasanChanged"
                              Options="KawasanOptions"
                              Placeholder="Kawasan: Semua"
                              Class="w-full h-8 text-xs" />

                    <div class="pt-1">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Href="/directory" Class="w-full gap-1 text-xs">
                            <LucideIcon Name="table" Class="size-3.5" />
                            <span>Buka Tampilan Tabel</span>
                        </BbButton>
                    </div>
                </BbCardContent>
            </BbCard>

            <!-- Layer & Stage Visibility Control -->
            <BbCard>
                <BbCardHeader Class="p-4 pb-2">
                    <BbCardTitle>Tahap &amp; Lapisan Peta</BbCardTitle>
                </BbCardHeader>
                <BbCardContent Class="p-4 pt-0 space-y-2">
                    @foreach (var layer in Layers)
                    {
                        <div class="flex items-center gap-2 text-xs">
                            <BbCheckbox Checked="@_layerVisible[layer.Key]"
                                        CheckedChanged="@((bool v) => OnLayerToggled(layer.Key, v))"
                                        Id="@($"layer-{layer.Key}")" />
                            <span class="inline-block size-2.5 rounded-full shrink-0 border border-black/20" style="background-color: @LayerColors[layer.Key];"></span>
                            <label for="@($"layer-{layer.Key}")" class="cursor-pointer font-medium text-foreground">@layer.Label</label>
                        </div>
                    }
                    <div class="pt-2 border-t mt-2 flex items-center justify-between text-xs text-muted-foreground">
                        <span>Total Titik Terplot:</span>
                        <strong class="text-foreground">@_rows.Count titik</strong>
                    </div>
                </BbCardContent>
            </BbCard>
        </div>

        <!-- Leaflet Map Container -->
        <div class="flex-1 relative min-h-[400px]">
            <div id="@_elementId" style="height: 100%; border-radius: var(--radius); overflow: hidden;" class="border shadow-xs"></div>
        </div>
    </div>
}

@code {
    private static readonly (string Key, string Label)[] Layers =
    [
        ("1", "Tahap 1 — Direktori"),
        ("2", "Tahap 2 — Plotting"),
        ("3", "Tahap 3 — Prospek"),
        ("4", "Tahap 4 — Survei"),
        ("5", "Tahap 5 — A1"),
        ("6", "Tahap 6 — Permohonan NOL"),
        ("nol", "Tahap 8 — NOL Terbit"),
    ];

    private static readonly Dictionary<string, string> LayerColors = new()
    {
        ["1"] = "#94a3b8",
        ["2"] = "#60a5fa",
        ["3"] = "#38bdf8",
        ["4"] = "#34d399",
        ["5"] = "#fbbf24",
        ["6"] = "#fb923c",
        ["nol"] = "#22c55e",
    };

    private readonly string _elementId = $"full-map-{Guid.NewGuid():N}";
    private readonly Dictionary<string, bool> _layerVisible = Layers.ToDictionary(l => l.Key, _ => true);

    private IJSObjectReference? _module;
    private DotNetObjectReference<MapPage>? _dotNetRef;
    private bool _mapReady;
    private bool _canDrag;

    private List<CompanyListItem> _rows = [];
    private List<GeographyOption> _provinces = [];
    private List<GeographyOption> _regencies = [];
    private List<GeographyOption> _districts = [];
    private List<GeographyOption> _villages = [];
    private List<IndustryType> _industryTypes = [];

    private IEnumerable<SelectOption<string>> ProvinceOptions =>
        _provinces.Select(p => new SelectOption<string>(p.Id.ToString(), p.Name))
        .Prepend(new SelectOption<string>("", "Provinsi: Semua"));

    private IEnumerable<SelectOption<string>> RegencyOptions =>
        _regencies.Select(r => new SelectOption<string>(r.Id.ToString(), r.Name))
        .Prepend(new SelectOption<string>("", "Kota/Kab: Semua"));

    private IEnumerable<SelectOption<string>> DistrictOptions =>
        _districts.Select(d => new SelectOption<string>(d.Id.ToString(), d.Name))
        .Prepend(new SelectOption<string>("", "Kecamatan: Semua"));

    private IEnumerable<SelectOption<string>> VillageOptions =>
        _villages.Select(v => new SelectOption<string>(v.Id.ToString(), v.Name))
        .Prepend(new SelectOption<string>("", "Kel/Desa: Semua"));

    private IEnumerable<SelectOption<string>> IndustryTypeOptions =>
        _industryTypes.Select(t => new SelectOption<string>(t.Id.ToString(), t.Name))
        .Prepend(new SelectOption<string>("", "Jenis Produksi: Semua"));

    private static readonly List<SelectOption<string>> PosisiPelangganOptions =
    [
        new("", "Posisi Pelanggan: Semua"),
        new(nameof(PosisiPelanggan.Pengembangan), CompanyLabels.PosisiPelangganLabel(PosisiPelanggan.Pengembangan)),
        new(nameof(PosisiPelanggan.JalurExisting), CompanyLabels.PosisiPelangganLabel(PosisiPelanggan.JalurExisting)),
    ];

    private static readonly List<SelectOption<string>> KawasanOptions =
    [
        new("", "Kawasan: Semua"),
        new(nameof(Kawasan.KawasanIndustri), CompanyLabels.KawasanLabel(Kawasan.KawasanIndustri)),
        new(nameof(Kawasan.NonKawasanIndustri), CompanyLabels.KawasanLabel(Kawasan.NonKawasanIndustri)),
    ];

    private string _provinceId = "";
    private string _regencyId = "";
    private string _districtId = "";
    private string _villageId = "";
    private string _industryTypeId = "";
    private string _posisiPelanggan = "";
    private string _kawasan = "";

    protected override Capability[] RequiredCapabilities => [Capability.ViewCompanyRecords];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Peta", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        _canDrag = CurrentUser.HasCapability(Capability.DropMovePin);
        _provinces = (await GeographyService.GetProvincesAsync()).ToList();
        _industryTypes = (await IndustryTypeService.GetAllAsync()).ToList();
        await ReloadDataAsync();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/full-map.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        _mapReady = true;
        await RenderPinsAsync();
    }

    private async Task ReloadDataAsync()
    {
        var filter = new CompanyListFilter(
            ParseGuid(_provinceId), ParseGuid(_regencyId), ParseGuid(_districtId), ParseGuid(_villageId),
            ParseGuid(_industryTypeId),
            PosisiPelanggan: ParseEnum<PosisiPelanggan>(_posisiPelanggan),
            Kawasan: ParseEnum<Kawasan>(_kawasan));

        _rows = (await Service.GetListAsync(filter))
            .Where(r => r.Latitude is not null && r.Longitude is not null)
            .ToList();

        await RenderPinsAsync();
    }

    private async Task RenderPinsAsync()
    {
        if (!_mapReady || _module is null)
        {
            return;
        }

        var pins = _rows.Select(r => new
        {
            id = r.Id,
            lat = r.Latitude,
            lng = r.Longitude,
            stageBucket = StageBucket(r),
            dashed = r.PosisiPelanggan == PosisiPelanggan.Pengembangan,
            size = 1.0,
            nomor = r.Nomor,
            nama = r.NamaPerusahaan,
            industryTypeName = r.IndustryTypeName,
            posisiPelangganLabel = r.PosisiPelanggan is null ? null : CompanyLabels.PosisiPelangganLabel(r.PosisiPelanggan),
            stageLabel = $"Tahap {r.CurrentStage} {CompanyLabels.StageLabel(r.CurrentStage)}",
            salesUserName = r.SalesUserName,
        }).ToList();

        await _module.InvokeVoidAsync("dispose", _elementId);
        await _module.InvokeVoidAsync("initMap", _elementId, _dotNetRef, pins, _canDrag);

        foreach (var (key, visible) in _layerVisible)
        {
            if (!visible)
            {
                await _module.InvokeVoidAsync("setLayerVisible", _elementId, key, false);
            }
        }
    }

    private static string StageBucket(CompanyListItem c) =>
        c.Status == RecordStatus.IssuedNol ? "nol" : Math.Min(c.CurrentStage, (byte)6).ToString();

    private async Task OnProvinceChanged(string value)
    {
        _provinceId = value;
        _regencyId = _districtId = _villageId = "";
        _regencies = value == "" ? [] : (await GeographyService.GetRegenciesAsync(Guid.Parse(value))).ToList();
        _districts = [];
        _villages = [];
        await ReloadDataAsync();
    }

    private async Task OnRegencyChanged(string value)
    {
        _regencyId = value;
        _districtId = _villageId = "";
        _districts = value == "" ? [] : (await GeographyService.GetDistrictsAsync(Guid.Parse(value))).ToList();
        _villages = [];
        await ReloadDataAsync();
    }

    private async Task OnDistrictChanged(string value)
    {
        _districtId = value;
        _villageId = "";
        _villages = value == "" ? [] : (await GeographyService.GetVillagesAsync(Guid.Parse(value))).ToList();
        await ReloadDataAsync();
    }

    private async Task OnVillageChanged(string value)
    {
        _villageId = value;
        await ReloadDataAsync();
    }

    private async Task OnIndustryTypeChanged(string value)
    {
        _industryTypeId = value;
        await ReloadDataAsync();
    }

    private async Task OnPosisiPelangganChanged(string value)
    {
        _posisiPelanggan = value;
        await ReloadDataAsync();
    }

    private async Task OnKawasanChanged(string value)
    {
        _kawasan = value;
        await ReloadDataAsync();
    }

    private async Task OnLayerToggled(string key, bool visible)
    {
        _layerVisible[key] = visible;
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("setLayerVisible", _elementId, key, visible);
        }
    }

    [JSInvokable]
    public async Task OnPinDragged(Guid companyId, double lat, double lng)
    {
        var result = await Service.UpdateLocationAsync(companyId, lat, lng, CurrentUser.UserId, CurrentUser.Permissions);
        if (!result.Succeeded && _module is not null)
        {
            var original = _rows.FirstOrDefault(r => r.Id == companyId);
            if (original is { Latitude: { } origLat, Longitude: { } origLng })
            {
                await _module.InvokeVoidAsync("revertPin", _elementId, companyId, origLat, origLng);
            }
        }
    }

    private static Guid? ParseGuid(string value) => value == "" ? null : Guid.Parse(value);

    private static TEnum? ParseEnum<TEnum>(string value) where TEnum : struct, Enum =>
        value == "" ? null : Enum.Parse<TEnum>(value);

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _elementId);
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}
