@page "/plotting"
@inherits AdminPageBase
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.Geography
@using Simando.Domain.Directory
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@using Simando.Domain.Workflow
@inject ICompanyService Service
@inject IGeographyService GeographyService
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Data Plotting - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Data Plotting Perusahaan & Area" Subtitle="@($"Pemetaan posisi pelanggan, kawasan industri, dan penugasan Sales ({_totalCount} perusahaan).")">
        <Actions>
            <div class="flex items-center rounded-md border p-0.5 bg-muted text-muted-foreground">
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="h-7 px-2.5 bg-background text-foreground shadow-sm">
                    <LucideIcon Name="table" Class="size-3.5 mr-1" /> Tabel
                </BbButton>
                <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" Class="h-7 px-2.5 text-muted-foreground hover:text-foreground" Href="/map">
                    <LucideIcon Name="map" Class="size-3.5 mr-1" /> Peta
                </BbButton>
            </div>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <div class="flex flex-col gap-3 mb-4">
                <div class="flex flex-wrap items-center gap-2">
                    <div class="relative flex-1 min-w-[220px] max-w-md">
                        <LucideIcon Name="search" Class="size-3.5 absolute left-2.5 top-1/2 -translate-y-1/2 text-muted-foreground pointer-events-none z-10" />
                        <BbInput Type="InputType.Text"
                                 Value="@_searchTerm"
                                 ValueChanged="OnSearchTermChanged"
                                 UpdateTiming="UpdateTiming.Debounced"
                                 DebounceInterval="300"
                                 Placeholder="Cari nama perusahaan atau nomor..."
                                 Class="h-8 text-xs pl-8 w-full" />
                    </div>

                    @if (HasActiveFilters)
                    {
                        <BbButton Variant="ButtonVariant.Ghost" Size="ButtonSize.Small" OnClick="ResetFiltersAsync" Class="h-8 text-xs text-muted-foreground hover:text-foreground">
                            <LucideIcon Name="x" Class="size-3.5 mr-1" /> Reset Filter
                        </BbButton>
                    }
                </div>

                <div class="flex flex-wrap gap-2">
                    <BbCombobox TValue="string"
                                Value="@_provinceId"
                                ValueChanged="OnProvinceChanged"
                                Options="ProvinceOptions"
                                Placeholder="Provinsi: Semua"
                                SearchPlaceholder="Cari provinsi..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-44 h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_regencyId"
                                ValueChanged="OnRegencyChanged"
                                Options="RegencyOptions"
                                Disabled="@(_provinceId == "")"
                                Placeholder="Kota/Kab: Semua"
                                SearchPlaceholder="Cari kota/kab..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-44 h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_districtId"
                                ValueChanged="OnDistrictChanged"
                                Options="DistrictOptions"
                                Disabled="@(_regencyId == "")"
                                Placeholder="Kecamatan: Semua"
                                SearchPlaceholder="Cari kecamatan..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-44 h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_villageId"
                                ValueChanged="OnVillageChanged"
                                Options="VillageOptions"
                                Disabled="@(_districtId == "")"
                                Placeholder="Kel/Desa: Semua"
                                SearchPlaceholder="Cari kel/desa..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-44 h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_posisiPelanggan"
                                ValueChanged="OnPosisiPelangganChanged"
                                Options="PosisiPelangganOptions"
                                Placeholder="Posisi Pelanggan: Semua"
                                SearchPlaceholder="Cari posisi..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-56 h-8 text-xs" />

                    <BbCombobox TValue="string"
                                Value="@_kawasan"
                                ValueChanged="OnKawasanChanged"
                                Options="KawasanOptions"
                                Placeholder="Kawasan: Semua"
                                SearchPlaceholder="Cari kawasan..."
                                EmptyMessage="Tidak ditemukan"
                                Class="w-48 h-8 text-xs" />
                </div>
            </div>

            <BbDataTable TData="CompanyListItem" Data="_rows" InitialPageSize="25" ShowToolbar="false" AriaLabel="Data plotting perusahaan">
                <Columns>
                    <BbDataTableColumn TData="CompanyListItem" TValue="string" Header="Perusahaan">
                        <CellTemplate Context="c">
                            <div class="flex flex-col">
                                <a href="/companies/@c.Id" class="font-medium text-foreground hover:underline">@c.NamaPerusahaan</a>
                                <span class="text-xs text-muted-foreground">@c.IndustryTypeName · <span class="font-mono text-[11px]" title="Nomor Registrasi: @c.Nomor">@c.Nomor</span></span>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CompanyListItem" TValue="string" Header="Posisi Pelanggan" Width="160px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="c">
                            @if (c.PosisiPelanggan is not null)
                            {
                                <BbBadge Variant="@(c.PosisiPelanggan == PosisiPelanggan.JalurExisting ? BadgeVariant.Default : BadgeVariant.Outline)">
                                    @CompanyLabels.PosisiPelangganLabel(c.PosisiPelanggan)
                                </BbBadge>
                            }
                            else
                            {
                                <span class="text-muted-foreground">-</span>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CompanyListItem" TValue="string" Header="Kawasan" Width="160px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="c">
                            @if (c.Kawasan is not null)
                            {
                                <BbBadge Variant="@(c.Kawasan == Kawasan.KawasanIndustri ? BadgeVariant.Secondary : BadgeVariant.Outline)">
                                    @CompanyLabels.KawasanLabel(c.Kawasan)
                                </BbBadge>
                            }
                            else
                            {
                                <span class="text-muted-foreground">-</span>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CompanyListItem" TValue="string" Header="Sales" Width="150px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="c">
                            <span class="@(c.SalesUserName is null ? "text-muted-foreground italic text-xs" : "")">
                                @(c.SalesUserName ?? "Belum ditugaskan")
                            </span>
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="CompanyListItem" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="c">
                            <div class="flex items-center justify-center">
                                @if (!_canEdit || c.Status != RecordStatus.Draft)
                                {
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" Href="@($"/companies/{c.Id}")" AriaLabel="Lihat Detail">
                                                <LucideIcon Name="eye" Class="size-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Lihat Detail</BbTooltipContent>
                                    </BbTooltip>
                                }
                                else if (c.CurrentStage <= 1)
                                {
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" Href="@($"/companies/{c.Id}/plotting")" AriaLabel="Lengkapi Plotting">
                                                <LucideIcon Name="file-text" Class="size-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Lengkapi Plotting</BbTooltipContent>
                                    </BbTooltip>
                                }
                                else if (c.CurrentStage == 2)
                                {
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => ProspekAsync(c))" AriaLabel="Prospek">
                                                <LucideIcon Name="trending-up" Class="size-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Prospek</BbTooltipContent>
                                    </BbTooltip>
                                }
                                else
                                {
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" Href="@($"/companies/{c.Id}/plotting")" AriaLabel="Ubah Plotting">
                                                <LucideIcon Name="pencil" Class="size-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah Plotting</BbTooltipContent>
                                    </BbTooltip>
                                }
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Tidak ada perusahaan" Description="Belum ada perusahaan yang cocok dengan filter ini." />
                </EmptyTemplate>
            </BbDataTable>

            @if (TotalPages > 1)
            {
                <div class="flex items-center justify-between mt-4 px-2 text-xs text-muted-foreground">
                    <div>
                        Menampilkan @((_currentPage - 1) * _pageSize + 1) – @Math.Min(_currentPage * _pageSize, _totalCount) dari @_totalCount perusahaan
                    </div>
                    <div class="flex items-center gap-2">
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(_currentPage <= 1)" OnClick="PrevPageAsync">
                            Sebelumnya
                        </BbButton>
                        <span>Halaman @_currentPage dari @TotalPages</span>
                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(_currentPage >= TotalPages)" OnClick="NextPageAsync">
                            Selanjutnya
                        </BbButton>
                    </div>
                </div>
            }
        </BbCardContent>
    </BbCard>
}

@code {
    private List<CompanyListItem> _rows = [];
    private List<GeographyOption> _provinces = [];
    private List<GeographyOption> _regencies = [];
    private List<GeographyOption> _districts = [];
    private List<GeographyOption> _villages = [];

    private string _provinceId = "";
    private string _regencyId = "";
    private string _districtId = "";
    private string _villageId = "";
    private string _posisiPelanggan = "";
    private string _kawasan = "";
    private string _searchTerm = "";

    private bool _canEdit;

    private bool HasActiveFilters => !string.IsNullOrEmpty(_provinceId) ||
                                      !string.IsNullOrEmpty(_regencyId) ||
                                      !string.IsNullOrEmpty(_districtId) ||
                                      !string.IsNullOrEmpty(_villageId) ||
                                      !string.IsNullOrEmpty(_posisiPelanggan) ||
                                      !string.IsNullOrEmpty(_kawasan) ||
                                      !string.IsNullOrWhiteSpace(_searchTerm);

    protected override Capability[] RequiredCapabilities => [Capability.ViewCompanyRecords];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Data Plotting", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        _canEdit = CurrentUser.HasCapability(Capability.EditStages1To3);
        _provinces = (await GeographyService.GetProvincesAsync()).ToList();
        await ReloadAsync();
    }

    private int _currentPage = 1;
    private int _pageSize = 25;
    private int _totalCount = 0;
    private int TotalPages => (int)Math.Ceiling((double)_totalCount / _pageSize);

    private IEnumerable<SelectOption<string>> ProvinceOptions =>
        _provinces.Select(p => new SelectOption<string>(p.Id.ToString(), p.Name))
            .Prepend(new SelectOption<string>("", "Provinsi: Semua"));

    private IEnumerable<SelectOption<string>> RegencyOptions =>
        _regencies.Select(r => new SelectOption<string>(r.Id.ToString(), r.Name))
            .Prepend(new SelectOption<string>("", "Kota/Kab: Semua"));

    private IEnumerable<SelectOption<string>> DistrictOptions =>
        _districts.Select(d => new SelectOption<string>(d.Id.ToString(), d.Name))
            .Prepend(new SelectOption<string>("", "Kecamatan: Semua"));

    private IEnumerable<SelectOption<string>> VillageOptions =>
        _villages.Select(v => new SelectOption<string>(v.Id.ToString(), v.Name))
            .Prepend(new SelectOption<string>("", "Kel/Desa: Semua"));

    private IEnumerable<SelectOption<string>> PosisiPelangganOptions => new List<SelectOption<string>>
    {
        new("", "Posisi Pelanggan: Semua"),
        new(nameof(PosisiPelanggan.Pengembangan), CompanyLabels.PosisiPelangganLabel(PosisiPelanggan.Pengembangan)),
        new(nameof(PosisiPelanggan.JalurExisting), CompanyLabels.PosisiPelangganLabel(PosisiPelanggan.JalurExisting))
    };

    private IEnumerable<SelectOption<string>> KawasanOptions => new List<SelectOption<string>>
    {
        new("", "Kawasan: Semua"),
        new(nameof(Kawasan.KawasanIndustri), CompanyLabels.KawasanLabel(Kawasan.KawasanIndustri)),
        new(nameof(Kawasan.NonKawasanIndustri), CompanyLabels.KawasanLabel(Kawasan.NonKawasanIndustri))
    };

    private async Task ReloadAsync()
    {
        var filter = new CompanyListFilter(
            ParseGuid(_provinceId), ParseGuid(_regencyId), ParseGuid(_districtId), ParseGuid(_villageId),
            PosisiPelanggan: ParseEnum<PosisiPelanggan>(_posisiPelanggan),
            Kawasan: ParseEnum<Kawasan>(_kawasan),
            SearchTerm: string.IsNullOrWhiteSpace(_searchTerm) ? null : _searchTerm,
            Page: _currentPage,
            PageSize: _pageSize);

        var paged = await Service.GetPagedListAsync(filter);
        _rows = paged.Items.ToList();
        _totalCount = paged.TotalCount;
    }

    private async Task NextPageAsync()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            await ReloadAsync();
        }
    }

    private async Task PrevPageAsync()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await ReloadAsync();
        }
    }

    private async Task OnSearchTermChanged(string value)
    {
        _searchTerm = value;
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnProvinceChanged(string value)
    {
        _provinceId = value;
        _regencyId = _districtId = _villageId = "";
        _regencies = value == "" ? [] : (await GeographyService.GetRegenciesAsync(Guid.Parse(value))).ToList();
        _districts = [];
        _villages = [];
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnRegencyChanged(string value)
    {
        _regencyId = value;
        _districtId = _villageId = "";
        _districts = value == "" ? [] : (await GeographyService.GetDistrictsAsync(Guid.Parse(value))).ToList();
        _villages = [];
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnDistrictChanged(string value)
    {
        _districtId = value;
        _villageId = "";
        _villages = value == "" ? [] : (await GeographyService.GetVillagesAsync(Guid.Parse(value))).ToList();
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnVillageChanged(string value)
    {
        _villageId = value;
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnPosisiPelangganChanged(string value)
    {
        _posisiPelanggan = value;
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task OnKawasanChanged(string value)
    {
        _kawasan = value;
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task ResetFiltersAsync()
    {
        _provinceId = _regencyId = _districtId = _villageId = _posisiPelanggan = _kawasan = _searchTerm = "";
        _regencies = _districts = _villages = [];
        _currentPage = 1;
        await ReloadAsync();
    }

    private async Task ProspekAsync(CompanyListItem company)
    {
        var confirm = await DialogService.ConfirmAsync(
            "Lanjutkan ke Prospek?",
            $"\"{company.NamaPerusahaan}\" akan lanjut ke tahap 3 - Prospek.",
            new ConfirmDialogOptions { ConfirmText = "Lanjutkan" });
        if (!confirm.Confirmed)
        {
            return;
        }

        var result = await Service.PromoteToProspekAsync(company.Id, CurrentUser.UserId, CurrentUser.Permissions);
        if (!result.Succeeded)
        {
            ToastService.Error(result.Error ?? "Gagal melanjutkan ke tahap Prospek.", "Gagal");
            await DialogService.AlertAsync("Tidak dapat melanjutkan", result.Error!);
            return;
        }

        await ReloadAsync();
        ToastService.Success($"Perusahaan \"{company.NamaPerusahaan}\" berhasil dilanjutkan ke tahap Prospek.", "Prospek");
    }

    private static Guid? ParseGuid(string value) => value == "" ? null : Guid.Parse(value);

    private static TEnum? ParseEnum<TEnum>(string value) where TEnum : struct, Enum =>
        value == "" ? null : Enum.Parse<TEnum>(value);
}
