@page "/companies/{CompanyId:guid}"
@page "/companies/{CompanyId:guid}/{Tab?}"
@inherits AdminPageBase
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.RecordHub
@using Simando.Application.Security
@using Simando.Application.Workflow
@using Simando.Domain.Audit
@using Simando.Domain.Directory
@using Simando.Domain.Security
@using Simando.Domain.Workflow
@inject ICompanyDetailService DetailService
@inject ICompanyService CompanyService
@inject IWorkflowService WorkflowService
@inject Simando.Application.Security.IUserService UserService
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>@(_detail?.NamaPerusahaan ?? "Detail Perusahaan") - DMS Simando</PageTitle>

@if (Authorized && _detail is not null)
{
    <div class="flex flex-col flex-1 min-h-[calc(100vh-8.5rem)]">
        @if (_detail.CanAct || _detail.CanSubmit)
        {
            <div class="mb-4 p-4 rounded-lg border border-primary/30 bg-primary/5 flex items-center gap-3 shadow-xs">
                <div class="p-2 rounded-full bg-primary/10 text-primary shrink-0">
                    <LucideIcon Name="zap" Class="size-5" />
                </div>
                <div>
                    <h4 class="font-semibold text-sm text-foreground">Tindakan Diperlukan</h4>
                    <p class="text-xs text-muted-foreground">
                        @if (_detail.CanSubmit)
                        {
                            <span>Berkas ini telah siap untuk diajukan ke tahap persetujuan berikutnya. Gunakan tombol di bagian bawah untuk mengajukan.</span>
                        }
                        else if (_detail.CanAct)
                        {
                            <span>Berkas ini memerlukan tindakan persetujuan Anda sebagai <strong>@(_detail.HolderLabel ?? "Petugas")</strong>. Gunakan tombol di bagian bawah untuk memproses persetujuan.</span>
                        }
                    </p>
                </div>
            </div>
        }

        <div class="grid grid-cols-1 lg:grid-cols-3 gap-4 pb-6">
        <div class="lg:col-span-2 space-y-4">
            <BbCard>
                <BbCardContent Class="pt-6">
                    <div class="flex flex-col md:flex-row md:items-start md:justify-between gap-4">
                        <div class="space-y-1">
                            <h1 class="text-xl font-semibold text-foreground">@_detail.NamaPerusahaan</h1>
                            <p class="text-xs text-muted-foreground">@_detail.Nomor · @_detail.IndustryTypeName · @_detail.LocationLabel</p>
                            <div class="pt-1 flex flex-wrap items-center gap-2 text-xs">
                                <span class="inline-flex items-center gap-1 font-medium bg-muted/60 px-2 py-0.5 rounded border border-border/50 text-foreground">
                                    <LucideIcon Name="user" Class="size-3 text-muted-foreground" /> Sales Rep: <strong class="text-foreground">@_detail.SalesRepName</strong>
                                </span>
                                <span class="inline-flex items-center gap-1 font-medium bg-muted/60 px-2 py-0.5 rounded border border-border/50 text-foreground">
                                    <LucideIcon Name="map-pin" Class="size-3 text-muted-foreground" /> Area: <strong class="text-foreground">@_detail.AreaName</strong>
                                </span>
                                <span class="inline-flex items-center gap-1 font-medium bg-muted/60 px-2 py-0.5 rounded border border-border/50 text-foreground">
                                    <LucideIcon Name="globe" Class="size-3 text-muted-foreground" /> Region: <strong class="text-foreground">@_detail.RegionName</strong>
                                </span>
                            </div>
                        </div>
                        <div class="border rounded-md p-3 min-w-56 bg-card">
                            @RenderStatusCard()
                        </div>
                    </div>

                    <div class="mt-4 pt-3 border-t border-border/40 flex items-center gap-1 overflow-x-auto pb-1">
                        @for (var i = 0; i < CompanyLabels.StageLabels.Length; i++)
                        {
                            var stageNumber = (byte)(i + 1);
                            var tabValue = StageTabValues[i];
                            var isCompleted = stageNumber <= _detail.CurrentStage;
                            var isActive = stageNumber == _detail.CurrentStage + 1;
                            var clickable = stageNumber <= _detail.CurrentStage + 1;
                            <button type="button" disabled="@(!clickable)"
                                    class="@($"flex flex-col items-center gap-1 px-2.5 py-1.5 text-xs rounded transition-colors {(clickable ? "cursor-pointer hover:bg-muted text-foreground" : "text-muted-foreground/60")}")"
                                    @onclick="@(() => NavigateToTab(tabValue))">
                                @if (isCompleted)
                                {
                                    <span class="flex h-5 w-5 items-center justify-center rounded-full bg-emerald-600 text-white text-[10px] font-semibold shadow-xs">
                                        <LucideIcon Name="check" Class="h-3 w-3" />
                                    </span>
                                }
                                else if (isActive)
                                {
                                    <span class="flex h-5 w-5 items-center justify-center rounded-full border-2 border-primary bg-primary/10 text-primary text-[11px] font-bold ring-2 ring-primary/30">
                                        @stageNumber
                                    </span>
                                }
                                else
                                {
                                    <span class="flex h-5 w-5 items-center justify-center rounded-full border border-border bg-muted/40 text-muted-foreground/60 text-[11px]">
                                        @stageNumber
                                    </span>
                                }
                                <span class="@(isActive ? "font-semibold text-primary" : isCompleted ? "font-medium text-foreground" : "font-normal text-muted-foreground/60")">@CompanyLabels.StageLabels[i]</span>
                            </button>
                            @if (i < CompanyLabels.StageLabels.Length - 1)
                            {
                                <span class="@($"h-0.5 w-4 shrink-0 self-center my-auto {(isCompleted ? "bg-emerald-600" : "bg-border")}")"></span>
                            }
                        }
                    </div>
                </BbCardContent>
            </BbCard>

            <BbCard>
                <BbCardContent Class="pt-6">
                    <BbTabs Value="@_activeTab" DefaultValue="ringkasan" ValueChanged="@((string v) => NavigateToTab(v))">
                        <BbTabsList>
                            <BbTabsTrigger Value="ringkasan" Disabled="@(!IsTabAccessible("ringkasan"))">Ringkasan</BbTabsTrigger>
                            <BbTabsTrigger Value="plotting" Disabled="@(!IsTabAccessible("plotting"))">Plotting</BbTabsTrigger>
                            <BbTabsTrigger Value="prospek" Disabled="@(!IsTabAccessible("prospek"))">Prospek</BbTabsTrigger>
                            <BbTabsTrigger Value="survei" Disabled="@(!IsTabAccessible("survei"))">Survei</BbTabsTrigger>
                            <BbTabsTrigger Value="a1" Disabled="@(!IsTabAccessible("a1"))">A1</BbTabsTrigger>
                            <BbTabsTrigger Value="nol" Disabled="@(!IsTabAccessible("nol"))">NOL</BbTabsTrigger>
                            @if (CurrentUser.HasCapability(Capability.EditEvaluation))
                            {
                                <BbTabsTrigger Value="evaluasi" Disabled="@(!IsTabAccessible("evaluasi"))">Evaluasi</BbTabsTrigger>
                            }
                            @if (CurrentUser.HasCapability(Capability.IssueNolRl))
                            {
                                <BbTabsTrigger Value="penerbitan" Disabled="@(!IsTabAccessible("penerbitan"))">Penerbitan</BbTabsTrigger>
                            }
                            <BbTabsTrigger Value="dokumen" Disabled="@(!IsTabAccessible("dokumen"))">Dokumen</BbTabsTrigger>
                        </BbTabsList>

                        <BbTabsContent Value="ringkasan">
                            @RenderRingkasan()
                        </BbTabsContent>
                        <BbTabsContent Value="plotting">
                            @RenderPlotting()
                        </BbTabsContent>
                        <BbTabsContent Value="prospek">
                            @RenderProspek()
                        </BbTabsContent>
                        <BbTabsContent Value="survei">
                            <div class="mb-4 flex justify-end">
                                <a href="/documents/company/@CompanyId/kk0" download target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                                    Unduh Template KK0 (.docx)
                                </a>
                            </div>
                            <SurveyForm CompanyId="@CompanyId" CanEdit="@_canEditSurvey" ActorUserId="@CurrentUser.UserId" Actor="@CurrentUser.Permissions" Surveyors="_surveyors" OnSaved="OnSurveySaved" />
                        </BbTabsContent>
                        <BbTabsContent Value="a1">
                            <div class="mb-4 flex justify-end">
                                <a href="/documents/company/@CompanyId/a1" download target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                                    Unduh Template A1 (.docx)
                                </a>
                            </div>
                            <A1RegistrationForm CompanyId="@CompanyId" CanEdit="@_canEditSurvey" ActorUserId="@CurrentUser.UserId" Actor="@CurrentUser.Permissions" OnSaved="OnA1Saved" />
                        </BbTabsContent>
                        <BbTabsContent Value="nol">
                            <div class="mb-4 flex justify-end">
                                <a href="/documents/company/@CompanyId/nol-request" download target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                                    Unduh Template Permohonan NOL (.docx)
                                </a>
                            </div>
                            <NolRequestForm CompanyId="@CompanyId" CanEdit="@_canEditSurvey" ActorUserId="@CurrentUser.UserId" Actor="@CurrentUser.Permissions" />
                        </BbTabsContent>
                        <BbTabsContent Value="evaluasi">
                            <div class="mb-4 flex justify-end">
                                <a href="/documents/company/@CompanyId/evaluation" download target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                                    Unduh Template Resume Evaluasi (.docx)
                                </a>
                            </div>
                            <NolEvaluationForm CompanyId="@CompanyId" CanEdit="@(CurrentUser.HasCapability(Capability.EditEvaluation))" ActorUserId="@CurrentUser.UserId" Actor="@CurrentUser.Permissions" />
                        </BbTabsContent>
                        <BbTabsContent Value="penerbitan">
                            <div class="mb-4 flex justify-end">
                                <a href="/documents/company/@CompanyId/nol-issuance" download target="_blank" class="inline-flex items-center justify-center rounded-md text-sm font-medium transition-colors bg-secondary text-secondary-foreground hover:bg-secondary/80 h-9 px-4 py-2">
                                    <LucideIcon Name="download" Class="mr-2 h-4 w-4" />
                                    Unduh Surat Penerbitan NOL/RL (.docx)
                                </a>
                            </div>
                            <NolIssuanceForm CompanyId="@CompanyId" CanEdit="@(CurrentUser.HasCapability(Capability.IssueNolRl))" ActorUserId="@CurrentUser.UserId" Actor="@CurrentUser.Permissions" />
                        </BbTabsContent>
                        <BbTabsContent Value="dokumen">
                            <DokumenTab CompanyId="@CompanyId" CanUpload="@_canEditSurvey" ActorUserId="@CurrentUser.UserId" />
                        </BbTabsContent>
                    </BbTabs>
                </BbCardContent>
            </BbCard>
        </div>

        <div class="lg:col-span-1">
            <BbCard Class="shadow-none">
                <BbCardHeader>
                    <BbCardTitle>Lini Masa</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    @RenderTimeline()
                </BbCardContent>
            </BbCard>
        </div>
    </div>

        @if (_detail.CanSubmit || _detail.CanAct)
        {
            <div class="mt-auto sticky bottom-0 -mx-4 -mb-4 md:-mx-8 md:-mb-8 bg-background border-t p-4 md:p-8 md:py-4 flex justify-end gap-2 z-10 shadow-sm">
            @if (_detail.CanSubmit)
            {
                <BbButton OnClick="AjukanAsync" Disabled="@(!IsReadyToSubmit())">Ajukan untuk Persetujuan</BbButton>
            }
            @if (_detail.CanAct)
            {
                <BbButton Variant="ButtonVariant.Outline" OnClick="TolakAsync">Tolak</BbButton>
                <BbButton Variant="ButtonVariant.Outline" OnClick="RevisiAsync">Minta Revisi</BbButton>
                @if (_detail.Status == RecordStatus.Approval)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="TidakLayakAsync">Tidak Layak</BbButton>
                }
                @if (_detail.CanChooseReviewers)
                {
                    <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _reviewerDialogOpen = true)">Tetapkan Reviewer</BbButton>
                }
                <BbButton OnClick="SetujuAsync">Setuju</BbButton>
            }
        </div>
    }
</div>
}

<BbDialog @bind-Open="_reviewerDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Tetapkan Reviewer</BbDialogTitle>
            <BbDialogDescription>Pilih 2 atau 3 reviewer untuk berkas ini.</BbDialogDescription>
        </BbDialogHeader>
        <div class="py-4">
            <BbFormFieldCheckboxGroup TValue="Guid" @bind-Values="_selectedReviewers" Label="Reviewer">
                @foreach (var candidate in _reviewerCandidates)
                {
                    <BbCheckboxGroupItem TValue="Guid" Value="@candidate.Id" Label="@candidate.FullName" />
                }
            </BbFormFieldCheckboxGroup>
            @if (_reviewerError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger" Class="mt-2">
                    <BbAlertDescription>@_reviewerError</BbAlertDescription>
                </BbAlert>
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _reviewerDialogOpen = false)">Batal</BbButton>
            <BbButton OnClick="ChooseReviewersAsync" Disabled="@(_selectedReviewers.Count is < 2 or > 3)">Simpan</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_contactDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>@(_editingContactId is null ? "Tambah PIC" : "Ubah PIC")</BbDialogTitle>
        </BbDialogHeader>
        <EditForm Model="_contactForm" OnValidSubmit="SaveContactAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <div class="py-4 space-y-3">
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.Nama" Label="Nama *" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.Jabatan" Label="Jabatan *" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.Email" Label="Email" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.NoHp" Label="No. HP" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.LinkedIn" Label="LinkedIn" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.Instagram" Label="Instagram" />
                <BbFormFieldInput TValue="string" @bind-Value="_contactForm.Facebook" Label="Facebook" />
                <BbFormFieldCheckbox @bind-Checked="_contactForm.IsPrimary" Label="Kontak utama" />
                @if (_contactError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_contactError</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _contactDialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private static readonly string[] StageTabValues =
        ["ringkasan", "plotting", "prospek", "survei", "a1", "nol", "evaluasi", "penerbitan"];

    [Parameter]
    public Guid CompanyId { get; set; }

    // Child-route tab segment — /companies/{id}/plotting, /companies/{id}/prospect,
    // etc. (docs/design/frontend/01-shell-and-navigation.md#route-design: "Stage
    // tabs are child routes... deep-linkable, back-button friendly"). Null on the
    // bare /companies/{id} route, which is the Ringkasan tab.
    [Parameter]
    public string? Tab { get; set; }

    private CompanyDetail? _detail;
    private List<TimelineEntry> _timeline = [];
    private bool _showFullTimeline;
    private string _activeTab = "ringkasan";
    private bool _canEdit;
    private bool _canEditSurvey;

    private bool _reviewerDialogOpen;
    private List<UserListItem> _reviewerCandidates = [];
    private IReadOnlyCollection<Guid> _selectedReviewers = [];
    private string? _reviewerError;

    private PlottingDetail? _plotting;
    private PlottingFormModel _plottingForm = new();
    private string? _plottingError;
    private List<SelectOption<Guid?>> _salesAreaUsers = [];
    private List<SelectOption<Guid?>> _surveyors = [];

    private List<ContactDetail> _contacts = [];
    private bool _contactDialogOpen;
    private Guid? _editingContactId;
    private ContactFormModel _contactForm = new();
    private string? _contactError;

    private sealed class PlottingFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Sales wajib dipilih.")]
        public Guid? SalesUserId { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Posisi Pelanggan wajib dipilih.")]
        public PosisiPelanggan? PosisiPelanggan { get; set; }

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Kawasan wajib dipilih.")]
        public Kawasan? Kawasan { get; set; }
    }

    private sealed class ContactFormModel
    {
        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Nama wajib diisi.")]
        public string Nama { get; set; } = "";

        [System.ComponentModel.DataAnnotations.Required(ErrorMessage = "Jabatan wajib diisi.")]
        public string Jabatan { get; set; } = "";

        public string? Email { get; set; }
        public string? NoHp { get; set; }
        public string? LinkedIn { get; set; }
        public string? Instagram { get; set; }
        public string? Facebook { get; set; }
        public bool IsPrimary { get; set; }
    }

    protected override Capability[] RequiredCapabilities => [Capability.ViewCompanyRecords];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Direktori", null),
        new("Detail Perusahaan", null),
    ];

    private static readonly HashSet<string> ValidTabs = new(StringComparer.OrdinalIgnoreCase)
    {
        "ringkasan", "plotting", "prospek", "survei", "a1", "nol", "evaluasi", "penerbitan", "dokumen"
    };

    protected override async Task OnAuthorizedInitializedAsync() => await LoadAsync();

    // AdminPageBase.OnInitializedAsync (which calls the line above) only runs
    // once per component instance; OnParametersSet is what re-fires when Tab
    // changes via NavigateToTab below — CompanyId is unchanged between tabs,
    // so only the active tab needs updating, not a full reload.
    private bool IsTabAccessible(string tab)
    {
        if (_detail is null) return false;
        return tab switch
        {
            "ringkasan" or "dokumen" => true,
            "plotting" => _detail.CurrentStage >= 1,
            "prospek" => _detail.CurrentStage >= 2,
            "survei" => _detail.CurrentStage >= 3,
            "a1" => _detail.CurrentStage >= 4,
            "nol" => _detail.CurrentStage >= 5,
            "evaluasi" => _detail.CurrentStage >= 6,
            "penerbitan" => _detail.CurrentStage >= 7,
            _ => false
        };
    }

    private bool IsReadyToSubmit()
    {
        if (_detail is null || !_detail.CanSubmit) return false;
        if (_detail.CurrentStage < 6) return false;
        return true;
    }

    protected override void OnParametersSet()
    {
        var normalized = Tab?.ToLowerInvariant();
        var target = !string.IsNullOrWhiteSpace(normalized) && ValidTabs.Contains(normalized)
            ? normalized
            : "ringkasan";

        _activeTab = IsTabAccessible(target) ? target : "ringkasan";
    }

    private void NavigateToTab(string tab) =>
        Nav.NavigateTo(tab == "ringkasan" ? $"/companies/{CompanyId}" : $"/companies/{CompanyId}/{tab}");

    private async Task LoadAsync()
    {
        _detail = await DetailService.GetDetailAsync(CompanyId, CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);
        if (_detail is null || !PermissionEvaluator.CanViewRecord(CurrentUser.Permissions, _detail.AreaId, _detail.RegionId))
        {
            Nav.NavigateTo("/access-denied");
            return;
        }

        _timeline = (await DetailService.GetTimelineAsync(CompanyId)).ToList();
        BreadcrumbState.Set(new("Beranda", "/"), new("Direktori", null), new(_detail.NamaPerusahaan, null));

        _canEdit = _detail.Status == RecordStatus.Draft && CurrentUser.HasCapability(Capability.EditStages1To3);
        _canEditSurvey = _detail.Status == RecordStatus.Draft && CurrentUser.HasCapability(Capability.EditSurvey);

        _plotting = await CompanyService.GetPlottingAsync(CompanyId);
        _plottingForm = new PlottingFormModel
        {
            SalesUserId = _plotting?.SalesUserId,
            PosisiPelanggan = _plotting?.PosisiPelanggan,
            Kawasan = _plotting?.Kawasan,
        };
        _plottingError = null;

        _contacts = (await CompanyService.GetContactsAsync(CompanyId)).ToList();

        if (_canEdit || _detail.CanChooseReviewers || _canEditSurvey)
        {
            var users = await UserService.GetUsersAsync(CurrentUser.Permissions);

            if (_canEdit)
            {
                _salesAreaUsers = users
                    .Where(u => u.Roles.Any(r => r.Role == Role.SalesArea))
                    .Select(u => new SelectOption<Guid?>(u.Id, u.FullName))
                    .ToList();
            }

            if (_canEditSurvey)
            {
                _surveyors = users.Select(u => new SelectOption<Guid?>(u.Id, u.FullName)).ToList();
            }

            if (_detail.CanChooseReviewers)
            {
                _reviewerCandidates = users
                    .Where(u => u.Id != _detail.CreatedBy && u.Roles.Any(r => r.Role == Role.Reviewer))
                    .ToList();
            }
        }
    }

    private RenderFragment RenderStatusCard() => @<div>
        @if (_detail!.HolderLabel is not null)
        {
            <p class="font-semibold text-sm">Menunggu</p>
            <p class="text-sm">@_detail.HolderLabel@(_detail.HolderName is not null ? $" : {_detail.HolderName}" : "")</p>
            <p class="text-xs text-muted-foreground inline-flex items-center gap-1"><LucideIcon Name="clock" Class="h-3 w-3" /> @WaitingLabel(_detail.StatusSince)</p>
        }
        else
        {
            <p class="font-semibold text-sm">@StatusLabel(_detail!.Status)</p>
            <p class="text-xs text-muted-foreground">@WaitingLabel(_detail.StatusSince)</p>
        }
    </div>;

    private RenderFragment RenderRingkasan() => @<div class="space-y-6">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
            <!-- Card 1: 📊 Profil Pelanggan & Lokasi -->
            <div class="rounded-lg border p-4 space-y-3 bg-card shadow-xs">
                <div class="flex items-center gap-2 pb-2 border-b">
                    <div class="p-1.5 rounded bg-blue-50 text-blue-700 dark:bg-blue-900/40 dark:text-blue-300">
                        <LucideIcon Name="building-2" Class="size-4" />
                    </div>
                    <h4 class="font-semibold text-sm text-foreground">Profil Pelanggan &amp; Lokasi</h4>
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Jenis Industri:</span>
                        <span class="font-semibold text-foreground">@_detail!.IndustryTypeName</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Nomor Registrasi:</span>
                        <span class="font-mono text-foreground font-semibold">@_detail.Nomor</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Lokasi:</span>
                        <span class="font-medium text-foreground">@_detail.LocationLabel</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-muted-foreground">Sales Area:</span>
                        <span class="font-medium text-foreground">@_detail.AreaName (@_detail.RegionName)</span>
                    </div>
                </div>
            </div>

            <!-- Card 2: ⚡ Penugasan & Penanggung Jawab -->
            <div class="rounded-lg border p-4 space-y-3 bg-card shadow-xs">
                <div class="flex items-center gap-2 pb-2 border-b">
                    <div class="p-1.5 rounded bg-emerald-50 text-emerald-700 dark:bg-emerald-900/40 dark:text-emerald-300">
                        <LucideIcon Name="user-check" Class="size-4" />
                    </div>
                    <h4 class="font-semibold text-sm text-foreground">Penugasan &amp; Penanggung Jawab</h4>
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Sales Representative:</span>
                        <span class="font-semibold text-foreground">@_detail.SalesRepName</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Pemegang Berkas:</span>
                        <span class="font-medium text-foreground">@(_detail.HolderName ?? _detail.HolderLabel ?? "Sistem")</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Tahap Berkas:</span>
                        <span class="font-semibold text-primary">Tahap @Math.Min(_detail.CurrentStage + 1, 8) : @CompanyLabels.StageLabel((byte)Math.Min(_detail.CurrentStage + 1, 8))</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-muted-foreground">Status Alur Kerja:</span>
                        <span class="font-semibold text-foreground">@StatusLabel(_detail.Status)</span>
                    </div>
                </div>
            </div>

            <!-- Card 3: 🛡️ Kesiapan & Izin Berkas -->
            <div class="rounded-lg border p-4 space-y-3 bg-card shadow-xs">
                <div class="flex items-center gap-2 pb-2 border-b">
                    <div class="p-1.5 rounded bg-amber-50 text-amber-700 dark:bg-amber-900/40 dark:text-amber-300">
                        <LucideIcon Name="shield-check" Class="size-4" />
                    </div>
                    <h4 class="font-semibold text-sm text-foreground">Kesiapan &amp; Izin Berkas</h4>
                </div>
                <div class="space-y-2 text-xs">
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Posisi Giliran (Turn):</span>
                        <span class="@(_detail.CanAct ? "font-bold text-amber-600" : "font-medium text-foreground")">
                            @(_detail.CanAct ? "Menunggu Tindakan Anda" : _detail.HolderLabel ?? "Diproses")
                        </span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-dashed">
                        <span class="text-muted-foreground">Kelayakan Pengajuan:</span>
                        <span class="@(_detail.CanSubmit ? "font-semibold text-emerald-600" : "font-medium text-muted-foreground")">
                            @(_detail.CanSubmit ? "Siap Diajukan" : "Sedang Berjalan / Terkunci")
                        </span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-muted-foreground">Durasi di Tahap Ini:</span>
                        <span class="font-medium text-foreground flex items-center gap-1"><LucideIcon Name="clock" Class="size-3 text-muted-foreground" /> @WaitingLabel(_detail.StatusSince)</span>
                    </div>
                </div>
            </div>

            <!-- Card 4: 👥 Kontak Utama & PIC -->
            <div class="rounded-lg border p-4 space-y-3 bg-card shadow-xs">
                <div class="flex items-center gap-2 pb-2 border-b">
                    <div class="p-1.5 rounded bg-purple-50 text-purple-700 dark:bg-purple-900/40 dark:text-purple-300">
                        <LucideIcon Name="users" Class="size-4" />
                    </div>
                    <h4 class="font-semibold text-sm text-foreground">Kontak Utama &amp; PIC</h4>
                </div>
                @if (_detail!.Contacts.Count == 0)
                {
                    <p class="text-xs text-muted-foreground italic py-2">Belum ada kontak terdaftar.</p>
                }
                else
                {
                    <div class="space-y-2 text-xs">
                        @foreach (var contact in _detail.Contacts.Take(2))
                        {
                            <div class="flex items-start justify-between py-1 border-b border-dashed last:border-0">
                                <div>
                                    <div class="font-semibold text-foreground flex items-center gap-1.5">
                                        @contact.Nama
                                        @if (contact.IsPrimary)
                                        {
                                            <span class="text-[10px] px-1.5 py-0.2 rounded bg-primary/10 text-primary font-semibold">Utama</span>
                                        }
                                    </div>
                                    <div class="text-[11px] text-muted-foreground">@contact.Jabatan</div>
                                </div>
                                <div class="text-right text-[11px] text-muted-foreground">
                                    @if (contact.NoHp is not null)
                                    {
                                        <div>@contact.NoHp</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>

        <div>
            <h4 class="font-semibold text-xs uppercase tracking-wider text-muted-foreground mb-3">Daftar Kontak Lengkap</h4>
            @if (_detail!.Contacts.Count == 0)
            {
                <p class="text-sm text-muted-foreground italic">Belum ada kontak terdaftar.</p>
            }
            else
            {
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3">
                    @foreach (var contact in _detail.Contacts)
                    {
                        <div class="rounded-lg border p-3 flex items-start justify-between bg-card">
                            <div class="space-y-1 text-sm">
                                <div class="flex items-center gap-2">
                                    <span class="font-medium">@contact.Nama</span>
                                    @if (contact.IsPrimary)
                                    {
                                        <BbBadge Variant="BadgeVariant.Secondary" Class="text-[10px] px-1.5 py-0">Utama</BbBadge>
                                    }
                                </div>
                                <p class="text-xs text-muted-foreground">@contact.Jabatan</p>
                                @if (contact.Email is not null)
                                {
                                    <p class="text-xs text-muted-foreground flex items-center gap-1"><LucideIcon Name="mail" Class="size-3" /> @contact.Email</p>
                                }
                                @if (contact.NoHp is not null)
                                {
                                    <p class="text-xs text-muted-foreground flex items-center gap-1"><LucideIcon Name="phone" Class="size-3" /> @contact.NoHp</p>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>;

    private RenderFragment RenderPlotting() => @<div class="space-y-6">
        @if (_canEdit)
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Penugasan Plotting &amp; Karakteristik</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <EditForm Model="_plottingForm" OnValidSubmit="SavePlottingAsync" OnInvalidSubmit="HandleInvalidSubmit">
                        <DataAnnotationsValidator />
                        <div class="space-y-4 w-full">
                            <BbFormFieldCombobox TValue="Guid?"
                                                 @bind-Value="_plottingForm.SalesUserId"
                                                 Label="Plotting By (Sales Area) *"
                                                 Required="true"
                                                 Options="_salesAreaUsers"
                                                 Placeholder="Pilih petugas sales"
                                                 SearchPlaceholder="Cari petugas sales..."
                                                 EmptyMessage="Tidak ada pengguna"
                                                 MatchTriggerWidth
                                                 Class="w-full"
                                                 InputClass="w-full text-xs" />
                            <BbFormFieldRadioGroup TValue="PosisiPelanggan?" @bind-Value="_plottingForm.PosisiPelanggan" Label="Posisi Pelanggan *">
                                <BbRadioGroupItem TValue="PosisiPelanggan?" Value="PosisiPelanggan.Pengembangan" Label="Pengembangan" />
                                <BbRadioGroupItem TValue="PosisiPelanggan?" Value="PosisiPelanggan.JalurExisting" Label="Jalur Existing" />
                            </BbFormFieldRadioGroup>
                            <BbFormFieldRadioGroup TValue="Kawasan?" @bind-Value="_plottingForm.Kawasan" Label="Kawasan *">
                                <BbRadioGroupItem TValue="Kawasan?" Value="Kawasan.KawasanIndustri" Label="Kawasan Industri" />
                                <BbRadioGroupItem TValue="Kawasan?" Value="Kawasan.NonKawasanIndustri" Label="Non Kawasan Industri" />
                            </BbFormFieldRadioGroup>
                            @if (_plottingError is not null)
                            {
                                <BbAlert Variant="AlertVariant.Danger">
                                    <BbAlertDescription>@_plottingError</BbAlertDescription>
                                </BbAlert>
                            }
                            <div class="pt-2">
                                <BbButton Type="ButtonType.Submit">Simpan Plotting</BbButton>
                            </div>
                        </div>
                    </EditForm>
                </BbCardContent>
            </BbCard>
        }
        else
        {
            <div class="rounded-lg border p-4 space-y-3 w-full bg-muted/20">
                <h4 class="font-semibold text-xs uppercase tracking-wider text-muted-foreground">Detail Plotting</h4>
                <div class="space-y-2 text-sm">
                    <div class="flex justify-between py-1 border-b border-border/40">
                        <span class="text-muted-foreground">Plotting By</span>
                        <span class="font-medium">@(_plotting?.SalesUserName ?? "-")</span>
                    </div>
                    <div class="flex justify-between py-1 border-b border-border/40">
                        <span class="text-muted-foreground">Posisi Pelanggan</span>
                        <span class="font-medium">@CompanyLabels.PosisiPelangganLabel(_plotting?.PosisiPelanggan)</span>
                    </div>
                    <div class="flex justify-between py-1">
                        <span class="text-muted-foreground">Kawasan</span>
                        <span class="font-medium">@CompanyLabels.KawasanLabel(_plotting?.Kawasan)</span>
                    </div>
                </div>
            </div>
        }
    </div>;

    private RenderFragment RenderProspek() => @<div class="space-y-4">
        <div class="flex items-center justify-between">
            <div>
                <h3 class="font-semibold text-base">PIC &amp; Kontak Perusahaan</h3>
                <p class="text-xs text-muted-foreground">Daftar penanggung jawab dan kontak perwakilan pelanggan.</p>
            </div>
            @if (_canEdit)
            {
                <BbButton Size="ButtonSize.Small" OnClick="OpenAddContact">
                    <LucideIcon Name="plus" Class="h-4 w-4 mr-1" /> Tambah PIC
                </BbButton>
            }
        </div>

        @if (_contacts.Count == 0)
        {
            <div class="text-center py-8 border rounded-lg bg-muted/10 space-y-2">
                <LucideIcon Name="users" Class="size-8 mx-auto text-muted-foreground/60" />
                <p class="text-sm text-muted-foreground">Belum ada kontak PIC yang didaftarkan.</p>
                @if (_canEdit)
                {
                    <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="OpenAddContact">Tambah PIC Pertama</BbButton>
                }
            </div>
        }
        else
        {
            <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                @foreach (var contact in _contacts)
                {
                    <div class="border rounded-lg p-4 flex items-start justify-between gap-3 bg-card relative shadow-xs">
                        <div class="space-y-1.5 text-sm flex-1">
                            <div class="flex items-center gap-2">
                                <span class="font-semibold text-base">@contact.Nama</span>
                                @if (contact.IsPrimary)
                                {
                                    <BbBadge Variant="BadgeVariant.Default" Class="text-[10px] px-1.5 py-0">Kontak Utama</BbBadge>
                                }
                            </div>
                            <p class="text-xs text-muted-foreground font-medium">@contact.Jabatan</p>
                            <div class="pt-1 space-y-1 text-xs">
                                @if (contact.Email is not null)
                                {
                                    <p class="text-muted-foreground flex items-center gap-1.5"><LucideIcon Name="mail" Class="size-3.5" /> @contact.Email</p>
                                }
                                @if (contact.NoHp is not null)
                                {
                                    <p class="text-muted-foreground flex items-center gap-1.5"><LucideIcon Name="phone" Class="size-3.5" /> @contact.NoHp</p>
                                }
                            </div>
                        </div>
                        @if (_canEdit)
                        {
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => OpenEditContact(contact))" AriaLabel="Ubah Kontak">
                                            <LucideIcon Name="pencil" Class="size-3.5" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah Kontak</BbTooltipContent>
                                </BbTooltip>
                                @if (!contact.IsPrimary)
                                {
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => SetPrimaryAsync(contact))" AriaLabel="Jadikan Kontak Utama">
                                                <LucideIcon Name="star" Class="size-3.5 text-amber-500" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Jadikan Kontak Utama</BbTooltipContent>
                                    </BbTooltip>
                                }
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" OnClick="@(() => DeleteContactAsync(contact))" AriaLabel="Hapus Kontak" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30">
                                            <LucideIcon Name="trash-2" Class="size-3.5" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus Kontak</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>;

    private RenderFragment RenderTimeline() => @<div class="space-y-3">
        @if (_detail!.HolderLabel is null && _timeline.Count == 0)
        {
            <BbEmpty Title="Belum ada riwayat" Description="Riwayat proses akan muncul di sini setelah diajukan." Size="EmptySize.Small" />
        }
        @if (_detail!.HolderLabel is not null)
        {
            <div class="text-sm">
                <span class="font-medium inline-flex items-center gap-1.5"><LucideIcon Name="circle-dot" Class="h-3.5 w-3.5 text-primary" /> @_detail.HolderLabel@(_detail.HolderName is not null ? $" : {_detail.HolderName}" : "")</span>
                <p class="text-xs text-muted-foreground inline-flex items-center gap-1"><LucideIcon Name="clock" Class="h-3 w-3" /> menunggu @WaitingLabel(_detail.StatusSince)</p>
            </div>
        }
        @foreach (var entry in _showFullTimeline ? _timeline : _timeline.Take(8))
        {
            <div class="text-sm border-t pt-2">
                <span class="inline-flex items-center gap-1.5"><LucideIcon Name="circle" Class="h-2 w-2 text-muted-foreground fill-current" /> @entry.OccurredAt.ToLocalTime().ToString("dd/MM HH:mm")  @entry.RoleLabel · @entry.ActorName</span>
                <p class="text-xs text-muted-foreground">
                    @WorkflowLabels.ActionLabel(entry.Action)
                    @if (!string.IsNullOrWhiteSpace(entry.Comment)) { <text> : "@entry.Comment"</text> }
                </p>
            </div>
        }
        @if (!_showFullTimeline && _timeline.Count > 8)
        {
            <BbButton Variant="ButtonVariant.Link" Size="ButtonSize.Small" OnClick="@(() => _showFullTimeline = true)">Lihat semua</BbButton>
        }
    </div>;

    private static string WaitingLabel(DateTimeOffset since) => WorkflowLabels.WaitingLabel(since);

    private static string StatusLabel(RecordStatus status) => status switch
    {
        RecordStatus.Draft => "DRAF",
        RecordStatus.Rejected => "DITOLAK",
        RecordStatus.IssuedNol => "NOL TERBIT",
        RecordStatus.IssuedRl => "RL TERBIT",
        RecordStatus.Discontinued => "DIHENTIKAN",
        _ => status.ToString(),
    };

    private async Task AjukanAsync()
    {
        var confirm = await DialogService.ConfirmAsync(
            "Ajukan untuk Persetujuan?",
            "Berkas akan dikirim ke Area Head untuk ditinjau.",
            new ConfirmDialogOptions { ConfirmText = "Ajukan" });
        if (!confirm.Confirmed)
        {
            return;
        }

        var result = await WorkflowService.StartAsync(CompanyId, CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);
        await AfterActionAsync(result.Succeeded, result.Error, "Berkas berhasil diajukan untuk persetujuan.");
    }

    private async Task SetujuAsync() => await ActAsync(WorkflowAction.Setuju, null, "Setujui berkas ini?", "Berkas berhasil disetujui.");

    private async Task RevisiAsync()
    {
        var prompt = await DialogService.PromptAsync(
            "Minta Revisi",
            "Jelaskan apa yang perlu diperbaiki.",
            new PromptDialogOptions { Required = true, Placeholder = "Catatan revisi" });
        if (prompt.Cancelled)
        {
            return;
        }

        await ActWithCommentAsync(WorkflowAction.Revisi, prompt.Value, "Permintaan revisi telah dikirim.");
    }

    private async Task TolakAsync()
    {
        var prompt = await DialogService.PromptAsync(
            "Tolak Berkas",
            "Jelaskan alasan penolakan.",
            new PromptDialogOptions { Required = true, Placeholder = "Alasan penolakan" });
        if (prompt.Cancelled)
        {
            return;
        }

        await ActWithCommentAsync(WorkflowAction.Tolak, prompt.Value, "Berkas telah ditolak.");
    }

    private async Task TidakLayakAsync() => await ActAsync(WorkflowAction.TidakLayak, null, "Tandai tidak layak (terbitkan RL)?", "Berkas ditandai Tidak Layak (RL diterbitkan).");

    private async Task ActAsync(WorkflowAction action, string? comment, string confirmMessage, string? successMessage = null)
    {
        var confirm = await DialogService.ConfirmAsync(confirmMessage, null, new ConfirmDialogOptions { ConfirmText = "Lanjutkan" });
        if (!confirm.Confirmed)
        {
            return;
        }

        await ActWithCommentAsync(action, comment, successMessage);
    }

    private async Task ActWithCommentAsync(WorkflowAction action, string? comment, string? successMessage = null)
    {
        var stepId = _detail!.CurrentStepId!.Value;
        var result = await WorkflowService.ActAsync(stepId, action, comment, CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);
        await AfterActionAsync(result.Succeeded, result.Error, successMessage);
    }

    private async Task ChooseReviewersAsync()
    {
        _reviewerError = null;
        var result = await WorkflowService.ChooseReviewersAsync(
            _detail!.WorkflowInstanceId!.Value, _selectedReviewers.ToList(), CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);

        if (!result.Succeeded)
        {
            _reviewerError = result.Error;
            ToastService.Error(result.Error ?? "Gagal menetapkan reviewer.", "Gagal");
            return;
        }

        _reviewerDialogOpen = false;
        await LoadAsync();
        ToastService.Success("Reviewer berhasil ditetapkan.", "Reviewer Ditetapkan");
    }

    private async Task SavePlottingAsync()
    {
        _plottingError = null;

        if (_plottingForm.SalesUserId is null)
        {
            _plottingError = "Plotting By (Sales) wajib dipilih.";
            ToastService.Error(_plottingError, "Validasi Gagal");
            return;
        }

        if (_plottingForm.PosisiPelanggan is null)
        {
            _plottingError = "Posisi Pelanggan wajib dipilih.";
            ToastService.Error(_plottingError, "Validasi Gagal");
            return;
        }

        if (_plottingForm.Kawasan is null)
        {
            _plottingError = "Kawasan wajib dipilih.";
            ToastService.Error(_plottingError, "Validasi Gagal");
            return;
        }

        var request = new SavePlottingRequest(
            _plottingForm.SalesUserId.Value, _plottingForm.PosisiPelanggan.Value, _plottingForm.Kawasan.Value);
        var result = await CompanyService.SavePlottingAsync(CompanyId, request, CurrentUser.UserId, CurrentUser.Permissions);
        if (!result.Succeeded)
        {
            _plottingError = result.Error;
            ToastService.Error(result.Error ?? "Gagal menyimpan data plotting.", "Gagal");
            return;
        }

        await LoadAsync();
        ToastService.Success("Data plotting berhasil disimpan. Tahap berlanjut ke Prospek.", "Tersimpan");
        NavigateToTab("prospek");
    }

    private async Task ProspekAsync()
    {
        var confirm = await DialogService.ConfirmAsync(
            "Lanjutkan ke Prospek?",
            "Berkas akan lanjut ke tahap 3 - Prospek.",
            new ConfirmDialogOptions { ConfirmText = "Lanjutkan" });
        if (!confirm.Confirmed)
        {
            return;
        }

        var result = await CompanyService.PromoteToProspekAsync(CompanyId, CurrentUser.UserId, CurrentUser.Permissions);
        await AfterActionAsync(result.Succeeded, result.Error, "Berkas berhasil dilanjutkan ke tahap Prospek.");
    }

    private void OpenAddContact()
    {
        _editingContactId = null;
        _contactForm = new ContactFormModel();
        _contactError = null;
        _contactDialogOpen = true;
    }

    private void OpenEditContact(ContactDetail contact)
    {
        _editingContactId = contact.Id;
        _contactForm = new ContactFormModel
        {
            Nama = contact.Nama,
            Jabatan = contact.Jabatan,
            Email = contact.Email,
            NoHp = contact.NoHp,
            LinkedIn = contact.LinkedIn,
            Instagram = contact.Instagram,
            Facebook = contact.Facebook,
            IsPrimary = contact.IsPrimary,
        };
        _contactError = null;
        _contactDialogOpen = true;
    }

    private async Task SaveContactAsync()
    {
        _contactError = null;
        var isEdit = _editingContactId is not null;
        var request = new SaveContactRequest(
            _contactForm.Nama, _contactForm.Jabatan, _contactForm.Email, _contactForm.NoHp,
            _contactForm.LinkedIn, _contactForm.Instagram, _contactForm.Facebook, _contactForm.IsPrimary);

        var result = _editingContactId is { } id
            ? await CompanyService.UpdateContactAsync(CompanyId, id, request, CurrentUser.UserId, CurrentUser.Permissions)
            : await CompanyService.AddContactAsync(CompanyId, request, CurrentUser.UserId, CurrentUser.Permissions);

        if (!result.Succeeded)
        {
            _contactError = result.Error;
            ToastService.Error(result.Error ?? "Gagal menyimpan data PIC.", "Gagal");
            return;
        }

        _contactDialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Data PIC berhasil diperbarui." : "PIC baru berhasil ditambahkan.", "Tersimpan");
        if (_detail?.CurrentStage >= 3 && _activeTab == "prospek")
        {
            NavigateToTab("survei");
        }
    }

    private async Task OnSurveySaved()
    {
        await LoadAsync();
        if (_detail?.CurrentStage >= 4 && _activeTab == "survei")
        {
            NavigateToTab("a1");
        }
    }

    private async Task OnA1Saved()
    {
        await LoadAsync();
        if (_detail?.CurrentStage >= 5 && _activeTab == "a1")
        {
            NavigateToTab("nol");
        }
    }

    private async Task SetPrimaryAsync(ContactDetail contact)
    {
        var request = new SaveContactRequest(
            contact.Nama, contact.Jabatan, contact.Email, contact.NoHp,
            contact.LinkedIn, contact.Instagram, contact.Facebook, true);
        var result = await CompanyService.UpdateContactAsync(CompanyId, contact.Id, request, CurrentUser.UserId, CurrentUser.Permissions);
        await AfterActionAsync(result.Succeeded, result.Error, $"\"{contact.Nama}\" dijadikan kontak utama.");
    }

    private async Task DeleteContactAsync(ContactDetail contact)
    {
        var confirm = await DialogService.ConfirmAsync(
            "Hapus kontak?",
            $"\"{contact.Nama}\" akan dihapus dari daftar PIC.");
        if (!confirm.Confirmed)
        {
            return;
        }

        var result = await CompanyService.DeleteContactAsync(CompanyId, contact.Id, CurrentUser.UserId, CurrentUser.Permissions);
        await AfterActionAsync(result.Succeeded, result.Error, $"Kontak \"{contact.Nama}\" berhasil dihapus.");
    }

    private async Task AfterActionAsync(bool succeeded, string? error, string? successMessage = null)
    {
        if (!succeeded)
        {
            ToastService.Error(error ?? "Terjadi kesalahan.", "Gagal");
            await DialogService.AlertAsync("Tidak dapat melanjutkan", error);
            return;
        }

        await LoadAsync();
        ToastService.Success(successMessage ?? "Tindakan berhasil diproses.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
