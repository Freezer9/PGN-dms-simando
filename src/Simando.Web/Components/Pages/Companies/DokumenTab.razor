@using Microsoft.AspNetCore.Components.Forms
@using Simando.Application.Attachments
@using Simando.Application.Directory
@using Simando.Domain.Attachments
@using Simando.Domain.Registration
@using Simando.Domain.Security
@using Simando.Domain.Workflow
@inject IAttachmentService AttachmentService
@inject ICompanyService CompanyService
@inject ToastService ToastService

@if (_loading)
{
    <p class="text-sm text-muted-foreground">Memuat dokumen…</p>
}
else
{
    <div class="space-y-6">
        @if (_error is not null)
        {
            <BbAlert Variant="AlertVariant.Danger">
                <BbAlertDescription>@_error</BbAlertDescription>
            </BbAlert>
        }

        <!-- Stage-Gate Status Banner -->
        <BbCard>
            <BbCardHeader>
                <BbCardTitle>Status Syarat Dokumen (Stage-Gate)</BbCardTitle>
            </BbCardHeader>
            <BbCardContent Class="space-y-3">
                <div class="p-3 border rounded-md @(_gateBResult.IsPassed ? "bg-emerald-50/50 border-emerald-200" : "bg-amber-50/50 border-amber-200")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm inline-flex items-center gap-1">Gate B (Survei <LucideIcon Name="arrow-right" Class="h-3.5 w-3.5" /> A1 Registrasi):</span>
                        <span class="text-xs px-2 py-0.5 rounded font-semibold @(_gateBResult.IsPassed ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                            @(_gateBResult.IsPassed ? "Lengkap" : "Belum Lengkap")
                        </span>
                    </div>
                    @if (!_gateBResult.IsPassed)
                    {
                        <ul class="list-disc pl-5 mt-2 text-xs text-amber-900 space-y-1">
                            @foreach (var missing in _gateBResult.MissingPrerequisites)
                            {
                                <li>@missing</li>
                            }
                        </ul>
                    }
                </div>

                <div class="p-3 border rounded-md @(_gateCResult.IsPassed ? "bg-emerald-50/50 border-emerald-200" : "bg-amber-50/50 border-amber-200")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm inline-flex items-center gap-1">Gate C (A1 Registrasi <LucideIcon Name="arrow-right" Class="h-3.5 w-3.5" /> Permohonan NOL):</span>
                        <span class="text-xs px-2 py-0.5 rounded font-semibold @(_gateCResult.IsPassed ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                            @(_gateCResult.IsPassed ? "Lengkap" : "Belum Lengkap")
                        </span>
                    </div>
                    @if (!_gateCResult.IsPassed)
                    {
                        <ul class="list-disc pl-5 mt-2 text-xs text-amber-900 space-y-1">
                            @foreach (var missing in _gateCResult.MissingPrerequisites)
                            {
                                <li>@missing</li>
                            }
                        </ul>
                    }
                </div>

                <div class="p-3 border rounded-md @(_gateDResult.IsPassed ? "bg-emerald-50/50 border-emerald-200" : "bg-amber-50/50 border-amber-200")">
                    <div class="flex items-center justify-between">
                        <span class="font-medium text-sm inline-flex items-center gap-1">Gate D (Permohonan NOL <LucideIcon Name="arrow-right" Class="h-3.5 w-3.5" /> Ajukan Persetujuan):</span>
                        <span class="text-xs px-2 py-0.5 rounded font-semibold @(_gateDResult.IsPassed ? "bg-emerald-100 text-emerald-800" : "bg-amber-100 text-amber-800")">
                            @(_gateDResult.IsPassed ? "Lengkap" : "Belum Lengkap")
                        </span>
                    </div>
                    @if (!_gateDResult.IsPassed)
                    {
                        <ul class="list-disc pl-5 mt-2 text-xs text-amber-900 space-y-1">
                            @foreach (var missing in _gateDResult.MissingPrerequisites)
                            {
                                <li>@missing</li>
                            }
                        </ul>
                    }
                </div>
            </BbCardContent>
        </BbCard>

        <!-- Document Table & Upload surface -->
        <BbCard>
            <BbCardHeader Class="flex flex-row items-center justify-between">
                <BbCardTitle>Daftar Dokumen Lampiran</BbCardTitle>
                @if (CanUpload)
                {
                    <BbButton OnClick="@(() => _uploadDialogOpen = true)">Unggah Dokumen Baru</BbButton>
                }
            </BbCardHeader>
            <BbCardContent>
                <BbDataTable TData="AttachmentDetail" Data="_attachments" InitialPageSize="25" AriaLabel="Daftar dokumen lampiran">
                    <Columns>
                        <BbDataTableColumn TData="AttachmentDetail" TValue="string" Header="Jenis Dokumen" Width="180px">
                            <CellTemplate Context="att">@GetKindLabel(att.Kind)</CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="AttachmentDetail" TValue="string" Header="Nama Berkas" Property="@(a => a.Filename)" Sortable="true" Width="100%" />
                        <BbDataTableColumn TData="AttachmentDetail" TValue="string" Header="Metode TTD" Width="120px">
                            <CellTemplate Context="att">
                                @if (att.SignatureMethod is { } sig)
                                {
                                    <span class="inline-flex items-center text-xs px-2 py-0.5 rounded bg-blue-50 text-blue-700 font-medium">
                                        @(sig == SignatureMethod.Wet ? "Basah" : "Digital")
                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted-foreground text-xs">-</span>
                                }
                            </CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="AttachmentDetail" TValue="int" Header="Versi" Width="80px">
                            <CellTemplate Context="att">v@att.Version</CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="AttachmentDetail" TValue="long" Header="Ukuran" Width="100px">
                            <CellTemplate Context="att">@FormatSizeBytes(att.SizeBytes)</CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="AttachmentDetail" TValue="string" Header="Diunggah Oleh" Property="@(a => a.UploadedByName)" Sortable="true" Width="140px" />
                        <BbDataTableColumn TData="AttachmentDetail" TValue="DateTimeOffset" Header="Tanggal" Property="@(a => a.UploadedAt)" Sortable="true" Width="140px" />
                        <BbDataTableColumn TData="AttachmentDetail" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                            <CellTemplate Context="att">
                                <div class="flex items-center justify-center">
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" Href="@($"/attachments/{att.Id}/download")" Target="_blank" AriaLabel="Unduh">
                                                <LucideIcon Name="download" Class="size-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Unduh Dokumen</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </CellTemplate>
                        </BbDataTableColumn>
                    </Columns>
                    <EmptyTemplate>
                        <BbEmpty Title="Belum ada dokumen" Description="Belum ada berkas lampiran yang diunggah untuk perusahaan ini." />
                    </EmptyTemplate>
                </BbDataTable>
            </BbCardContent>
        </BbCard>
    </div>
}

<BbDialog @bind-Open="_uploadDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Unggah Dokumen Lampiran</BbDialogTitle>
            <BbDialogDescription>Pilih berkas dan tentukan jenis dokumen serta metode tanda tangan.</BbDialogDescription>
        </BbDialogHeader>
        <div class="py-4 space-y-4">
            <BbFormFieldSelect TValue="AttachmentKind" @bind-Value="_selectedKind" Label="Jenis Dokumen *" Options="_kindOptions" />
            <BbFormFieldSelect TValue="SignatureMethod?" @bind-Value="_selectedSigMethod" Label="Metode Tanda Tangan" Placeholder="Pilih metode (opsional)" Options="_sigMethodOptions" />

            <div class="space-y-1.5">
                <BbLabel For="file-upload">Pilih Berkas *</BbLabel>
                <InputFile Id="file-upload" OnChange="OnFileSelected" class="block w-full text-sm text-foreground file:mr-4 file:py-2 file:px-4 file:rounded-md file:border-0 file:text-sm file:font-semibold file:bg-primary file:text-primary-foreground hover:file:bg-primary/90" />
            </div>

            @if (_uploadError is not null)
            {
                <BbAlert Variant="AlertVariant.Danger">
                    <BbAlertDescription>@_uploadError</BbAlertDescription>
                </BbAlert>
            }
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _uploadDialogOpen = false)">Batal</BbButton>
            <BbButton OnClick="UploadAsync" Disabled="@(_selectedFile is null || _uploading)">@(_uploading ? "Mengunggah…" : "Unggah")</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    [Parameter, EditorRequired] public Guid CompanyId { get; set; }
    [Parameter] public bool CanUpload { get; set; }
    [Parameter] public Guid ActorUserId { get; set; }

    private bool _loading = true;
    private bool _uploading;
    private bool _uploadDialogOpen;
    private string? _error;
    private string? _uploadError;

    private IReadOnlyList<AttachmentDetail> _attachments = [];
    private StageGateCheckResult _gateBResult = StageGateCheckResult.Success();
    private StageGateCheckResult _gateCResult = StageGateCheckResult.Success();
    private StageGateCheckResult _gateDResult = StageGateCheckResult.Success();

    private AttachmentKind _selectedKind = AttachmentKind.Kk0;
    private SignatureMethod? _selectedSigMethod = SignatureMethod.Wet;
    private IBrowserFile? _selectedFile;

    private List<SelectOption<AttachmentKind>> _kindOptions =
    [
        new(AttachmentKind.Kk0, "KK0 (Lampiran 10)"),
        new(AttachmentKind.A1, "A1 Registrasi (Lampiran 11)"),
        new(AttachmentKind.BuktiKelayakan, "Bukti Kelayakan"),
        new(AttachmentKind.MomSigas, "MOM SiGas"),
        new(AttachmentKind.CapexPreGr3, "Capex Pre-GR3"),
        new(AttachmentKind.Npwp, "Dokumen NPWP"),
        new(AttachmentKind.Other, "Dokumen Lainnya"),
    ];

    private List<SelectOption<SignatureMethod?>> _sigMethodOptions =
    [
        new(SignatureMethod.Wet, "Tanda Tangan Basah"),
        new(SignatureMethod.Digital, "Tanda Tangan Digital"),
    ];

    protected override async Task OnInitializedAsync()
    {
        await LoadDataAsync();
    }

    private async Task LoadDataAsync()
    {
        _loading = true;
        _error = null;
        try
        {
            _attachments = await AttachmentService.GetCompanyAttachmentsAsync(CompanyId);

            var kinds = _attachments.Select(a => a.Kind).ToList();
            _gateBResult = StageGateEvaluator.EvaluateSurveyToA1Gate(kinds);

            var a1 = await CompanyService.GetA1RegistrationAsync(CompanyId);
            _gateCResult = StageGateEvaluator.EvaluateA1ToNolRequestGate(a1?.SkemaHarga, kinds);
            _gateDResult = StageGateEvaluator.EvaluateNolRequestToSubmitGate(kinds);
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private void OnFileSelected(InputFileChangeEventArgs e)
    {
        _selectedFile = e.File;
        _uploadError = null;
    }

    private async Task UploadAsync()
    {
        if (_selectedFile is null) return;

        _uploading = true;
        _uploadError = null;

        try
        {
            await using var stream = _selectedFile.OpenReadStream(maxAllowedSize: 25 * 1024 * 1024); // 25 MB max
            var req = new UploadAttachmentRequest(
                _selectedKind,
                _selectedFile.Name,
                _selectedFile.ContentType ?? "application/octet-stream",
                _selectedFile.Size,
                _selectedSigMethod,
                stream);

            var result = await AttachmentService.UploadAttachmentAsync(CompanyId, req, ActorUserId);
            if (result.Succeeded)
            {
                _uploadDialogOpen = false;
                var fileName = _selectedFile.Name;
                var kindLabel = GetKindLabel(_selectedKind);
                _selectedFile = null;
                await LoadDataAsync();
                ToastService.Success($"Dokumen {kindLabel} ({fileName}) berhasil diunggah.", "Dokumen Diunggah");
            }
            else
            {
                _uploadError = result.Error;
                ToastService.Error(result.Error ?? "Gagal mengunggah dokumen.", "Gagal");
            }
        }
        catch (Exception ex)
        {
            _uploadError = $"Gagal mengunggah berkas: {ex.Message}";
            ToastService.Error($"Gagal mengunggah berkas: {ex.Message}", "Gagal");
        }

        _uploading = false;
    }

    private static string GetKindLabel(AttachmentKind kind) => kind switch
    {
        AttachmentKind.Kk0 => "KK0 (Lampiran 10)",
        AttachmentKind.A1 => "A1 Registrasi (Lampiran 11)",
        AttachmentKind.BuktiKelayakan => "Bukti Kelayakan",
        AttachmentKind.MomSigas => "MOM SiGas",
        AttachmentKind.CapexPreGr3 => "Capex Pre-GR3",
        AttachmentKind.Npwp => "NPWP",
        _ => kind.ToString()
    };

    private static string FormatSizeBytes(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }
}
