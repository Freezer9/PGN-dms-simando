@page "/directory/new"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Application.Directory
@using Simando.Application.Geography
@using Simando.Application.Organisation
@using Simando.Domain.MasterData
@using Simando.Domain.Organisation
@using Simando.Domain.Security
@using Simando.Web.Components.Shared
@inject ICompanyService Service
@inject IGeographyService GeographyService
@inject IEntityService<IndustryType> IndustryTypeService
@inject IOrganisationService OrganisationService
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Tambah Perusahaan - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Tambah Perusahaan" Subtitle="Pendaftaran entitas calon pelanggan industri baru ke dalam direktori." />

    <EditForm id="directory-new-form" Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
        <DataAnnotationsValidator />
        <BbCard>
            <BbCardContent Class="pt-6 space-y-6">
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }

                <section class="space-y-3">
                    <BbSectionHeader Title="Identitas" Uppercase="true" />
                    <BbFormFieldInput TValue="string" @bind-Value="_form.NamaPerusahaan" Label="Nama Perusahaan *" />
                    <BbFormFieldInput TValue="string" @bind-Value="_form.Website" Label="Website" />

                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <BbFormFieldCombobox TValue="Guid?"
                                             @bind-Value="_form.IndustryTypeId"
                                             Label="Jenis Produksi *"
                                             Required="true"
                                             Options="_industryTypeOptions"
                                             Placeholder="Pilih jenis produksi"
                                             SearchPlaceholder="Cari jenis produksi..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />

                        @if (_areaOptions is { Count: > 0 })
                        {
                            <BbFormFieldCombobox TValue="Guid?"
                                                 @bind-Value="_form.AreaId"
                                                 Label="Area *"
                                                 Required="true"
                                                 Options="_areaOptions"
                                                 Placeholder="Pilih area"
                                                 SearchPlaceholder="Cari area..."
                                                 EmptyMessage="Tidak ditemukan"
                                                 MatchTriggerWidth
                                                 Class="w-full"
                                                 InputClass="w-full text-xs" />
                        }
                    </div>
                </section>

                <section class="space-y-3">
                    <BbSectionHeader Title="Lokasi" Uppercase="true" />
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <BbFormFieldCombobox TValue="Guid?"
                                             Value="_form.ProvinceId"
                                             ValueChanged="OnProvinceChanged"
                                             Label="Provinsi *"
                                             Required="true"
                                             Options="_provinceOptions"
                                             Placeholder="Pilih provinsi"
                                             SearchPlaceholder="Cari provinsi..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        <BbFormFieldCombobox TValue="Guid?"
                                             Value="_form.RegencyId"
                                             ValueChanged="OnRegencyChanged"
                                             Label="Kota/Kabupaten *"
                                             Required="true"
                                             Options="_regencyOptions"
                                             Disabled="@(_form.ProvinceId is null)"
                                             Placeholder="Pilih kota/kabupaten"
                                             SearchPlaceholder="Cari kota/kabupaten..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                    </div>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <BbFormFieldCombobox TValue="Guid?"
                                             Value="_form.DistrictId"
                                             ValueChanged="OnDistrictChanged"
                                             Label="Kecamatan *"
                                             Required="true"
                                             Options="_districtOptions"
                                             Disabled="@(_form.RegencyId is null)"
                                             Placeholder="Pilih kecamatan"
                                             SearchPlaceholder="Cari kecamatan..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        <BbFormFieldCombobox TValue="Guid?"
                                             @bind-Value="_form.VillageId"
                                             Label="Kelurahan/Desa *"
                                             Required="true"
                                             Options="_villageOptions"
                                             Disabled="@(_form.DistrictId is null)"
                                             Placeholder="Pilih kelurahan/desa"
                                             SearchPlaceholder="Cari kelurahan/desa..."
                                             EmptyMessage="Tidak ditemukan"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                    </div>
                    <BbFormFieldInput TValue="string" @bind-Value="_form.Alamat" Label="Alamat *" />
                </section>

                <section class="space-y-3">
                    <BbSectionHeader Title="Titik Koordinat" Uppercase="true" />
                    <PinDropMap @bind-Latitude="_form.Latitude" @bind-Longitude="_form.Longitude" />
                    @if (_form.Latitude is null || _form.Longitude is null)
                    {
                        <p class="text-xs text-muted-foreground">Klik peta untuk menandai lokasi. Wajib diisi.</p>
                    }
                    else
                    {
                        <p class="text-xs text-muted-foreground">Longitude @_form.Longitude?.ToString("0.0000") · Latitude @_form.Latitude?.ToString("0.0000")</p>
                    }
                </section>

                <section class="space-y-3">
                    <BbSectionHeader Title="Kontak Perusahaan" Uppercase="true" />
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <BbFormFieldInput TValue="string" @bind-Value="_form.Email" Label="Email" />
                        <BbFormFieldInput TValue="string" @bind-Value="_form.Telp" Label="Telp" />
                    </div>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <BbFormFieldInput TValue="string" @bind-Value="_form.KodePos" Label="Kode Pos" />
                        <BbFormFieldInput TValue="string" @bind-Value="_form.Npwp" Label="NPWP" />
                    </div>
                </section>

                <div class="flex justify-end gap-2 pt-4 border-t">
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" Href="/directory">Batal</BbButton>
                    <BbButton Type="ButtonType.Submit" Disabled="_saving">@(_saving ? "Menyimpan…" : "Simpan Perusahaan")</BbButton>
                </div>
            </BbCardContent>
        </BbCard>
    </EditForm>
}

@code {
    private sealed class FormModel
    {
        [Required(ErrorMessage = "Nama perusahaan wajib diisi.")]
        public string NamaPerusahaan { get; set; } = "";

        public string? Website { get; set; }

        [Required(ErrorMessage = "Jenis produksi wajib diisi.")]
        public Guid? IndustryTypeId { get; set; }

        public Guid? AreaId { get; set; }

        [Required(ErrorMessage = "Provinsi wajib diisi.")]
        public Guid? ProvinceId { get; set; }

        [Required(ErrorMessage = "Kota/Kabupaten wajib diisi.")]
        public Guid? RegencyId { get; set; }

        [Required(ErrorMessage = "Kecamatan wajib diisi.")]
        public Guid? DistrictId { get; set; }

        [Required(ErrorMessage = "Kelurahan/Desa wajib diisi.")]
        public Guid? VillageId { get; set; }

        [Required(ErrorMessage = "Alamat wajib diisi.")]
        public string Alamat { get; set; } = "";

        public double? Latitude { get; set; }
        public double? Longitude { get; set; }

        public string? Email { get; set; }
        public string? KodePos { get; set; }
        public string? Telp { get; set; }
        public string? Npwp { get; set; }
    }

    private readonly FormModel _form = new();
    private bool _saving;
    private string? _error;

    private List<SelectOption<Guid?>> _provinceOptions = [];
    private List<SelectOption<Guid?>> _regencyOptions = [];
    private List<SelectOption<Guid?>> _districtOptions = [];
    private List<SelectOption<Guid?>> _villageOptions = [];
    private List<SelectOption<Guid?>> _industryTypeOptions = [];
    private List<SelectOption<Guid?>> _areaOptions = [];

    protected override Capability[] RequiredCapabilities => [Capability.CreateCompany];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Direktori Industri", "/directory"),
        new("Tambah Perusahaan", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        var provinces = await GeographyService.GetProvincesAsync();
        _provinceOptions = provinces.Select(p => new SelectOption<Guid?>(p.Id, p.Name)).ToList();

        var industryTypes = await IndustryTypeService.GetAllAsync();
        _industryTypeOptions = industryTypes.Select(t => new SelectOption<Guid?>(t.Id, t.Name)).ToList();

        // Sales Area only ever has one Area — pre-filled, no field shown.
        // Regional Admin is Region-scoped and has no single Area, so they
        // pick one from their own Region.
        if (CurrentUser.Permissions.Scope == AccessScope.Area)
        {
            _form.AreaId = CurrentUser.Permissions.AreaId;
        }
        else if (CurrentUser.Permissions.Scope == AccessScope.Region)
        {
            var areas = await OrganisationService.GetAreasAsync();
            _areaOptions = areas
                .Where(a => a.RegionId == CurrentUser.Permissions.RegionId)
                .Select(a => new SelectOption<Guid?>(a.Id, a.Name))
                .ToList();
        }
    }

    private async Task OnProvinceChanged(Guid? value)
    {
        _form.ProvinceId = value;
        _form.RegencyId = _form.DistrictId = _form.VillageId = null;
        _regencyOptions = _districtOptions = _villageOptions = [];
        if (value is { } provinceId)
        {
            var regencies = await GeographyService.GetRegenciesAsync(provinceId);
            _regencyOptions = regencies.Select(r => new SelectOption<Guid?>(r.Id, r.Name)).ToList();
        }
    }

    private async Task OnRegencyChanged(Guid? value)
    {
        _form.RegencyId = value;
        _form.DistrictId = _form.VillageId = null;
        _districtOptions = _villageOptions = [];
        if (value is { } regencyId)
        {
            var districts = await GeographyService.GetDistrictsAsync(regencyId);
            _districtOptions = districts.Select(d => new SelectOption<Guid?>(d.Id, d.Name)).ToList();
        }
    }

    private async Task OnDistrictChanged(Guid? value)
    {
        _form.DistrictId = value;
        _form.VillageId = null;
        _villageOptions = [];
        if (value is { } districtId)
        {
            var villages = await GeographyService.GetVillagesAsync(districtId);
            _villageOptions = villages.Select(v => new SelectOption<Guid?>(v.Id, v.Name)).ToList();
        }
    }

    private async Task SaveAsync()
    {
        if (_form.Latitude is null || _form.Longitude is null)
        {
            _error = "Lokasi pada peta wajib ditandai. Silakan klik peta untuk menentukan titik lokasi.";
            ToastService.Error(_error, "Validasi Gagal");
            return;
        }

        if (_form.AreaId is null)
        {
            _error = "Area wajib diisi.";
            ToastService.Error(_error, "Validasi Gagal");
            return;
        }

        _saving = true;
        _error = null;

        var request = new CreateCompanyRequest(
            _form.NamaPerusahaan, _form.Website,
            _form.VillageId!.Value, _form.Alamat, _form.Latitude.Value, _form.Longitude.Value,
            _form.IndustryTypeId!.Value, _form.AreaId.Value,
            _form.Email, _form.KodePos, _form.Telp, _form.Npwp);

        var result = await Service.CreateAsync(request, CurrentUser.UserId, CurrentUser.Permissions);
        ToastService.Success($"Perusahaan \"{_form.NamaPerusahaan}\" berhasil didaftarkan.", "Berhasil");
        Nav.NavigateTo($"/companies/{result.CompanyId}");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
