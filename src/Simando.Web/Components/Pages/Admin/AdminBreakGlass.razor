@page "/admin/break-glass"
@inherits AdminPageBase
@using Simando.Application.Security
@using Simando.Domain.Security
@inject IBreakGlassService BreakGlassService

<PageTitle>Akses Darurat (Break-Glass) - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="space-y-6">
        <BbPageHeader Title="Akses Darurat (Break-Glass Log)" Subtitle="Catatan audit penggunaan hak akses darurat untuk melihat data di luar wilayah normal." />

        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">Memuat log akses darurat…</p>
        }
        else
        {
            <BbCard Class="border-amber-200">
                <BbCardHeader>
                    <BbCardTitle>Log Penggunaan Break-Glass (@_totalCount)</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataTable TData="BreakGlassAccessDto" Data="_logs" InitialPageSize="25" AriaLabel="Log penggunaan break glass">
                        <Columns>
                            <BbDataTableColumn TData="BreakGlassAccessDto" TValue="string" Header="Perusahaan" Width="30%">
                                <CellTemplate Context="b">
                                    <div class="flex flex-col">
                                        <a href="/companies/@b.CompanyId" class="font-semibold text-primary hover:underline">@b.CompanyName</a>
                                        <span class="text-xs text-muted-foreground">@b.CompanyNomor</span>
                                    </div>
                                </CellTemplate>
                            </BbDataTableColumn>
                            <BbDataTableColumn TData="BreakGlassAccessDto" TValue="string" Header="Pengguna (Admin)" Property="@(b => b.UserName)" Sortable="true" Width="160px" />
                            <BbDataTableColumn TData="BreakGlassAccessDto" TValue="DateTimeOffset" Header="Waktu Minta" Property="@(b => b.RequestedAt)" Sortable="true" Width="160px" />
                            <BbDataTableColumn TData="BreakGlassAccessDto" TValue="string" Header="Status Akses" Width="120px">
                                <CellTemplate Context="b">
                                    @if (b.IsActive)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold">Aktif (60m)</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded bg-muted text-muted-foreground text-xs font-medium">Kedaluwarsa</span>
                                    }
                                </CellTemplate>
                            </BbDataTableColumn>
                            <BbDataTableColumn TData="BreakGlassAccessDto" TValue="string" Header="Alasan Tertulis (Mandatory Audit)">
                                <CellTemplate Context="b">
                                    <span class="text-xs italic">"@b.Reason"</span>
                                </CellTemplate>
                            </BbDataTableColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="Belum ada log break-glass" Description="Penggunaan hak akses darurat belum pernah dicatat dalam sistem." />
                        </EmptyTemplate>
                    </BbDataTable>

                    @if (_totalCount > 0)
                    {
                        <div class="flex items-center justify-between mt-4 px-2 text-xs text-muted-foreground">
                            <div>
                                Menampilkan @((_currentPage - 1) * _pageSize + 1) – @Math.Min(_currentPage * _pageSize, _totalCount) dari @_totalCount log
                            </div>
                            <div class="flex items-center gap-2">
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(_currentPage <= 1)" OnClick="PrevPageAsync">
                                    Sebelumnya
                                </BbButton>
                                <span>Halaman @_currentPage dari @TotalPages</span>
                                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" Disabled="@(_currentPage >= TotalPages)" OnClick="NextPageAsync">
                                    Selanjutnya
                                </BbButton>
                            </div>
                        </div>
                    }
                </BbCardContent>
            </BbCard>
        }
    </div>
}

@code {
    private List<BreakGlassAccessDto> _logs = [];
    private bool _loading = true;
    private int _currentPage = 1;
    private int _pageSize = 25;
    private int _totalCount;

    private int TotalPages => Math.Max(1, (int)Math.Ceiling((double)_totalCount / _pageSize));

    protected override Capability[] RequiredCapabilities => [Capability.ViewBreakGlassActivity];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Akses Darurat", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        await LoadPageAsync();
    }

    private async Task LoadPageAsync()
    {
        _loading = true;
        var paged = await BreakGlassService.GetPagedAuditLogsAsync(CurrentUser.Permissions, _currentPage, _pageSize);
        _logs = paged.Items.ToList();
        _totalCount = paged.TotalCount;
        _loading = false;
    }

    private async Task NextPageAsync()
    {
        if (_currentPage < TotalPages)
        {
            _currentPage++;
            await LoadPageAsync();
        }
    }

    private async Task PrevPageAsync()
    {
        if (_currentPage > 1)
        {
            _currentPage--;
            await LoadPageAsync();
        }
    }
}
