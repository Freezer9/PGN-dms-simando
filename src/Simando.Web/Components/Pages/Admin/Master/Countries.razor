@page "/master/countries"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<Country> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Negara - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Negara" Subtitle="Negara asal bahan baku dan negara tujuan orientasi pasar, dipilih pada formulir pendaftaran.">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Negara
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="Country" Data="_countries" InitialPageSize="25" AriaLabel="Daftar negara">
                <Columns>
                    <BbDataTableColumn TData="Country" TValue="string" Header="Kode ISO" Property="@(c => c.IsoCode)" Sortable="true" Width="90px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                    <BbDataTableColumn TData="Country" TValue="string" Header="Nama" Property="@(c => c.Name)" Sortable="true" Filterable="true" />
                    <BbDataTableColumn TData="Country" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="country">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(country))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(country))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada negara" Description="Tambahkan negara pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Negara</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Negara" : "Ubah Negara")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_form.IsoCode" Label="Kode ISO *" HelperText="ISO 3166-1 alpha-2, mis. 'ID'." />
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class CountryFormModel
    {
        [Required(ErrorMessage = "Kode ISO wajib diisi")]
        [StringLength(2, ErrorMessage = "Kode ISO maksimal 2 karakter")]
        public string IsoCode { get; set; } = "";

        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";
    }

    private List<Country> _countries = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private CountryFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Referensi", null),
        new("Negara", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var countries = await Service.GetAllAsync();
        _countries = countries.OrderBy(c => c.Name).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new CountryFormModel();
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(Country country)
    {
        _editingId = country.Id;
        _form = new CountryFormModel { IsoCode = country.IsoCode, Name = country.Name };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing =>
                {
                    existing.IsoCode = _form.IsoCode;
                    existing.Name = _form.Name;
                });
            }
            else
            {
                await Service.AddAsync(new Country
                {
                    Id = Guid.NewGuid(),
                    IsoCode = _form.IsoCode,
                    Name = _form.Name,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Kode ISO negara ini sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Negara berhasil diperbarui." : "Negara berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(Country country)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus negara \"{country.Name}\"?",
            "Data negara ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(country.Id);

        await LoadAsync();
        ToastService.Success($"Negara \"{country.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
