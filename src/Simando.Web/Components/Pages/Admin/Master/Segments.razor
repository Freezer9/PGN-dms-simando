@page "/master/segments"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<Segment> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Segmen - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Segmen Pelanggan" Subtitle="Klasifikasi segmen pelanggan yang dipilih pada formulir pendaftaran. Harga ditentukan manual per transaksi, bukan dari daftar ini.">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Segmen
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="Segment" Data="_segments" InitialPageSize="25" AriaLabel="Daftar segmen">
                <Columns>
                    <BbDataTableColumn TData="Segment" TValue="int" Header="Urutan" Property="@(s => s.SortOrder)" Sortable="true" Width="80px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                    <BbDataTableColumn TData="Segment" TValue="string" Header="Nama" Property="@(s => s.Name)" Sortable="true" />
                    <BbDataTableColumn TData="Segment" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="segment">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(segment))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(segment))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada segmen" Description="Tambahkan segmen pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Segmen</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Segmen" : "Ubah Segmen")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                <BbFormFieldNumericInput TValue="int" @bind-Value="_form.SortOrder" Label="Urutan" Min="0" />
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class SegmentFormModel
    {
        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(50, ErrorMessage = "Nama maksimal 50 karakter")]
        public string Name { get; set; } = "";

        public int SortOrder { get; set; }
    }

    private List<Segment> _segments = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private SegmentFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Komersial", null),
        new("Segmen", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var segments = await Service.GetAllAsync();
        _segments = segments.OrderBy(s => s.SortOrder).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new SegmentFormModel { SortOrder = _segments.Count == 0 ? 0 : _segments.Max(s => s.SortOrder) + 1 };
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(Segment segment)
    {
        _editingId = segment.Id;
        _form = new SegmentFormModel { Name = segment.Name, SortOrder = segment.SortOrder };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing =>
                {
                    existing.Name = _form.Name;
                    existing.SortOrder = _form.SortOrder;
                });
            }
            else
            {
                await Service.AddAsync(new Segment
                {
                    Id = Guid.NewGuid(),
                    Name = _form.Name,
                    SortOrder = _form.SortOrder,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Nama segmen sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Segmen berhasil diperbarui." : "Segmen berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(Segment segment)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus segmen \"{segment.Name}\"?",
            "Data segmen ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(segment.Id);

        await LoadAsync();
        ToastService.Success($"Segmen \"{segment.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
