@page "/master/units"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<UnitOfMeasure> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Satuan - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Satuan Ukur (Unit of Measure)" Subtitle="Satuan ukur yang digunakan lintas formulir (volume, energi, tekanan, dan sejenisnya).">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Satuan
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="UnitOfMeasure" Data="_units" InitialPageSize="25" AriaLabel="Daftar satuan">
                <Columns>
                    <BbDataTableColumn TData="UnitOfMeasure" TValue="string" Header="Kode" Property="@(u => u.Code)" Sortable="true" Width="90px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                    <BbDataTableColumn TData="UnitOfMeasure" TValue="string" Header="Nama" Property="@(u => u.Name)" Sortable="true" Filterable="true" />
                    <BbDataTableColumn TData="UnitOfMeasure" TValue="string" Header="Dimensi" Property="@(u => u.Dimension.ToString())" Sortable="true" Width="120px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                    <BbDataTableColumn TData="UnitOfMeasure" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="unit">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(unit))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(unit))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada satuan" Description="Tambahkan satuan pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Satuan</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Satuan" : "Ubah Satuan")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <BbFormFieldInput TValue="string" @bind-Value="_form.Code" Label="Kode *" />
                    <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                </div>
                <BbFormFieldSelect TValue="UnitDimension" @bind-Value="_form.Dimension" Label="Dimensi *">
                    @foreach (var dimension in Enum.GetValues<UnitDimension>())
                    {
                        <BbSelectItem TValue="UnitDimension" Value="@dimension" Text="@dimension.ToString()" />
                    }
                </BbFormFieldSelect>
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class UnitFormModel
    {
        [Required(ErrorMessage = "Kode wajib diisi")]
        [StringLength(20, ErrorMessage = "Kode maksimal 20 karakter")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";

        public UnitDimension Dimension { get; set; }
    }

    private List<UnitOfMeasure> _units = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private UnitFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Energi & Konversi", null),
        new("Satuan", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var units = await Service.GetAllAsync();
        _units = units.OrderBy(u => u.Name).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new UnitFormModel();
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(UnitOfMeasure unit)
    {
        _editingId = unit.Id;
        _form = new UnitFormModel { Code = unit.Code, Name = unit.Name, Dimension = unit.Dimension };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing =>
                {
                    existing.Code = _form.Code;
                    existing.Name = _form.Name;
                    existing.Dimension = _form.Dimension;
                });
            }
            else
            {
                await Service.AddAsync(new UnitOfMeasure
                {
                    Id = Guid.NewGuid(),
                    Code = _form.Code,
                    Name = _form.Name,
                    Dimension = _form.Dimension,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Kode satuan ini sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Satuan berhasil diperbarui." : "Satuan berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(UnitOfMeasure unit)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus satuan \"{unit.Name}\"?",
            "Data satuan ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(unit.Id);

        await LoadAsync();
        ToastService.Success($"Satuan \"{unit.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
