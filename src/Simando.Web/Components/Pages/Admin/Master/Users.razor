@page "/master/users"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Organisation
@using Simando.Application.Security
@using Simando.Domain.Organisation
@using Simando.Domain.Security
@inject IUserService Service
@inject IOrganisationService OrganisationService
@inject DialogService DialogService
@inject ToastService ToastService
@inject IJSRuntime JS

<PageTitle>Pengguna - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Pengguna & Peran" Subtitle="Akun dikelola di dalam sistem ini. Tidak ada integrasi direktori PGN.">
        <Actions>
            <BbButton OnClick="OpenCreate" Disabled="@(AssignableRoles.Count == 0)" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Pengguna
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="UserListItem" Data="_users" InitialPageSize="25" AriaLabel="Daftar pengguna">
                <Columns>
                    <BbDataTableColumn TData="UserListItem" TValue="string" Header="Nama" Property="@(u => u.FullName)" Sortable="true" Filterable="true" Width="25%" />
                    <BbDataTableColumn TData="UserListItem" TValue="string" Header="Peran" Width="35%">
                        <CellTemplate Context="user">
                            @if (user.Roles.Count == 0)
                            {
                                <span class="text-muted-foreground">-</span>
                            }
                            else
                            {
                                <div class="flex flex-col gap-0.5">
                                    @foreach (var role in user.Roles)
                                    {
                                        <span>@role.RoleLabel · @role.ScopeLabel</span>
                                    }
                                </div>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="UserListItem" TValue="string" Header="Status" Width="120px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="user">
                            @if (!user.Active)
                            {
                                <BbBadge Variant="BadgeVariant.Destructive">Nonaktif</BbBadge>
                            }
                            else if (user.LastLoginAt is null)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary">Baru</BbBadge>
                            }
                            else
                            {
                                <BbBadge Variant="BadgeVariant.Default">Aktif</BbBadge>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="UserListItem" TValue="DateTimeOffset?" Header="Login terakhir" Property="@(u => u.LastLoginAt)" Sortable="true" Width="120px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                        <CellTemplate Context="user">
                            @LoginLabel(user.LastLoginAt)
                        </CellTemplate>
                    </BbDataTableColumn>
                    <BbDataTableColumn TData="UserListItem" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="user">
                            @if (user.Id != CurrentUser.UserId)
                            {
                                <div class="flex items-center justify-center gap-1">
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah Peran"
                                                      OnClick="@(() => OpenRoleDialog(user))">
                                                <LucideIcon Name="user-cog" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah Peran</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Atur Ulang Kata Sandi"
                                                      OnClick="@(() => ResetPasswordAsync(user))">
                                                <LucideIcon Name="key-round" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Atur Ulang Kata Sandi</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="@(user.Active ? "Nonaktifkan" : "Aktifkan")"
                                                      Class="@(user.Active ? "text-amber-600 hover:bg-amber-500/10 border-amber-300 dark:text-amber-500" : "text-emerald-600 hover:bg-emerald-500/10 border-emerald-300 dark:text-emerald-500")"
                                                      OnClick="@(() => ToggleActiveAsync(user))">
                                                <LucideIcon Name="@(user.Active ? "ban" : "check")" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>@(user.Active ? "Nonaktifkan" : "Aktifkan")</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            }
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada pengguna" Description="Tambahkan pengguna pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Pengguna</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>

            @if (_users.Count > 0)
            {
                <p class="text-sm text-muted-foreground mt-3 flex items-center gap-2">
                    @if (NeverLoggedInCount > 0)
                    {
                        <span class="inline-flex items-center gap-1"><LucideIcon Name="triangle-alert" Class="h-4 w-4 text-amber-500" /> @NeverLoggedInCount akun belum pernah login</span>
                    }
                    @if (NeverLoggedInCount > 0 && DormantCount > 0)
                    {
                        <span> · </span>
                    }
                    @if (DormantCount > 0)
                    {
                        <span class="inline-flex items-center gap-1"><LucideIcon Name="circle-alert" Class="h-4 w-4 text-destructive" /> @DormantCount akun tidak aktif lebih dari 90 hari</span>
                    }
                </p>
            }
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_createDialogOpen">
    <BbDialogContent>
        <EditForm Model="_createForm" OnValidSubmit="CreateUserAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>Tambah Pengguna</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_createForm.FullName" Label="Nama Lengkap *" />
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <BbFormFieldInput TValue="string" @bind-Value="_createForm.UserName" Label="Nama Pengguna *" />
                    <BbFormFieldSelect TValue="Role" @bind-Value="_createForm.Role" Label="Peran *">
                        @foreach (var role in AssignableRoles)
                        {
                            <BbSelectItem TValue="Role" Value="@role" Text="@RoleLabel(role)" />
                        }
                    </BbFormFieldSelect>
                </div>
                <BbFormFieldInput TValue="string" @bind-Value="_createForm.Email" Label="Email" HelperText="Disimpan untuk keperluan nanti; email belum diaktifkan, tidak ada surat yang dikirim." />
                @if (SelectedScope(_createForm.Role) == AccessScope.Area)
                {
                    <BbFormFieldCombobox TValue="Guid"
                                         @bind-Value="_createForm.AreaId"
                                         Label="Lingkup (Area) *"
                                         Required="true"
                                         Placeholder="Pilih area"
                                         SearchPlaceholder="Cari area..."
                                         EmptyMessage="Tidak ditemukan"
                                         Options="AreaOptions"
                                         MatchTriggerWidth
                                         Class="w-full"
                                         InputClass="w-full text-xs" />
                    @if (_createScopeError is not null)
                    {
                        <p class="text-xs text-destructive">@_createScopeError</p>
                    }
                }
                else if (SelectedScope(_createForm.Role) == AccessScope.Region)
                {
                    <BbFormFieldCombobox TValue="Guid"
                                         @bind-Value="_createForm.RegionId"
                                         Label="Lingkup (Region) *"
                                         Required="true"
                                         Placeholder="Pilih region"
                                         SearchPlaceholder="Cari region..."
                                         EmptyMessage="Tidak ditemukan"
                                         Options="RegionOptions"
                                         MatchTriggerWidth
                                         Class="w-full"
                                         InputClass="w-full text-xs" />
                    @if (_createScopeError is not null)
                    {
                        <p class="text-xs text-destructive">@_createScopeError</p>
                    }
                }
                @if (_createErrors.Count > 0)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@string.Join(" ", _createErrors)</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _createDialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_passwordDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Kata Sandi Sementara : @_revealedUserName</BbDialogTitle>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            <div class="flex items-center justify-between rounded-md border p-3 font-mono">
                <span>@_revealedPassword</span>
                <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Salin" OnClick="CopyPasswordAsync">
                    <LucideIcon Name="clipboard-copy" Class="h-4 w-4" />
                </BbButton>
            </div>
            <BbAlert Variant="AlertVariant.Warning">
                <BbAlertDescription>Sampaikan kata sandi ini langsung kepada pengguna. Sistem tidak mengirimkannya. Pengguna wajib menggantinya saat login pertama.</BbAlertDescription>
            </BbAlert>
        </div>
        <BbDialogFooter>
            <BbButton OnClick="ClosePasswordDialogAsync">Tutup</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_roleDialogOpen">
    <BbDialogContent>
        <BbDialogHeader>
            <BbDialogTitle>Ubah Peran : @_roleDialogUser?.FullName</BbDialogTitle>
        </BbDialogHeader>
        <div class="space-y-4 py-4">
            @if (_roleDialogUser is { Roles.Count: > 0 })
            {
                <div class="space-y-2">
                    @for (var i = 0; i < _roleDialogUser.Roles.Count; i++)
                    {
                        var role = _roleDialogUser.Roles[i];
                        var assignmentId = _roleDialogUser.RoleAssignmentIds[i];
                        <div class="flex items-center justify-between rounded-md border p-2">
                            <span>@role.RoleLabel · @role.ScopeLabel</span>
                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.Small" OnClick="@(() => DeactivateRoleAsync(assignmentId))">
                                Nonaktifkan
                            </BbButton>
                        </div>
                    }
                </div>
            }

            <EditForm Model="_addRoleForm" OnValidSubmit="AddRoleAsync" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <div class="space-y-4 border-t pt-4">
                    <BbFormFieldSelect TValue="Role" @bind-Value="_addRoleForm.Role" Label="Tambah peran *">
                        @foreach (var role in AssignableRoles)
                        {
                            <BbSelectItem TValue="Role" Value="@role" Text="@RoleLabel(role)" />
                        }
                    </BbFormFieldSelect>
                    @if (SelectedScope(_addRoleForm.Role) == AccessScope.Area)
                    {
                        <BbFormFieldCombobox TValue="Guid"
                                             @bind-Value="_addRoleForm.AreaId"
                                             Label="Lingkup (Area) *"
                                             Required="true"
                                             Placeholder="Pilih area"
                                             SearchPlaceholder="Cari area..."
                                             EmptyMessage="Tidak ditemukan"
                                             Options="AreaOptions"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        @if (_addRoleScopeError is not null)
                        {
                            <p class="text-xs text-destructive">@_addRoleScopeError</p>
                        }
                    }
                    else if (SelectedScope(_addRoleForm.Role) == AccessScope.Region)
                    {
                        <BbFormFieldCombobox TValue="Guid"
                                             @bind-Value="_addRoleForm.RegionId"
                                             Label="Lingkup (Region) *"
                                             Required="true"
                                             Placeholder="Pilih region"
                                             SearchPlaceholder="Cari region..."
                                             EmptyMessage="Tidak ditemukan"
                                             Options="RegionOptions"
                                             MatchTriggerWidth
                                             Class="w-full"
                                             InputClass="w-full text-xs" />
                        @if (_addRoleScopeError is not null)
                        {
                            <p class="text-xs text-destructive">@_addRoleScopeError</p>
                        }
                    }
                    @if (_addRoleError is not null)
                    {
                        <BbAlert Variant="AlertVariant.Danger">
                            <BbAlertDescription>@_addRoleError</BbAlertDescription>
                        </BbAlert>
                    }
                    <BbButton Type="ButtonType.Submit">Tambah</BbButton>
                </div>
            </EditForm>
        </div>
        <BbDialogFooter>
            <BbButton Variant="ButtonVariant.Outline" OnClick="@(() => _roleDialogOpen = false)">Tutup</BbButton>
        </BbDialogFooter>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class CreateUserFormModel
    {
        [Required(ErrorMessage = "Nama lengkap wajib diisi")]
        public string FullName { get; set; } = "";

        [Required(ErrorMessage = "Nama pengguna wajib diisi")]
        public string UserName { get; set; } = "";

        public string? Email { get; set; }

        public Role Role { get; set; }

        public Guid AreaId { get; set; }

        public Guid RegionId { get; set; }
    }

    private sealed class AddRoleFormModel
    {
        public Role Role { get; set; }

        public Guid AreaId { get; set; }

        public Guid RegionId { get; set; }
    }

    private List<UserListItem> _users = [];
    private List<Region> _regions = [];
    private List<Area> _areas = [];

    private bool _createDialogOpen;
    private CreateUserFormModel _createForm = new();
    private List<string> _createErrors = [];
    private string? _createScopeError;

    private bool _passwordDialogOpen;
    private string _revealedPassword = "";
    private string _revealedUserName = "";

    private bool _roleDialogOpen;
    private UserListItem? _roleDialogUser;
    private AddRoleFormModel _addRoleForm = new();
    private string? _addRoleError;
    private string? _addRoleScopeError;

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData, Capability.AssignRoles];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Pengguna", null),
    ];

    private List<Role> AssignableRoles =>
        Enum.GetValues<Role>().Where(CanAssign).ToList();

    private List<SelectOption<Guid>> AreaOptions =>
        (CurrentUser.Scope == AccessScope.Region
            ? _areas.Where(a => a.RegionId == CurrentUser.RegionId)
            : _areas)
        .Select(a => new SelectOption<Guid>(a.Id, a.Name))
        .ToList();

    private List<SelectOption<Guid>> RegionOptions =>
        (CurrentUser.Scope == AccessScope.Region
            ? _regions.Where(r => r.Id == CurrentUser.RegionId)
            : _regions)
        .Select(r => new SelectOption<Guid>(r.Id, r.Name))
        .ToList();

    private bool CanAssign(Role role) => PermissionEvaluator.CanAssignRole(CurrentUser.Permissions, role, CurrentUser.RegionId);

    private static AccessScope SelectedScope(Role role) => RoleCapabilities.For(role).DefaultScope;

    private static string RoleLabel(Role role) => role switch
    {
        Role.SalesArea => "Sales Area",
        Role.AreaHead => "Area Head",
        Role.RegionalAdmin => "Regional Admin",
        Role.Reviewer => "Reviewer",
        Role.DivisionHead => "Division Head",
        Role.SystemAdmin => "System Admin",
        _ => role.ToString(),
    };

    private static string LoginLabel(DateTimeOffset? lastLogin)
    {
        if (lastLogin is null)
        {
            return "belum";
        }

        var elapsed = DateTimeOffset.UtcNow - lastLogin.Value;
        return elapsed < TimeSpan.FromDays(1) ? "hari ini" : $"{(int)elapsed.TotalDays} hari";
    }

    private int NeverLoggedInCount => _users.Count(u => u.LastLoginAt is null);

    private int DormantCount => _users.Count(u =>
        u.Active && u.LastLoginAt is { } last && DateTimeOffset.UtcNow - last > TimeSpan.FromDays(90));

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        _regions = await OrganisationService.GetRegionsAsync();
        _areas = await OrganisationService.GetAreasAsync();
        _users = await Service.GetUsersAsync(CurrentUser.Permissions);
    }

    private void OpenCreate()
    {
        _createForm = new CreateUserFormModel { Role = AssignableRoles[0] };
        PrefillScope(_createForm);
        _createErrors = [];
        _createScopeError = null;
        _createDialogOpen = true;
    }

    private void PrefillScope(CreateUserFormModel form)
    {
        if (CurrentUser.Scope == AccessScope.Region && CurrentUser.RegionId is { } regionId)
        {
            form.RegionId = regionId;
        }
    }

    private async Task CreateUserAsync()
    {
        _createErrors = [];
        _createScopeError = null;

        if (!TryResolveScope(_createForm.Role, _createForm.AreaId, _createForm.RegionId, out var areaId, out var regionId))
        {
            _createScopeError = "Lingkup wajib dipilih";
            ToastService.Error(_createScopeError, "Validasi Gagal");
            return;
        }

        var result = await Service.CreateUserAsync(
            _createForm.FullName, _createForm.UserName, _createForm.Email,
            _createForm.Role, areaId, regionId,
            CurrentUser.UserId, CurrentUser.Permissions);

        if (!result.Succeeded)
        {
            _createErrors = result.Errors.ToList();
            ToastService.Error(string.Join(", ", result.Errors), "Gagal");
            return;
        }

        _createDialogOpen = false;
        _revealedUserName = _createForm.FullName;
        _revealedPassword = result.TemporaryPassword!;
        _passwordDialogOpen = true;

        await LoadAsync();
        ToastService.Success($"Pengguna \"{_createForm.FullName}\" berhasil ditambahkan.", "Berhasil");
    }

    private async Task ResetPasswordAsync(UserListItem user)
    {
        var result = await DialogService.ConfirmAsync(
            $"Buat kata sandi baru untuk \"{user.FullName}\"?",
            "Kata sandi lama tidak lagi berlaku. Pengguna wajib menggantinya saat pertama kali masuk kembali.",
            new ConfirmDialogOptions { ConfirmText = "Buat Kata Sandi", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        _revealedUserName = user.FullName;
        _revealedPassword = await Service.ResetPasswordAsync(user.Id);
        _passwordDialogOpen = true;
        ToastService.Success($"Kata sandi untuk \"{user.FullName}\" telah diatur ulang.", "Berhasil");
    }

    private async Task ClosePasswordDialogAsync()
    {
        _passwordDialogOpen = false;
        _revealedPassword = "";
        await LoadAsync();
    }

    private async Task CopyPasswordAsync()
    {
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", _revealedPassword);
        ToastService.Info("Kata sandi berhasil disalin ke clipboard.", "Disalin");
    }

    private async Task ToggleActiveAsync(UserListItem user)
    {
        var willActivate = !user.Active;
        var result = await DialogService.ConfirmAsync(
            willActivate ? $"Aktifkan \"{user.FullName}\"?" : $"Nonaktifkan \"{user.FullName}\"?",
            willActivate
                ? "Pengguna akan dapat masuk kembali ke sistem."
                : "Sesi aktif pengguna akan dihentikan dan pengguna tidak dapat masuk hingga diaktifkan kembali.",
            new ConfirmDialogOptions { Destructive = !willActivate, ConfirmText = willActivate ? "Aktifkan" : "Nonaktifkan", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SetUserActiveAsync(user.Id, willActivate);
        await LoadAsync();
        ToastService.Success(willActivate ? $"Pengguna \"{user.FullName}\" berhasil diaktifkan." : $"Pengguna \"{user.FullName}\" berhasil dinonaktifkan.", "Status Diperbarui");
    }

    private void OpenRoleDialog(UserListItem user)
    {
        _roleDialogUser = user;
        _addRoleForm = new AddRoleFormModel { Role = AssignableRoles[0] };
        PrefillScope(_addRoleForm);
        _addRoleError = null;
        _addRoleScopeError = null;
        _roleDialogOpen = true;
    }

    private void PrefillScope(AddRoleFormModel form)
    {
        if (CurrentUser.Scope == AccessScope.Region && CurrentUser.RegionId is { } regionId)
        {
            form.RegionId = regionId;
        }
    }

    private async Task AddRoleAsync()
    {
        if (_roleDialogUser is null)
        {
            return;
        }

        _addRoleError = null;
        _addRoleScopeError = null;

        if (!TryResolveScope(_addRoleForm.Role, _addRoleForm.AreaId, _addRoleForm.RegionId, out var areaId, out var regionId))
        {
            _addRoleScopeError = "Lingkup wajib dipilih";
            ToastService.Error(_addRoleScopeError, "Validasi Gagal");
            return;
        }

        var result = await Service.AddRoleAssignmentAsync(
            _roleDialogUser.Id, _addRoleForm.Role, areaId, regionId,
            CurrentUser.UserId, CurrentUser.Permissions);

        if (!result.Succeeded)
        {
            _addRoleError = result.Error;
            ToastService.Error(result.Error ?? "Gagal menambahkan peran.", "Gagal");
            return;
        }

        await LoadAsync();
        _roleDialogUser = _users.FirstOrDefault(u => u.Id == _roleDialogUser.Id);
        _addRoleForm = new AddRoleFormModel { Role = AssignableRoles[0] };
        PrefillScope(_addRoleForm);
        ToastService.Success("Peran berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeactivateRoleAsync(Guid assignmentId)
    {
        if (_roleDialogUser is null)
        {
            return;
        }

        await Service.DeactivateRoleAssignmentAsync(assignmentId, CurrentUser.UserId, _roleDialogUser.Id);

        await LoadAsync();
        _roleDialogUser = _users.FirstOrDefault(u => u.Id == _roleDialogUser.Id);
        ToastService.Success("Peran berhasil dinonaktifkan.", "Berhasil");
    }

    private static bool TryResolveScope(Role role, Guid areaId, Guid regionId, out Guid? resolvedAreaId, out Guid? resolvedRegionId)
    {
        switch (SelectedScope(role))
        {
            case AccessScope.Area when areaId != Guid.Empty:
                resolvedAreaId = areaId;
                resolvedRegionId = null;
                return true;
            case AccessScope.Region when regionId != Guid.Empty:
                resolvedAreaId = null;
                resolvedRegionId = regionId;
                return true;
            case AccessScope.All:
                resolvedAreaId = null;
                resolvedRegionId = null;
                return true;
            default:
                resolvedAreaId = null;
                resolvedRegionId = null;
                return false;
        }
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
