@page "/master/industry-types"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<IndustryType> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Jenis Industri - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Jenis Industri" Subtitle="Kategori industri pelanggan, dipilih pada pendaftaran perusahaan.">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Jenis Industri
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="IndustryType" Data="_industryTypes" InitialPageSize="25" AriaLabel="Daftar jenis industri">
                <Columns>
                    <BbDataTableColumn TData="IndustryType" TValue="string" Header="Nama" Property="@(i => i.Name)" Sortable="true" Filterable="true" Width="40%" />
                    <BbDataTableColumn TData="IndustryType" TValue="string" Header="Contoh Produk" Property="@(i => i.ContohProduk)" />
                    <BbDataTableColumn TData="IndustryType" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="industryType">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(industryType))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(industryType))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada jenis industri" Description="Tambahkan jenis industri pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Jenis Industri</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Jenis Industri" : "Ubah Jenis Industri")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                <BbFormFieldInput TValue="string" @bind-Value="_form.ContohProduk" Label="Contoh Produk" />
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class IndustryTypeFormModel
    {
        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";

        [StringLength(200, ErrorMessage = "Contoh produk maksimal 200 karakter")]
        public string? ContohProduk { get; set; }
    }

    private List<IndustryType> _industryTypes = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private IndustryTypeFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Referensi", null),
        new("Jenis Industri", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var industryTypes = await Service.GetAllAsync();
        _industryTypes = industryTypes.OrderBy(i => i.Name).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new IndustryTypeFormModel();
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(IndustryType industryType)
    {
        _editingId = industryType.Id;
        _form = new IndustryTypeFormModel { Name = industryType.Name, ContohProduk = industryType.ContohProduk };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing =>
                {
                    existing.Name = _form.Name;
                    existing.ContohProduk = _form.ContohProduk;
                });
            }
            else
            {
                await Service.AddAsync(new IndustryType
                {
                    Id = Guid.NewGuid(),
                    Name = _form.Name,
                    ContohProduk = _form.ContohProduk,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Nama jenis industri sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Jenis industri berhasil diperbarui." : "Jenis industri berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(IndustryType industryType)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus jenis industri \"{industryType.Name}\"?",
            "Data jenis industri ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(industryType.Id);

        await LoadAsync();
        ToastService.Success($"Jenis industri \"{industryType.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
