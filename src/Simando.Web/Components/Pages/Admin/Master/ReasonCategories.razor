@page "/master/reason-categories"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<ReasonCategory> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Kategori Alasan - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Kategori Alasan" Subtitle="Pengelompokan opsional untuk komentar Revisi/Tolak, dipakai laporan hasil NOL.">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Kategori Alasan
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="ReasonCategory" Data="_reasonCategories" InitialPageSize="25" AriaLabel="Daftar kategori alasan">
                <Columns>
                    <BbDataTableColumn TData="ReasonCategory" TValue="string" Header="Nama" Property="@(r => r.Name)" Sortable="true" Filterable="true" />
                    <BbDataTableColumn TData="ReasonCategory" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="reasonCategory">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(reasonCategory))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(reasonCategory))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada kategori alasan" Description="Tambahkan kategori alasan pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Kategori Alasan</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Kategori Alasan" : "Ubah Kategori Alasan")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class ReasonCategoryFormModel
    {
        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";
    }

    private List<ReasonCategory> _reasonCategories = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private ReasonCategoryFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Dokumen", null),
        new("Kategori Alasan", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var reasonCategories = await Service.GetAllAsync();
        _reasonCategories = reasonCategories.OrderBy(r => r.Name).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new ReasonCategoryFormModel();
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(ReasonCategory reasonCategory)
    {
        _editingId = reasonCategory.Id;
        _form = new ReasonCategoryFormModel { Name = reasonCategory.Name };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing => existing.Name = _form.Name);
            }
            else
            {
                await Service.AddAsync(new ReasonCategory
                {
                    Id = Guid.NewGuid(),
                    Name = _form.Name,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Nama kategori alasan sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Kategori alasan berhasil diperbarui." : "Kategori alasan berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(ReasonCategory reasonCategory)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus kategori alasan \"{reasonCategory.Name}\"?",
            "Data kategori alasan ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(reasonCategory.Id);

        await LoadAsync();
        ToastService.Success($"Kategori alasan \"{reasonCategory.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
