@page "/master/fuel-types"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@inject IEntityService<FuelType> Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Jenis Bahan Bakar - DMS Simando</PageTitle>

@if (Authorized)
{
    <BbPageHeader Title="Master Jenis Bahan Bakar" Subtitle="Jenis bahan bakar yang dapat dipilih pelanggan pada formulir pendaftaran.">
        <Actions>
            <BbButton OnClick="OpenCreate" Size="ButtonSize.Small">
                <LucideIcon Name="plus" Class="size-4 mr-1" />
                Tambah Jenis Bahan Bakar
            </BbButton>
        </Actions>
    </BbPageHeader>

    <BbCard>
        <BbCardContent Class="pt-6">
            <BbDataTable TData="FuelType" Data="_fuelTypes" InitialPageSize="25" AriaLabel="Daftar jenis bahan bakar">
                <Columns>
                    <BbDataTableColumn TData="FuelType" TValue="string" Header="Nama" Property="@(f => f.Name)" Sortable="true" Filterable="true" />
                    <BbDataTableColumn TData="FuelType" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                        <CellTemplate Context="fuelType">
                            <div class="flex items-center justify-center gap-1">
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                  OnClick="@(() => OpenEdit(fuelType))">
                                            <LucideIcon Name="pencil" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Ubah</BbTooltipContent>
                                </BbTooltip>
                                <BbTooltip>
                                    <BbTooltipTrigger>
                                        <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                  OnClick="@(() => DeleteAsync(fuelType))">
                                            <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                        </BbButton>
                                    </BbTooltipTrigger>
                                    <BbTooltipContent>Hapus</BbTooltipContent>
                                </BbTooltip>
                            </div>
                        </CellTemplate>
                    </BbDataTableColumn>
                </Columns>
                <EmptyTemplate>
                    <BbEmpty Title="Belum ada jenis bahan bakar" Description="Tambahkan jenis bahan bakar pertama.">
                        <ChildContent>
                            <BbButton Class="mt-4" OnClick="OpenCreate">Tambah Jenis Bahan Bakar</BbButton>
                        </ChildContent>
                    </BbEmpty>
                </EmptyTemplate>
            </BbDataTable>
        </BbCardContent>
    </BbCard>
}

<BbDialog @bind-Open="_dialogOpen">
    <BbDialogContent>
        <EditForm Model="_form" OnValidSubmit="SaveAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingId is null ? "Tambah Jenis Bahan Bakar" : "Ubah Jenis Bahan Bakar")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama *" />
                @if (_error is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_error</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _dialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class FuelTypeFormModel
    {
        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(50, ErrorMessage = "Nama maksimal 50 karakter")]
        public string Name { get; set; } = "";
    }

    private List<FuelType> _fuelTypes = [];
    private bool _dialogOpen;
    private Guid? _editingId;
    private string? _error;
    private FuelTypeFormModel _form = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Energi & Konversi", null),
        new("Jenis Bahan Bakar", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var fuelTypes = await Service.GetAllAsync();
        _fuelTypes = fuelTypes.OrderBy(f => f.Name).ToList();
    }

    private void OpenCreate()
    {
        _editingId = null;
        _form = new FuelTypeFormModel();
        _error = null;
        _dialogOpen = true;
    }

    private void OpenEdit(FuelType fuelType)
    {
        _editingId = fuelType.Id;
        _form = new FuelTypeFormModel { Name = fuelType.Name };
        _error = null;
        _dialogOpen = true;
    }

    private async Task SaveAsync()
    {
        _error = null;

        try
        {
            if (_editingId is { } id)
            {
                await Service.UpdateAsync(id, existing => existing.Name = _form.Name);
            }
            else
            {
                await Service.AddAsync(new FuelType
                {
                    Id = Guid.NewGuid(),
                    Name = _form.Name,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _error = "Nama jenis bahan bakar sudah digunakan.";
            ToastService.Error(_error, "Gagal");
            return;
        }

        var isEdit = _editingId is not null;
        _dialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Jenis bahan bakar berhasil diperbarui." : "Jenis bahan bakar berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAsync(FuelType fuelType)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus jenis bahan bakar \"{fuelType.Name}\"?",
            "Data jenis bahan bakar ini akan dihapus dari daftar. Data riwayat yang sudah ada tidak akan terpengaruh.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        await Service.SoftDeleteAsync(fuelType.Id);

        await LoadAsync();
        ToastService.Success($"Jenis bahan bakar \"{fuelType.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
