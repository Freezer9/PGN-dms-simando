@page "/master/organisation"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Simando.Application.Common
@using Simando.Application.Organisation
@using Simando.Domain.Organisation
@using Simando.Domain.Security
@inject IOrganisationService Service
@inject DialogService DialogService
@inject ToastService ToastService

<PageTitle>Organisasi - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="space-y-6">
        <BbPageHeader Title="Master Struktur Organisasi (Region & Area)" Subtitle="Manajemen wilayah Sales Operation Region (SOR) dan Sales Area di dalam PGN." />

        <BbCard>
            <BbCardHeader>
                <div class="flex items-center justify-between">
                    <div>
                        <BbCardTitle>Region (SOR)</BbCardTitle>
                        <BbCardDescription>Wilayah SOR I-IV. Setiap peran berlingkup Region atau salah satu Area di dalamnya.</BbCardDescription>
                    </div>
                    <BbButton OnClick="OpenCreateRegion" Size="ButtonSize.Small">
                        <LucideIcon Name="plus" Class="size-4 mr-1" />
                        Tambah Region
                    </BbButton>
                </div>
            </BbCardHeader>
            <BbCardContent>
                <BbDataTable TData="Region" Data="_regions" InitialPageSize="25" AriaLabel="Daftar region">
                    <Columns>
                        <BbDataTableColumn TData="Region" TValue="string" Header="Kode" Property="@(r => r.Code)" Sortable="true" Width="120px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                        <BbDataTableColumn TData="Region" TValue="string" Header="Nama" Property="@(r => r.Name)" Sortable="true" Filterable="true" />
                        <BbDataTableColumn TData="Region" TValue="bool" Header="Status" Width="100px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                            <CellTemplate Context="region">
                                <BbBadge Variant="@(region.Active ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                    @(region.Active ? "Aktif" : "Nonaktif")
                                </BbBadge>
                            </CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="Region" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                            <CellTemplate Context="region">
                                <div class="flex items-center justify-center gap-1">
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                      OnClick="@(() => OpenEditRegion(region))">
                                                <LucideIcon Name="pencil" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                      OnClick="@(() => DeleteRegionAsync(region))">
                                                <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Hapus</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </CellTemplate>
                        </BbDataTableColumn>
                    </Columns>
                    <EmptyTemplate>
                        <BbEmpty Title="Belum ada region" Description="Tambahkan region pertama.">
                            <ChildContent>
                                <BbButton Class="mt-4" OnClick="OpenCreateRegion">Tambah Region</BbButton>
                            </ChildContent>
                        </BbEmpty>
                    </EmptyTemplate>
                </BbDataTable>
            </BbCardContent>
        </BbCard>

        <BbCard>
            <BbCardHeader>
                <div class="flex items-center justify-between">
                    <div>
                        <BbCardTitle>Area</BbCardTitle>
                        <BbCardDescription>Cakupan penugasan pengguna dan perusahaan di dalam satu Region.</BbCardDescription>
                    </div>
                    <BbButton OnClick="OpenCreateArea" Disabled="@(_regions.Count == 0)">
                        <LucideIcon Name="plus" Class="h-4 w-4 mr-2" />
                        Tambah
                    </BbButton>
                </div>
            </BbCardHeader>
            <BbCardContent>
                <BbDataTable TData="Area" Data="_areas" InitialPageSize="25" AriaLabel="Daftar area">
                    <Columns>
                        <BbDataTableColumn TData="Area" TValue="string" Header="Kode" Property="@(a => a.Code)" Sortable="true" Width="120px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap" />
                        <BbDataTableColumn TData="Area" TValue="string" Header="Nama" Property="@(a => a.Name)" Sortable="true" Filterable="true" />
                        <BbDataTableColumn TData="Area" TValue="string" Header="Region" Width="140px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                            <CellTemplate Context="area">
                                @(_regionsById.GetValueOrDefault(area.RegionId)?.Name ?? "-")
                            </CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="Area" TValue="bool" Header="Status" Width="100px" HeaderClass="whitespace-nowrap" CellClass="whitespace-nowrap">
                            <CellTemplate Context="area">
                                <BbBadge Variant="@(area.Active ? BadgeVariant.Default : BadgeVariant.Secondary)">
                                    @(area.Active ? "Aktif" : "Nonaktif")
                                </BbBadge>
                            </CellTemplate>
                        </BbDataTableColumn>
                        <BbDataTableColumn TData="Area" TValue="string" Header="Aksi" Width="1px" HeaderClass="w-px whitespace-nowrap text-center" CellClass="w-px whitespace-nowrap text-center">
                            <CellTemplate Context="area">
                                <div class="flex items-center justify-center gap-1">
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Ubah"
                                                      OnClick="@(() => OpenEditArea(area))">
                                                <LucideIcon Name="pencil" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Ubah</BbTooltipContent>
                                    </BbTooltip>
                                    <BbTooltip>
                                        <BbTooltipTrigger>
                                            <BbButton Variant="ButtonVariant.Outline" Size="ButtonSize.IconSmall" AriaLabel="Hapus" Class="text-destructive hover:bg-destructive/10 hover:text-destructive border-destructive/30"
                                                      OnClick="@(() => DeleteAreaAsync(area))">
                                                <LucideIcon Name="trash-2" Class="h-4 w-4" />
                                            </BbButton>
                                        </BbTooltipTrigger>
                                        <BbTooltipContent>Hapus</BbTooltipContent>
                                    </BbTooltip>
                                </div>
                            </CellTemplate>
                        </BbDataTableColumn>
                    </Columns>
                    <EmptyTemplate>
                        <BbEmpty Title="Belum ada area" Description="Tambahkan area pertama.">
                            <ChildContent>
                                <BbButton Class="mt-4" OnClick="OpenCreateArea" Disabled="@(_regions.Count == 0)">Tambah Area</BbButton>
                            </ChildContent>
                        </BbEmpty>
                    </EmptyTemplate>
                </BbDataTable>
            </BbCardContent>
        </BbCard>
    </div>
}

<BbDialog @bind-Open="_regionDialogOpen">
    <BbDialogContent>
        <EditForm Model="_regionForm" OnValidSubmit="SaveRegionAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingRegionId is null ? "Tambah Region" : "Ubah Region")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <BbFormFieldInput TValue="string" @bind-Value="_regionForm.Code" Label="Kode *" HelperText="Mis. 'SOR-II'." />
                    <BbFormFieldInput TValue="string" @bind-Value="_regionForm.Name" Label="Nama *" />
                </div>
                <BbFormFieldCheckbox @bind-Checked="_regionForm.Active" Label="Aktif" />
                @if (_regionError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_regionError</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _regionDialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

<BbDialog @bind-Open="_areaDialogOpen">
    <BbDialogContent>
        <EditForm Model="_areaForm" OnValidSubmit="SaveAreaAsync" OnInvalidSubmit="HandleInvalidSubmit">
            <DataAnnotationsValidator />
            <BbDialogHeader>
                <BbDialogTitle>@(_editingAreaId is null ? "Tambah Area" : "Ubah Area")</BbDialogTitle>
            </BbDialogHeader>
            <div class="space-y-4 py-4">
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <BbFormFieldInput TValue="string" @bind-Value="_areaForm.Code" Label="Kode *" HelperText="Mis. 'SBY'." />
                    <BbFormFieldInput TValue="string" @bind-Value="_areaForm.Name" Label="Nama *" />
                </div>
                <BbFormFieldCombobox TValue="Guid"
                                     @bind-Value="_areaForm.RegionId"
                                     Label="Region *"
                                     Required="true"
                                     Placeholder="Pilih region"
                                     SearchPlaceholder="Cari region..."
                                     EmptyMessage="Tidak ditemukan"
                                     Options="_regionOptions"
                                     MatchTriggerWidth
                                     Class="w-full"
                                     InputClass="w-full text-xs" />
                @if (_areaRegionError is not null)
                {
                    <p class="text-xs text-destructive">@_areaRegionError</p>
                }
                <BbFormFieldCheckbox @bind-Checked="_areaForm.Active" Label="Aktif" />
                @if (_areaError is not null)
                {
                    <BbAlert Variant="AlertVariant.Danger">
                        <BbAlertDescription>@_areaError</BbAlertDescription>
                    </BbAlert>
                }
            </div>
            <BbDialogFooter>
                <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="@(() => _areaDialogOpen = false)">Batal</BbButton>
                <BbButton Type="ButtonType.Submit">Simpan</BbButton>
            </BbDialogFooter>
        </EditForm>
    </BbDialogContent>
</BbDialog>

@code {
    private sealed class RegionFormModel
    {
        [Required(ErrorMessage = "Kode wajib diisi")]
        [StringLength(20, ErrorMessage = "Kode maksimal 20 karakter")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";

        public bool Active { get; set; } = true;
    }

    private sealed class AreaFormModel
    {
        [Required(ErrorMessage = "Kode wajib diisi")]
        [StringLength(20, ErrorMessage = "Kode maksimal 20 karakter")]
        public string Code { get; set; } = "";

        [Required(ErrorMessage = "Nama wajib diisi")]
        [StringLength(100, ErrorMessage = "Nama maksimal 100 karakter")]
        public string Name { get; set; } = "";

        public Guid RegionId { get; set; }

        public bool Active { get; set; } = true;
    }

    private List<Region> _regions = [];
    private List<Area> _areas = [];
    private Dictionary<Guid, Region> _regionsById = [];
    private List<SelectOption<Guid>> _regionOptions = [];

    private bool _regionDialogOpen;
    private Guid? _editingRegionId;
    private string? _regionError;
    private RegionFormModel _regionForm = new();

    private bool _areaDialogOpen;
    private Guid? _editingAreaId;
    private Guid? _editingAreaOriginalRegionId;
    private string? _areaError;
    private string? _areaRegionError;
    private AreaFormModel _areaForm = new();

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Organisasi", null),
    ];

    protected override Task OnAuthorizedInitializedAsync() => LoadAsync();

    private async Task LoadAsync()
    {
        var regions = await Service.GetRegionsAsync();
        _regions = regions.OrderBy(r => r.Code).ToList();
        _regionsById = _regions.ToDictionary(r => r.Id);
        _regionOptions = _regions.Select(r => new SelectOption<Guid>(r.Id, $"{r.Code} : {r.Name}")).ToList();

        var areas = await Service.GetAreasAsync();
        _areas = areas.OrderBy(a => a.Name).ToList();
    }

    private void OpenCreateRegion()
    {
        _editingRegionId = null;
        _regionForm = new RegionFormModel();
        _regionError = null;
        _regionDialogOpen = true;
    }

    private void OpenEditRegion(Region region)
    {
        _editingRegionId = region.Id;
        _regionForm = new RegionFormModel { Code = region.Code, Name = region.Name, Active = region.Active };
        _regionError = null;
        _regionDialogOpen = true;
    }

    private async Task SaveRegionAsync()
    {
        _regionError = null;

        try
        {
            if (_editingRegionId is { } id)
            {
                await Service.UpdateRegionAsync(id, existing =>
                {
                    existing.Code = _regionForm.Code;
                    existing.Name = _regionForm.Name;
                    existing.Active = _regionForm.Active;
                });
            }
            else
            {
                await Service.AddRegionAsync(new Region
                {
                    Id = Guid.NewGuid(),
                    Code = _regionForm.Code,
                    Name = _regionForm.Name,
                    Active = _regionForm.Active,
                });
            }
        }
        catch (DuplicateNameException)
        {
            _regionError = "Kode region ini sudah digunakan.";
            ToastService.Error(_regionError, "Gagal");
            return;
        }

        var isEdit = _editingRegionId is not null;
        _regionDialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEdit ? "Region berhasil diperbarui." : "Region berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteRegionAsync(Region region)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus region \"{region.Name}\"?",
            "Region akan dihapus secara permanen. Jika region masih memiliki Area, proses penghapusan akan ditolak. Silakan nonaktifkan region jika tidak lagi digunakan.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        try
        {
            await Service.DeleteRegionAsync(region.Id);
        }
        catch (EntityInUseException)
        {
            await DialogService.AlertAsync(
                "Region masih dipakai",
                $"Region \"{region.Name}\" masih memiliki Area di dalamnya dan tidak dapat dihapus. Nonaktifkan region ini melalui tombol Ubah.");
            return;
        }

        await LoadAsync();
        ToastService.Success($"Region \"{region.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void OpenCreateArea()
    {
        _editingAreaId = null;
        _editingAreaOriginalRegionId = null;
        _areaForm = new AreaFormModel();
        _areaError = null;
        _areaRegionError = null;
        _areaDialogOpen = true;
    }

    private void OpenEditArea(Area area)
    {
        _editingAreaId = area.Id;
        _editingAreaOriginalRegionId = area.RegionId;
        _areaForm = new AreaFormModel { Code = area.Code, Name = area.Name, RegionId = area.RegionId, Active = area.Active };
        _areaError = null;
        _areaRegionError = null;
        _areaDialogOpen = true;
    }

    private async Task SaveAreaAsync()
    {
        _areaError = null;
        _areaRegionError = null;

        if (_areaForm.RegionId == Guid.Empty)
        {
            _areaRegionError = "Region wajib dipilih";
            ToastService.Error(_areaRegionError, "Validasi Gagal");
            return;
        }

        var regionId = _areaForm.RegionId;

        if (_editingAreaId is { } id)
        {
            if (regionId != _editingAreaOriginalRegionId)
            {
                var result = await DialogService.ConfirmAsync(
                    "Pindahkan Area ke Region lain?",
                    "Admin Regional pada Region asal akan kehilangan akses ke setiap perusahaan di Area ini, dan admin pada Region tujuan akan mendapatkannya.",
                    new ConfirmDialogOptions { Destructive = true, ConfirmText = "Pindahkan", CancelText = "Batal" });

                if (!result.Confirmed)
                {
                    return;
                }
            }

            try
            {
                await Service.UpdateAreaAsync(id, existing =>
                {
                    existing.Code = _areaForm.Code;
                    existing.Name = _areaForm.Name;
                    existing.RegionId = regionId;
                    existing.Active = _areaForm.Active;
                });
            }
            catch (DuplicateNameException)
            {
                _areaError = "Kode area ini sudah digunakan pada region tersebut.";
                ToastService.Error(_areaError, "Gagal");
                return;
            }
        }
        else
        {
            try
            {
                await Service.AddAreaAsync(new Area
                {
                    Id = Guid.NewGuid(),
                    Code = _areaForm.Code,
                    Name = _areaForm.Name,
                    RegionId = regionId,
                    Active = _areaForm.Active,
                });
            }
            catch (DuplicateNameException)
            {
                _areaError = "Kode area ini sudah digunakan pada region tersebut.";
                ToastService.Error(_areaError, "Gagal");
                return;
            }
        }

        var isEditArea = _editingAreaId is not null;
        _areaDialogOpen = false;
        await LoadAsync();
        ToastService.Success(isEditArea ? "Area berhasil diperbarui." : "Area berhasil ditambahkan.", "Berhasil");
    }

    private async Task DeleteAreaAsync(Area area)
    {
        var result = await DialogService.ConfirmAsync(
            $"Hapus area \"{area.Name}\"?",
            "Area akan dihapus secara permanen. Jika area masih memiliki perusahaan terdaftar, proses penghapusan akan ditolak. Silakan nonaktifkan area jika tidak lagi digunakan.",
            new ConfirmDialogOptions { Destructive = true, ConfirmText = "Hapus", CancelText = "Batal" });

        if (!result.Confirmed)
        {
            return;
        }

        try
        {
            await Service.DeleteAreaAsync(area.Id);
        }
        catch (EntityInUseException)
        {
            await DialogService.AlertAsync(
                "Area masih dipakai",
                $"Area \"{area.Name}\" masih memiliki perusahaan terdaftar dan tidak dapat dihapus. Nonaktifkan area ini melalui tombol Ubah.");
            return;
        }

        await LoadAsync();
        ToastService.Success($"Area \"{area.Name}\" berhasil dihapus.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
