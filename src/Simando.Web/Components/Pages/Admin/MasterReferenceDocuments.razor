@page "/master/reference-documents"
@inherits AdminPageBase
@using System.ComponentModel.DataAnnotations
@using Microsoft.EntityFrameworkCore
@using Simando.Domain.MasterData
@using Simando.Domain.Security
@using Simando.Infrastructure.Persistence
@inject IDbContextFactory<SimandoDbContext> DbFactory
@inject ToastService ToastService

<PageTitle>Dokumen Acuan Kerja - DMS Simando</PageTitle>

@if (Authorized)
{
    <div class="space-y-6">
        <BbPageHeader Title="Master Dokumen Acuan Kerja (Reference Documents)" Subtitle="Katalog kebijakan, regulasi, dan ketentuan teknis yang menjadi acuan proses permohonan NOL / RL.">
            <Actions>
                @if (CurrentUser.HasCapability(Capability.ManageMasterData))
                {
                    <BbButton OnClick="OpenCreate" Variant="ButtonVariant.Default" Size="ButtonSize.Small">
                        <LucideIcon Name="plus" Class="size-4 mr-1" /> Tambah Dokumen Acuan
                    </BbButton>
                }
            </Actions>
        </BbPageHeader>

        @if (_loading)
        {
            <p class="text-sm text-muted-foreground">Memuat dokumen acuan kerja…</p>
        }
        else
        {
            <BbCard>
                <BbCardHeader>
                    <BbCardTitle>Katalog Dokumen Acuan (@_documents.Count)</BbCardTitle>
                </BbCardHeader>
                <BbCardContent>
                    <BbDataTable TData="ReferenceDocument" Data="_documents" InitialPageSize="25" AriaLabel="Katalog dokumen acuan">
                        <Columns>
                            <BbDataTableColumn TData="ReferenceDocument" TValue="string" Header="Nama Dokumen Acuan" Property="@(d => d.Name)" Sortable="true" Width="40%" />
                            <BbDataTableColumn TData="ReferenceDocument" TValue="int" Header="Versi" Width="100px">
                                <CellTemplate Context="d">
                                    <span class="font-mono text-xs bg-muted px-2 py-0.5 rounded font-semibold">v@d.Version</span>
                                </CellTemplate>
                            </BbDataTableColumn>
                            <BbDataTableColumn TData="ReferenceDocument" TValue="DateOnly" Header="Berlaku Sejak" Property="@(d => d.EffectiveFrom)" Sortable="true" Width="140px" />
                            <BbDataTableColumn TData="ReferenceDocument" TValue="string" Header="Status Berlaku" Width="140px">
                                <CellTemplate Context="d">
                                    @if (d.EffectiveTo is null)
                                    {
                                        <span class="px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 text-xs font-semibold">Berlaku (In Force)</span>
                                    }
                                    else
                                    {
                                        <span class="px-2 py-0.5 rounded bg-muted text-muted-foreground text-xs font-medium">Berakhir (@d.EffectiveTo.Value.ToString("dd MMM yyyy"))</span>
                                    }
                                </CellTemplate>
                            </BbDataTableColumn>
                        </Columns>
                        <EmptyTemplate>
                            <BbEmpty Title="Belum ada dokumen acuan" Description="Belum ada dokumen kebijakan atau acuan kerja yang dikonfigurasi." />
                        </EmptyTemplate>
                    </BbDataTable>
                </BbCardContent>
            </BbCard>
        }
    </div>

    <BbDialog @bind-Open="_showModal">
        <BbDialogContent>
            <EditForm Model="_form" OnValidSubmit="SaveDocument" OnInvalidSubmit="HandleInvalidSubmit">
                <DataAnnotationsValidator />
                <BbDialogHeader>
                    <BbDialogTitle>Tambah Dokumen Acuan Kerja Baru</BbDialogTitle>
                </BbDialogHeader>
                <div class="space-y-4 py-4">
                    <BbFormFieldInput TValue="string" @bind-Value="_form.Name" Label="Nama Dokumen *" Placeholder="Contoh: Ketentuan Harga Gas Sub-Holding 2026" />
                    <BbFormFieldNumericInput TValue="int" @bind-Value="_form.Version" Label="Versi *" Min="1" />
                    <BbFormFieldDatePicker @bind-Value="_form.EffectiveFrom" Label="Tanggal Berlaku Sejak *" />

                    @if (_error is not null)
                    {
                        <BbAlert Variant="AlertVariant.Danger">
                            <BbAlertDescription>@_error</BbAlertDescription>
                        </BbAlert>
                    }
                </div>
                <BbDialogFooter>
                    <BbButton Variant="ButtonVariant.Outline" Type="ButtonType.Button" OnClick="CloseModal">Batal</BbButton>
                    <BbButton Type="ButtonType.Submit">Simpan Dokumen</BbButton>
                </BbDialogFooter>
            </EditForm>
        </BbDialogContent>
    </BbDialog>
}

@code {
    private sealed class ReferenceDocumentFormModel
    {
        [Required(ErrorMessage = "Nama dokumen acuan wajib diisi")]
        [StringLength(200, ErrorMessage = "Nama dokumen maksimal 200 karakter")]
        public string Name { get; set; } = "";

        [Range(1, 100, ErrorMessage = "Versi minimal 1")]
        public int Version { get; set; } = 1;

        [Required(ErrorMessage = "Tanggal berlaku sejak wajib diisi")]
        public DateTime? EffectiveFrom { get; set; } = DateTime.Today;
    }

    private List<ReferenceDocument> _documents = [];
    private bool _loading = true;

    private bool _showModal;
    private ReferenceDocumentFormModel _form = new();
    private string? _error;

    protected override Capability[] RequiredCapabilities => [Capability.ManageMasterData];

    protected override BreadcrumbItem[] Breadcrumbs =>
    [
        new("Beranda", "/"),
        new("Master Data", "/master/organisation"),
        new("Dokumen Acuan Kerja", null),
    ];

    protected override async Task OnAuthorizedInitializedAsync()
    {
        await LoadDocumentsAsync();
    }

    private async Task LoadDocumentsAsync()
    {
        _loading = true;
        await using var db = await DbFactory.CreateDbContextAsync();
        _documents = await db.ReferenceDocuments.AsNoTracking()
            .OrderByDescending(d => d.EffectiveFrom)
            .ThenByDescending(d => d.Version)
            .ToListAsync();
        _loading = false;
    }

    private void OpenCreate()
    {
        _form = new ReferenceDocumentFormModel();
        _error = null;
        _showModal = true;
    }

    private void CloseModal()
    {
        _showModal = false;
        _error = null;
    }

    private async Task SaveDocument()
    {
        await using var db = await DbFactory.CreateDbContextAsync();

        var entity = new ReferenceDocument
        {
            Id = Guid.NewGuid(),
            Name = _form.Name.Trim(),
            Version = _form.Version,
            EffectiveFrom = DateOnly.FromDateTime(_form.EffectiveFrom ?? DateTime.Today),
            EffectiveTo = null,
            BlobKey = null
        };

        db.ReferenceDocuments.Add(entity);
        await db.SaveChangesAsync();

        CloseModal();
        await LoadDocumentsAsync();
        ToastService.Success($"Dokumen acuan \"{entity.Name}\" berhasil ditambahkan.", "Berhasil");
    }

    private void HandleInvalidSubmit() => ToastService.Error("Mohon lengkapi semua kolom yang wajib diisi.", "Validasi Gagal");
}
