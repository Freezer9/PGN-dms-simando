@page "/change-password"
@layout AuthLayout
@using Simando.Web.Security
@attribute [Authorize]
@attribute [AllowDuringPasswordChange]
@rendermode InteractiveServer

<PageTitle>Ubah Kata Sandi - DMS Simando</PageTitle>

<div class="min-h-screen flex items-center justify-center p-4">
    <BbCard Class="w-full max-w-sm">
        <BbCardHeader>
            <BbCardTitle>Ubah Kata Sandi</BbCardTitle>
            <BbCardDescription>
                Kata sandi baru wajib diisi sebelum melanjutkan.
            </BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            @if (HasError)
            {
                <BbAlert Variant="AlertVariant.Danger" Class="mb-4">
                    <BbAlertDescription>
                        Kata sandi saat ini salah, atau kata sandi baru tidak memenuhi persyaratan.
                    </BbAlertDescription>
                </BbAlert>
            }

            @* Plain HTML form posting to /account/change-password per docs/build/web-conventions.md. *@
            <form method="post" action="/account/change-password" class="space-y-4">
                <AntiforgeryToken />

                <BbFormFieldInput TValue="string"
                                  Name="currentPassword"
                                  Type="InputType.Password"
                                  @bind-Value="CurrentPassword"
                                  Label="Kata Sandi Saat Ini *"
                                  Required="true" />

                <BbFormFieldInput TValue="string"
                                  Name="newPassword"
                                  Type="InputType.Password"
                                  @bind-Value="NewPassword"
                                  Label="Kata Sandi Baru *"
                                  Required="true" />

                <BbButton Type="ButtonType.Submit" Class="w-full">Simpan</BbButton>
            </form>
        </BbCardContent>
    </BbCard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorFlag { get; set; }

    private bool HasError => ErrorFlag is not null;

    private string CurrentPassword { get; set; } = string.Empty;
    private string NewPassword { get; set; } = string.Empty;
}
