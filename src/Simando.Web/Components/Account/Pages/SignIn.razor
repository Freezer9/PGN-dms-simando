@page "/sign-in"
@layout AuthLayout
@attribute [AllowAnonymous]
@rendermode InteractiveServer

<PageTitle>Masuk - DMS Simando</PageTitle>

<div class="min-h-screen flex items-center justify-center p-4">
    <BbCard Class="w-full max-w-sm">
        <BbCardHeader>
            <BbCardTitle>Simando</BbCardTitle>
            <BbCardDescription>Masuk menggunakan akun DMS Simando Anda</BbCardDescription>
        </BbCardHeader>
        <BbCardContent>
            @if (HasError)
            {
                <BbAlert Variant="AlertVariant.Danger" Class="mb-4">
                    <BbAlertDescription>Email atau kata sandi salah.</BbAlertDescription>
                </BbAlert>
            }

            @* Plain HTML form posting to /account/sign-in per docs/build/web-conventions.md. *@
            <form method="post" action="/account/sign-in" class="space-y-4">
                <AntiforgeryToken />

                <BbFormFieldInput TValue="string"
                                  Name="email"
                                  Type="InputType.Email"
                                  Placeholder="nama@pgn.co.id"
                                  @bind-Value="Email"
                                  Label="Email *"
                                  Required="true" />

                <BbFormFieldInput TValue="string"
                                  Name="password"
                                  Type="InputType.Password"
                                  @bind-Value="Password"
                                  Label="Kata Sandi *"
                                  Required="true" />

                <BbButton Type="ButtonType.Submit" Class="w-full">Masuk</BbButton>
            </form>
        </BbCardContent>
        <BbCardFooter>
            <p class="text-xs text-muted-foreground text-center w-full">
                Lupa kata sandi? Hubungi administrator Anda untuk pengaturan ulang.
            </p>
        </BbCardFooter>
    </BbCard>
</div>

@code {
    [SupplyParameterFromQuery(Name = "error")]
    private string? ErrorFlag { get; set; }

    private bool HasError => ErrorFlag is not null;

    private string Email { get; set; } = string.Empty;
    private string Password { get; set; } = string.Empty;
}
