@namespace Simando.Web.Components.Shared

<div class="@($"flex items-center justify-between mb-3 {Class}")">
    <div>
        <div class="flex items-center gap-2">
            @if (!string.IsNullOrEmpty(Icon))
            {
                <LucideIcon Name="@Icon" Class="size-4 text-muted-foreground" />
            }
            <h3 class="@(Uppercase ? "text-xs font-semibold text-muted-foreground uppercase tracking-wider" : "text-sm font-semibold text-foreground")">
                @Title
            </h3>
            @if (!string.IsNullOrEmpty(Badge))
            {
                <span class="text-[11px] px-1.5 py-0.5 rounded-full bg-muted text-muted-foreground font-medium">@Badge</span>
            }
        </div>
        @if (!string.IsNullOrEmpty(Subtitle))
        {
            <p class="text-xs text-muted-foreground mt-0.5">@Subtitle</p>
        }
    </div>
    @if (Actions is not null)
    {
        <div class="flex items-center gap-2">
            @Actions
        </div>
    }
</div>

@code {
    [Parameter, EditorRequired] public string Title { get; set; } = string.Empty;
    [Parameter] public string? Subtitle { get; set; }
    [Parameter] public string? Icon { get; set; }
    [Parameter] public string? Badge { get; set; }
    [Parameter] public bool Uppercase { get; set; }
    [Parameter] public RenderFragment? Actions { get; set; }
    [Parameter] public string Class { get; set; } = string.Empty;
}
