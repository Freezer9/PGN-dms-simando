@* Single draggable-pin picker backing /directory/new's TITIK KOORDINAT
   section — click to place, drag to move. Not the multi-pin, layered map
   /map (a00f) will need; that's a separate, larger component. *@
@implements IAsyncDisposable
@inject IJSRuntime JS

<div id="@_elementId" style="height: 320px; border-radius: var(--radius); overflow: hidden;"></div>

@code {
    private readonly string _elementId = $"pin-map-{Guid.NewGuid():N}";
    private IJSObjectReference? _module;
    private DotNetObjectReference<PinDropMap>? _dotNetRef;

    [Parameter] public double? Latitude { get; set; }
    [Parameter] public EventCallback<double?> LatitudeChanged { get; set; }
    [Parameter] public double? Longitude { get; set; }
    [Parameter] public EventCallback<double?> LongitudeChanged { get; set; }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
        {
            return;
        }

        _module = await JS.InvokeAsync<IJSObjectReference>("import", "./js/pin-map.js");
        _dotNetRef = DotNetObjectReference.Create(this);
        await _module.InvokeVoidAsync("initMap", _elementId, _dotNetRef, Latitude, Longitude);
    }

    [JSInvokable]
    public async Task OnPinMoved(double lat, double lng)
    {
        Latitude = lat;
        Longitude = lng;
        await LatitudeChanged.InvokeAsync(lat);
        await LongitudeChanged.InvokeAsync(lng);
    }

    public async ValueTask DisposeAsync()
    {
        if (_module is not null)
        {
            await _module.InvokeVoidAsync("dispose", _elementId);
            await _module.DisposeAsync();
        }

        _dotNetRef?.Dispose();
    }
}
