@inherits LayoutComponentBase
@implements IDisposable
@using Simando.Application.Navigation
@using Simando.Application.Notifications
@using Simando.Application.Tasks
@using Simando.Application.Workflow
@using Simando.Infrastructure.Persistence
@using Simando.Web.Security
@inject CurrentUser CurrentUser
@inject BreadcrumbState BreadcrumbState
@inject SimandoDbContext Db
@inject INotificationService NotificationService
@inject ITasksService TasksService
@inject IWorkflowEventNotifier EventNotifier
@inject NavigationManager NavigationManager

@* Authenticated app shell per docs/design/frontend/01-shell-and-navigation.md. *@
<BbSidebarProvider>
    <BbSidebar Class="sticky top-0 h-screen shrink-0">
        <BbSidebarHeader>
            <BbSidebarHeaderContent>
                <div class="flex h-7 w-7 items-center justify-center rounded-md bg-primary text-primary-foreground">
                    <LucideIcon Name="flame" Class="h-4 w-4" />
                </div>
                <BbSidebarHeaderInfo>
                    <span class="text-sm font-semibold truncate">Simando</span>
                    <span class="text-xs text-muted-foreground truncate">DMS PGN</span>
                </BbSidebarHeaderInfo>
            </BbSidebarHeaderContent>
        </BbSidebarHeader>
        <BbSidebarContent>
            @for (var sectionIndex = 0; sectionIndex < _menu.Sections.Count; sectionIndex++)
            {
                var section = _menu.Sections[sectionIndex];
                <BbSidebarGroup>
                    <BbSidebarGroupContent>
                        <BbSidebarMenu>
                            @foreach (var node in section.Nodes)
                            {
                                @switch (node)
                                {
                                    case NavItem link:
                                        <BbSidebarMenuItem>
                                            <BbSidebarMenuButton Href="@link.Route" Match="@(link.Route == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)" Tooltip="@link.Label">
                                                <LucideIcon Name="@link.Icon" Class="h-4 w-4" />
                                                <span>@link.Label</span>
                                                @if (!string.IsNullOrEmpty(link.Badge))
                                                {
                                                    <span class="ml-auto flex h-5 min-w-5 items-center justify-center rounded-full bg-primary/15 text-primary text-[11px] font-semibold px-1.5">
                                                        @link.Badge
                                                    </span>
                                                }
                                            </BbSidebarMenuButton>
                                        </BbSidebarMenuItem>
                                        break;
                                    case NavGroup group:
                                        <BbSidebarMenuItem>
                                            <BbCollapsible>
                                                <BbSidebarMenuButton Tooltip="@group.Label">
                                                    <LucideIcon Name="@group.Icon" Class="h-4 w-4" />
                                                    <span>@group.Label</span>
                                                    <BbSidebarMenuChevron>
                                                        <LucideIcon Name="chevron-right" Class="h-4 w-4" />
                                                    </BbSidebarMenuChevron>
                                                </BbSidebarMenuButton>
                                                <BbCollapsibleContent>
                                                    <BbSidebarMenuSub>
                                                        @foreach (var child in group.Children)
                                                        {
                                                            <BbSidebarMenuSubItem>
                                                                <BbSidebarMenuSubButton Href="@child.Route" Match="@(child.Route == "/" ? NavLinkMatch.All : NavLinkMatch.Prefix)">
                                                                    <span>@child.Label</span>
                                                                </BbSidebarMenuSubButton>
                                                            </BbSidebarMenuSubItem>
                                                        }
                                                    </BbSidebarMenuSub>
                                                </BbCollapsibleContent>
                                            </BbCollapsible>
                                        </BbSidebarMenuItem>
                                        break;
                                }
                            }
                        </BbSidebarMenu>
                    </BbSidebarGroupContent>
                </BbSidebarGroup>
                @if (sectionIndex < _menu.Sections.Count - 1)
                {
                    <BbSidebarSeparator />
                }
            }
        </BbSidebarContent>
        <BbSidebarRail />
    </BbSidebar>
    <BbSidebarInset Class="min-h-screen flex flex-col">
        <header class="sticky top-0 z-20 flex h-14 items-center gap-2 border-b bg-background/95 backdrop-blur px-4 shrink-0">
            <BbSidebarTrigger />
            <BbBreadcrumb>
                <BbBreadcrumbList>
                    @for (var i = 0; i < BreadcrumbState.Items.Count; i++)
                    {
                        var item = BreadcrumbState.Items[i];
                        var isLast = i == BreadcrumbState.Items.Count - 1;

                        @if (i > 0)
                        {
                            <BbBreadcrumbSeparator />
                        }

                        <BbBreadcrumbItem>
                            @if (isLast || item.Route is null)
                            {
                                <BbBreadcrumbPage>@item.Label</BbBreadcrumbPage>
                            }
                            else
                            {
                                <BbBreadcrumbLink Href="@item.Route">@item.Label</BbBreadcrumbLink>
                            }
                        </BbBreadcrumbItem>
                    }
                </BbBreadcrumbList>
            </BbBreadcrumb>
            <div class="flex-1"></div>

            <!-- In-App Notification Bell Panel -->
            <BbPopover>
                <BbPopoverTrigger>
                    <BbButton Variant="ButtonVariant.Ghost" Class="relative p-2 h-9 w-9 rounded-full">
                        <LucideIcon Name="bell" Class="h-4 w-4 text-muted-foreground" />
                        @if (_unreadNotificationCount > 0)
                        {
                            <span class="absolute top-1 right-1 flex h-4 min-w-4 items-center justify-center rounded-full bg-destructive text-destructive-foreground text-[10px] font-bold px-1">
                                @(_unreadNotificationCount > 99 ? "99+" : _unreadNotificationCount)
                            </span>
                        }
                    </BbButton>
                </BbPopoverTrigger>
                <BbPopoverContent Align="PopoverAlign.End" Class="w-80 p-0 shadow-lg">
                    <div class="flex items-center justify-between p-3 border-b bg-muted/30">
                        <div class="flex items-center gap-2">
                            <span class="font-semibold text-sm">Notifikasi</span>
                            @if (_unreadNotificationCount > 0)
                            {
                                <span class="text-xs px-2 py-0.5 rounded bg-primary/10 text-primary font-medium">@_unreadNotificationCount Baru</span>
                            }
                        </div>
                        @if (_unreadNotificationCount > 0)
                        {
                            <button type="button" @onclick="MarkAllReadAsync" class="text-xs font-semibold text-primary hover:underline">Tandai Dibaca</button>
                        }
                    </div>
                    <div class="max-h-80 overflow-y-auto divide-y">
                        @if (_notifications.Count == 0)
                        {
                            <div class="p-6 text-center text-xs text-muted-foreground">Belum ada notifikasi.</div>
                        }
                        else
                        {
                            @foreach (var item in _notifications)
                            {
                                <a href="/companies/@item.CompanyId" @onclick="@(() => OnNotificationClick(item))" class="@($"block p-3 text-xs hover:bg-muted/40 transition-colors {(item.ReadAt == null ? "bg-primary/5 font-medium" : "text-muted-foreground")}")">
                                    <div class="font-semibold text-foreground mb-0.5">@item.CompanyName (@item.CompanyNomor)</div>
                                    <p class="line-clamp-2 text-muted-foreground">@item.Message</p>
                                    <span class="text-[10px] text-muted-foreground/70 mt-1 block">@item.CreatedAt.ToString("dd MMM HH:mm")</span>
                                </a>
                            }
                        }
                    </div>
                </BbPopoverContent>
            </BbPopover>

            <BbDropdownMenu>
                <BbDropdownMenuTrigger>
                    <BbButton Variant="ButtonVariant.Ghost"
                              Class="flex items-center gap-2 px-2.5 py-1.5 h-auto hover:bg-accent/50" Title="@RoleScopeText">
                        <BbAvatar Size="AvatarSize.Small">
                            <BbAvatarFallback>@CurrentUser.Initials</BbAvatarFallback>
                        </BbAvatar>
                        <span class="text-sm font-medium">@CurrentUser.FullName</span>
                        <span class="sr-only">@RoleScopeText</span>
                        <LucideIcon Name="chevron-down" Class="h-4 w-4 text-muted-foreground" />
                    </BbButton>
                </BbDropdownMenuTrigger>
                <BbDropdownMenuContent Align="PopoverAlign.End" Class="min-w-55 w-max max-w-xs p-2">
                    <div class="px-2 py-1.5 space-y-1.5">
                        <p class="text-sm font-medium text-foreground truncate">@CurrentUser.Email</p>
                        <div class="flex flex-row items-center gap-1.5">
                            @foreach (var assignment in CurrentUser.RoleAssignments)
                            {
                                <BbBadge Variant="BadgeVariant.Secondary"
                                         Class="text-xs font-normal whitespace-nowrap shrink-0">
                                    @assignment.RoleLabel
                                </BbBadge>
                                <BbBadge Variant="BadgeVariant.Outline"
                                         Class="text-xs font-normal whitespace-nowrap shrink-0">
                                    @assignment.ScopeLabel
                                </BbBadge>
                            }
                        </div>
                    </div>
                    <BbDropdownMenuSeparator Class="my-1.5" />
                    <BbDropdownMenuItem Href="/change-password">
                        <LucideIcon Name="key-round" Class="mr-2 h-4 w-4 text-muted-foreground" />
                        <span>Ubah Kata Sandi</span>
                    </BbDropdownMenuItem>
                    <BbDropdownMenuItem Href="/account/sign-out" Class="text-destructive focus:text-destructive">
                        <LucideIcon Name="log-out" Class="mr-2 h-4 w-4 text-destructive" />
                        <span>Keluar</span>
                    </BbDropdownMenuItem>
                </BbDropdownMenuContent>
            </BbDropdownMenu>
        </header>
        <main class="flex-1 flex flex-col p-4 md:p-8">
            @Body
        </main>
    </BbSidebarInset>
</BbSidebarProvider>

@* BbPortalHost required for overlay components (BbDialog, BbPopover, etc.). *@
<BbPortalHost />
<BbToastProvider />
<BbDialogProvider />

<div id="blazor-error-ui" data-nosnippet>
    An unhandled error has occurred.
    <a href="." class="reload">Reload</a>
    <span class="dismiss">🗙</span>
</div>

@code {
    private NavMenu _menu = new([]);
    private int _unreadNotificationCount;
    private IReadOnlyList<NotificationListItem> _notifications = [];

    protected override async Task OnInitializedAsync()
    {
        await CurrentUser.LoadAsync(Db);
        await RefreshShellDataAsync();
        BreadcrumbState.Changed += OnBreadcrumbChanged;
        EventNotifier.WorkflowStateChanged += OnWorkflowStateChanged;
    }

    private async Task RefreshShellDataAsync()
    {
        var pendingTasks = await TasksService.GetMyTasksAsync(
            CurrentUser.UserId, CurrentUser.Permissions, CurrentUser.Roles);

        _menu = NavigationMenuBuilder.Build(CurrentUser.Permissions, CurrentUser.Roles, pendingTasks.Count);

        _unreadNotificationCount = await NotificationService.GetUnreadCountAsync(CurrentUser.UserId);
        _notifications = await NotificationService.GetNotificationsAsync(CurrentUser.UserId);
    }

    private void OnWorkflowStateChanged(Guid? userId)
    {
        if (userId == null || userId == CurrentUser.UserId)
        {
            _ = InvokeAsync(async () =>
            {
                await RefreshShellDataAsync();
                StateHasChanged();
            });
        }
    }

    private async Task OnNotificationClick(NotificationListItem item)
    {
        if (item.ReadAt == null)
        {
            await NotificationService.MarkAsReadAsync(item.Id, CurrentUser.UserId);
            await RefreshShellDataAsync();
        }
    }

    private async Task MarkAllReadAsync()
    {
        await NotificationService.MarkAllAsReadAsync(CurrentUser.UserId);
        await RefreshShellDataAsync();
    }

    private void OnBreadcrumbChanged() => InvokeAsync(StateHasChanged);

    private string RoleScopeText => string.Join(", ", CurrentUser.RoleAssignments
        .Select(assignment => $"{assignment.RoleLabel} · {assignment.ScopeLabel}"));

    public void Dispose()
    {
        BreadcrumbState.Changed -= OnBreadcrumbChanged;
        EventNotifier.WorkflowStateChanged -= OnWorkflowStateChanged;
    }
}
