{
	"$schema": "https://biomejs.dev/schemas/2.4.5/schema.json",
	"vcs": {
		"enabled": false,
		"clientKind": "git",
		"useIgnoreFile": false
	},
	"files": {
		"ignoreUnknown": false,
		"includes": [
			"**/src/**/*",
			"**/.vscode/**/*",
			"index.html",
			"**/vite.config.ts",
			"!**/src/routeTree.gen.ts",
			"!**/src/api/schema.d.ts",
			"!**/*.css",
			"!**/playwright-report/**/*",
			"!**/test-results/**/*"
		]
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab"
	},
	"assist": {
		"actions": {
			"source": {
				"organizeImports": "on"
			}
		}
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"suspicious": {
				"noShadowRestrictedNames": "off"
			}
		}
	},
	"overrides": [
		{
			"includes": ["**/src/components/ui/**/*"],
			"linter": {
				"rules": {
					"suspicious": {
						"noDocumentCookie": "off"
					},
					"a11y": {
						"useFocusableInteractive": "off",
						"useSemanticElements": "off",
						"noSvgWithoutTitle": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "off"
					}
				}
			}
		}
	],
	"javascript": {
		"formatter": {
			"quoteStyle": "double"
		}
	}
}
