# Domain Caddy will request a Let's Encrypt certificate for.
# Must already have a DNS A/AAAA record pointing at this server.
DOMAIN=example.com

# Signing key for API-issued JWTs. Generate a real one before deploying, e.g.:
#   openssl rand -base64 48
# Must NOT be left as the Pgn.Dms.Api dev fallback default.
JWT_KEY=change-me-to-a-random-48-plus-character-secret

JWT_ISSUER=simando
JWT_AUDIENCE=simando
